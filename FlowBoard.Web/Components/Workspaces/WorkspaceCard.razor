@using FlowBoard.Shared.DTOs.Workspaces
@using Microsoft.AspNetCore.Components.Web

<article class="entity-card entity-card-interactive h-100 p-3 p-lg-4"
         role="link"
         tabindex="0"
         @onclick="HandleOpen"
         @onkeydown="HandleKeyDown">
    <div class="d-flex align-items-start justify-content-between gap-3">
        <div class="d-flex align-items-start gap-3">
            <span class="entity-icon"><i class="bi bi-grid-1x2" aria-hidden="true"></i></span>
            <div class="min-w-0">
                <h2 class="h5 fw-semibold mb-2">@Workspace.Name</h2>

                @if (!string.IsNullOrWhiteSpace(Workspace.Description))
                {
                    <p class="entity-card-description mb-0">@Workspace.Description</p>
                }
                else
                {
                    <p class="entity-card-description mb-0">No description provided.</p>
                }
                <div class="mt-3">
                    <WorkspaceOwner OwnerName="@Workspace.OwnerName"
                                    OwnerEmail="@Workspace.OwnerEmail"
                                    SizeRem="1.75" />
                </div>
            </div>
        </div>
        <i class="bi bi-arrow-up-right text-muted" aria-hidden="true"></i>
    </div>
</article>

@code {

    [Parameter, EditorRequired]
    public WorkspaceResponse Workspace { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback<WorkspaceResponse> OnOpen { get; set; }



    private async Task HandleOpen()
    {
        await OnOpen.InvokeAsync(Workspace);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            await HandleOpen();
        }
    }
}
@using System.Security.Claims
@using FlowBoard.Web.Navigation

@inject IAuthenticationService AuthenticationService
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation

<div class="nav-menu @(IsCollapsed ? "nav-menu-collapsed" : null)">
    <div class="sidebar-brand">
        <a class="brand-link" href="/" aria-label="FlowBoard home">
            <span class="brand-mark"><i class="bi bi-kanban-fill" aria-hidden="true"></i></span>
            <span class="brand-name">FlowBoard</span>
        </a>
        <button class="sidebar-collapse-button"
                type="button"
                aria-label="@(IsCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                title="@(IsCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                @onclick="OnToggleCollapse">
            <i class="bi @(IsCollapsed ? "bi-chevron-right" : "bi-chevron-left")" aria-hidden="true"></i>
        </button>
    </div>

    <nav class="nav-scrollable" aria-label="Main navigation">
        @foreach (var itemGroup in navigationSections)
        {
            <div class="nav-section-label">@itemGroup.Label</div>
            @foreach (var item in itemGroup.Items)
            {
                <div class="nav-item">
                    @if (item.Href is not null)
                    {
                        <NavLink class="nav-link"
                                 href="@item.Href"
                                 Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                 title="@(IsCollapsed ? item.Label : null)"
                                 @onclick="OnMobileClose">
                            <i class="bi @item.Icon" aria-hidden="true"></i>
                            <span>@item.Label</span>
                        </NavLink>
                    }
                    else
                    {
                        <span class="nav-link nav-link-disabled"
                              aria-disabled="true"
                              title="@(IsCollapsed ? $"{item.Label} - Available in a later phase" : null)">
                            <i class="bi @item.Icon" aria-hidden="true"></i>
                            <span>@item.Label</span>
                            <span class="nav-coming-soon">Soon</span>
                        </span>
                    }
                </div>
            }
        }

        <div class="nav-section-label nav-account-label">Account</div>
        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/profile"
                     title="@(IsCollapsed ? "Profile" : null)"
                     @onclick="OnMobileClose">
                <i class="bi bi-person-circle" aria-hidden="true"></i>
                <span>Profile</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <button class="nav-link nav-logout"
                    type="button"
                    title="@(IsCollapsed ? "Log out" : null)"
                    @onclick="LogoutAsync">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                <span>Log out</span>
            </button>
        </div>
    </nav>
</div>

@code {
    [Parameter, EditorRequired]
    public ClaimsPrincipal User { get; set; } = null!;

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    [Parameter]
    public EventCallback OnMobileClose { get; set; }

    private IReadOnlyList<AppNavigationSection> navigationSections = [];

    protected override async Task OnParametersSetAsync()
    {
        var authorizedPolicies = await AppNavigation.GetAuthorizedPoliciesAsync(
            User,
            AuthorizationService);
        navigationSections = AppNavigation.ForAuthorizedPolicies(authorizedPolicies);
    }

    private async Task LogoutAsync()
    {
        await AuthenticationService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}

@if (Columns.Count == 0)
{
    <div class="empty-state py-5">

        <div class="empty-state-icon mb-3">
            <i class="bi bi-columns-gap" aria-hidden="true"></i>
        </div>
        <h5>No columns yet</h5>

        <p class="text-muted mb-3">
            Create a column to start organizing this board.
        </p>

        @if (CanManageBoard)
        {
            <button class="btn btn-primary"
                    @onclick="OnCreate">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Create column
            </button>
        }
    </div>
}
else
{
    <div class="entity-grid">

        @foreach (var column in Columns)
        {
            <BoardColumnCard
                @key="column.Id"
                Column="column"
                CanManageBoard="CanManageBoard"
                CanDeleteContent="CanDeleteContent"
                OnEdit="OnEdit"
                OnDelete="OnDelete" />
        }

    </div>
}

@code {

    [Parameter, EditorRequired]
    public IReadOnlyList<BoardColumnResponse> Columns { get; set; }
        = [];

    [Parameter]
    public bool CanManageBoard { get; set; }

    [Parameter]
    public bool CanDeleteContent { get; set; }

    [Parameter]
    public EventCallback OnCreate { get; set; }

    [Parameter]
    public EventCallback<BoardColumnResponse> OnEdit { get; set; }

    [Parameter]
    public EventCallback<BoardColumnResponse> OnDelete { get; set; }

}
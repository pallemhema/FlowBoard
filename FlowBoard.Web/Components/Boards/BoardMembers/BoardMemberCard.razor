<article class="entity-card h-100 p-3 p-lg-4 position-relative">

    <div class="d-flex justify-content-between align-items-start gap-2">

            <div>
                <h5 class="card-title mb-1">
                    @($"{Member.FirstName} {Member.LastName}")
                </h5>

                <small class="text-muted">
                    @Member.Email
                </small>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary">@Member.Role</span>
                @if (CanManageBoard && !confirmingDelete)
                {
                    <button class="btn btn-sm btn-light border-0"
                            type="button"
                            aria-label="Member actions"
                            aria-expanded="@actionsOpen"
                            @onclick="ToggleActions">
                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                    </button>
                }
            </div>

        </div>

        <p class="small text-muted mt-3 mb-0">
            <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
            Joined @Member.JoinedAt.ToLocalTime().ToString("dd MMM yyyy")
        </p>

        @if (CanManageBoard && actionsOpen && !confirmingDelete)
        {
            <div class="entity-action-menu">
                <button type="button" class="dropdown-item" @onclick="EditRole">
                    <i class="bi bi-person-gear me-2" aria-hidden="true"></i>Edit role
                </button>
                <button type="button" class="dropdown-item text-danger" @onclick="StartDelete">
                    <i class="bi bi-person-dash me-2" aria-hidden="true"></i>Remove member
                </button>
            </div>
        }

        @if (CanManageBoard && confirmingDelete)
        {
            <div class="mt-3 pt-3 border-top" role="group" aria-label="Confirm member removal">
                <p class="small mb-2">Remove this member?</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">Remove</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                </div>
            </div>
        }
</article>

@code {

    [Parameter, EditorRequired]
    public BoardMemberResponse Member { get; set; } = null!;

    [Parameter]
    public bool CanManageBoard { get; set; }

    [Parameter]
    public EventCallback<BoardMemberResponse> OnEditRole { get; set; }

    [Parameter]
    public EventCallback<BoardMemberResponse> OnRemove { get; set; }

    private bool confirmingDelete;
    private bool actionsOpen;


    private async Task EditRole()
    {
        actionsOpen = false;
        await OnEditRole.InvokeAsync(Member);
    }

    private void ToggleActions()
    {
        actionsOpen = !actionsOpen;
    }

    private void StartDelete()
    {
        confirmingDelete = true;
        actionsOpen = false;
    }


    private void CancelDelete()
    {
        confirmingDelete = false;
    }


    private async Task ConfirmDelete()
    {
        confirmingDelete = false;

        await OnRemove.InvokeAsync(Member);
    }
}
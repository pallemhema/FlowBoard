@page "/manager/dashboard"

@attribute [Authorize(Policy = AuthorizationPolicies.ManagerOnly)]

@using System.Net.Http
@using System.Text.Json

@inject IManagerEmployeeApiService ManagerEmployeeApiService
@inject ITeamApiService TeamApiService
@inject IWorkspaceApiService WorkspaceApiService
@inject IProjectApiService ProjectApiService
@inject IBoardApiService BoardApiService
@inject ITaskApiService TaskApiService

<PageTitle>Manager Dashboard | FlowBoard</PageTitle>

<div class="page-shell manager-dashboard">

    <PageHeader Title="Dashboard"
                Eyebrow="Manager overview"
                Description="A focused view of your direct reports, team memberships, accessible work, and assigned tasks." />

    @if (employeesLoad.IsLoading ||
         teamsLoad.IsLoading ||
         workspacesLoad.IsLoading ||
         projectsLoad.IsLoading ||
         boardsLoad.IsLoading ||
         tasksLoad.IsLoading)
    {
        <div class="manager-dashboard-loading"
             role="status"
             aria-live="polite">

            <span class="spinner-border spinner-border-sm text-primary"
                  aria-hidden="true"></span>

            <span>Loading your management overview…</span>

        </div>
    }

    <section class="manager-stat-grid"
             aria-label="Manager overview statistics">

        <DashboardStatCard Label="Direct reports"
                           Icon="bi-people"
                           IconTone="stat-tone-indigo"
                           Value="@(employeesCount ?? 0)"
                           IsLoading="@employeesLoad.IsLoading"
                           IsUnavailable="@(employeesCount is null)"
                           UnavailableReason="@employeesLoad.Error" />

        <DashboardStatCard Label="Teams"
                           Icon="bi-diagram-3"
                           IconTone="stat-tone-green"
                           Value="@(teamsCount ?? 0)"
                           IsLoading="@teamsLoad.IsLoading"
                           IsUnavailable="@(teamsCount is null)"
                           UnavailableReason="@teamsLoad.Error" />

        <DashboardStatCard Label="Accessible workspaces"
                           Icon="bi-grid"
                           IconTone="stat-tone-amber"
                           Value="@(workspacesCount ?? 0)"
                           IsLoading="@workspacesLoad.IsLoading"
                           IsUnavailable="@(workspacesCount is null)"
                           UnavailableReason="@workspacesLoad.Error" />

        <DashboardStatCard Label="Accessible projects"
                           Icon="bi-kanban"
                           IconTone="stat-tone-violet"
                           Value="@(projectsCount ?? 0)"
                           IsLoading="@projectsLoad.IsLoading"
                           IsUnavailable="@(projectsCount is null)"
                           UnavailableReason="@projectsLoad.Error" />

        <DashboardStatCard Label="Accessible boards"
                           Icon="bi-columns-gap"
                           IconTone="stat-tone-blue"
                           Value="@(boardsCount ?? 0)"
                           IsLoading="@boardsLoad.IsLoading"
                           IsUnavailable="@(boardsCount is null)"
                           UnavailableReason="@boardsLoad.Error" />

        <DashboardStatCard Label="Tasks assigned to you"
                           Icon="bi-check2-square"
                           IconTone="stat-tone-indigo"
                           Value="@(assignedTasksCount ?? 0)"
                           IsLoading="@tasksLoad.IsLoading"
                           IsUnavailable="@(assignedTasksCount is null)"
                           UnavailableReason="@tasksLoad.Error" />

    </section>

    <div class="manager-dashboard-content">

        <section class="manager-dashboard-panel manager-task-panel"
                 aria-labelledby="assigned-tasks-title">

            <div class="manager-panel-heading">

                <div>
                    <p class="section-label mb-1">Your workload</p>
                    <h2 id="assigned-tasks-title">Tasks assigned to you</h2>
                </div>

                <span class="manager-panel-icon manager-panel-icon-blue"
                      aria-hidden="true">

                    <i class="bi bi-check2-square"></i>

                </span>

            </div>

        </section>

    </div>

</div>

@code {
    private const int PreviewPageSize = 1;

    // Dashboard metric values

    private int? employeesCount;
    private int? teamsCount;
    private int? workspacesCount;
    private int? projectsCount;
    private int? boardsCount;
    private int? assignedTasksCount;

    // Independent metric loading and error states

    private AsyncOperationState employeesLoad = new()
    {
        IsLoading = true
    };

    private AsyncOperationState teamsLoad = new()
    {
        IsLoading = true
    };

    private AsyncOperationState workspacesLoad = new()
    {
        IsLoading = true
    };

    private AsyncOperationState projectsLoad = new()
    {
        IsLoading = true
    };

    private AsyncOperationState boardsLoad = new()
    {
        IsLoading = true
    };

    private AsyncOperationState tasksLoad = new()
    {
        IsLoading = true
    };

    protected override Task OnInitializedAsync()
    {
        return Task.WhenAll(
            LoadEmployeesAsync(),
            LoadTeamsAsync(),
            LoadWorkspacesAsync(),
            LoadProjectsAsync(),
            LoadBoardsAsync(),
            LoadAssignedTasksAsync());
    }

    // Direct reports

    private async Task LoadEmployeesAsync()
    {
        employeesLoad.IsLoading = true;
        employeesLoad.Error = null;

        try
        {
            var result = await ManagerEmployeeApiService.GetManagedEmployeesAsync(
                new PagedRequest
                {
                    Page = 1,
                    PageSize = PreviewPageSize
                });

            employeesCount = result?.TotalCount;

            if (result is null)
            {
                employeesLoad.Error = "Direct reports are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            employeesLoad.Error =
                "The Manager-Employee service could not be reached.";
        }
        catch (JsonException)
        {
            employeesLoad.Error =
                "The Manager-Employee service returned an invalid response.";
        }
        finally
        {
            employeesLoad.IsLoading = false;
        }
    }

    // Teams

    private async Task LoadTeamsAsync()
    {
        teamsLoad.IsLoading = true;
        teamsLoad.Error = null;

        try
        {
            var result = await TeamApiService.GetMineAsync(
                new PagedSearchRequest
                {
                    Page = 1,
                    PageSize = PreviewPageSize
                });

            teamsCount = result?.TotalCount;

            if (result is null)
            {
                teamsLoad.Error = "Team membership totals are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            teamsLoad.Error = "The team service could not be reached.";
        }
        catch (JsonException)
        {
            teamsLoad.Error = "The team service returned an invalid response.";
        }
        finally
        {
            teamsLoad.IsLoading = false;
        }
    }

    // Accessible workspaces

    private async Task LoadWorkspacesAsync()
    {
        workspacesLoad.IsLoading = true;
        workspacesLoad.Error = null;

        try
        {
            var result = await WorkspaceApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = 1,
                    PageSize = PreviewPageSize
                });

            workspacesCount = result?.TotalCount;

            if (result is null)
            {
                workspacesLoad.Error =
                    "Accessible workspace totals are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            workspacesLoad.Error =
                "The workspace service could not be reached.";
        }
        catch (JsonException)
        {
            workspacesLoad.Error =
                "The workspace service returned an invalid response.";
        }
        finally
        {
            workspacesLoad.IsLoading = false;
        }
    }

    // Accessible projects

    private async Task LoadProjectsAsync()
    {
        projectsLoad.IsLoading = true;
        projectsLoad.Error = null;

        try
        {
            var result = await ProjectApiService.GetMineAsync(
                new ProjectQueryRequest
                {
                    Page = 1,
                    PageSize = PreviewPageSize
                });

            projectsCount = result?.TotalCount;

            if (result is null)
            {
                projectsLoad.Error =
                    "Accessible project totals are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            projectsLoad.Error =
                "The project service could not be reached.";
        }
        catch (JsonException)
        {
            projectsLoad.Error =
                "The project service returned an invalid response.";
        }
        finally
        {
            projectsLoad.IsLoading = false;
        }
    }

    // Accessible boards

    private async Task LoadBoardsAsync()
    {
        boardsLoad.IsLoading = true;
        boardsLoad.Error = null;

        try
        {
            var result = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    Page = 1,
                    PageSize = PreviewPageSize
                });

            boardsCount = result?.TotalCount;

            if (result is null)
            {
                boardsLoad.Error =
                    "Accessible board totals are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            boardsLoad.Error =
                "The board service could not be reached.";
        }
        catch (JsonException)
        {
            boardsLoad.Error =
                "The board service returned an invalid response.";
        }
        finally
        {
            boardsLoad.IsLoading = false;
        }
    }

    // Assigned tasks

    private async Task LoadAssignedTasksAsync()
    {
        tasksLoad.IsLoading = true;
        tasksLoad.Error = null;

        try
        {
            var result = await TaskApiService.GetMyTasksAsync(
                new MyTasksQueryRequest
                {
                    Page = 1,
                    PageSize = PreviewPageSize
                });

            assignedTasksCount = result?.TotalCount;

            if (result is null)
            {
                tasksLoad.Error =
                    "Assigned task totals are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            tasksLoad.Error =
                "The task service could not be reached.";
        }
        catch (JsonException)
        {
            tasksLoad.Error =
                "The task service returned an invalid response.";
        }
        finally
        {
            tasksLoad.IsLoading = false;
        }
    }
}
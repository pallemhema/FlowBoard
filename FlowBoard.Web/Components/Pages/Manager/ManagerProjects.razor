@page "/manager/projects"
@page "/manager/projects/{Id:guid}"

@attribute [Authorize(Policy = AuthorizationPolicies.ManagerOnly)]

@implements IDisposable

@inject IProjectApiService ProjectApiService
@inject IBoardApiService BoardApiService

@if (Id is null)
{
    <PageTitle>My Projects | FlowBoard</PageTitle>

    <div class="page-shell manager-projects-page">

        <PageHeader Title="My projects"
                    Eyebrow="Your work"
                    Description="Projects assigned to you and the boards you can access." />

        <DataListPanel Title="Projects"
                       CountText="@(projectList.Data is null
                           ? null
                           : $"{projectList.Data.TotalCount} {(projectList.Data.TotalCount == 1 ? "project" : "projects")}")"
                       CssClass="manager-project-list-panel">

            <Toolbar>
                <DataListToolBar SearchValue="@search"
                                 SearchValueChanged="HandleSearchChangedAsync"
                                 SearchPlaceholder="Search projects..." />
            </Toolbar>

            <ChildContent>

                @if (projectList.IsLoading)
                {
                    <div class="manager-projects-loading" role="status" aria-live="polite">
                        <span class="spinner-border spinner-border-sm text-primary"
                              aria-hidden="true"></span>
                        <span>Loading your projects...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(projectList.Error))
                {
                    <div class="manager-projects-error" role="alert">
                        <span>@projectList.Error</span>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="() => LoadProjectsAsync(projectList.CurrentPage)">
                            Try again
                        </button>
                    </div>
                }
                else if (projectList.Data is { Items.Count: 0 })
                {
                    <EmptyState Title="@(string.IsNullOrWhiteSpace(search)
                                         ? "No projects available"
                                         : "No projects match your search")"
                                Message="@(string.IsNullOrWhiteSpace(search)
                                           ? "Projects you can access will appear here."
                                           : "Try changing your search.")" />
                }
                else if (projectList.Data is not null)
                {
                    <section class="manager-project-grid"
                             aria-label="Projects you can access">

                        @foreach (var projectItem in projectList.Data.Items)
                        {
                            <article class="manager-project-card"
                                     @key="projectItem.ProjectId">

                                <div class="manager-project-card-header">

                                    <div class="manager-project-icon"
                                         aria-hidden="true">
                                        <i class="bi bi-kanban"></i>
                                    </div>

                                    <span class="manager-project-status manager-project-status-@GetStatusClass(projectItem.Status)">
                                        @GetStatusLabel(projectItem.Status)
                                    </span>

                                </div>

                                <h2>@projectItem.Name</h2>

                                <p class="manager-project-description">
                                    @(string.IsNullOrWhiteSpace(projectItem.Description)
                                        ? "No description provided."
                                        : projectItem.Description)
                                </p>

                                <div class="manager-project-workspace">
                                    <i class="bi bi-grid" aria-hidden="true"></i>
                                    <span>@projectItem.WorkspaceName</span>
                                </div>

                                <a class="btn btn-outline-primary manager-project-open"
                                   href="@($"/manager/projects/{projectItem.ProjectId}")">

                                    View project

                                    <i class="bi bi-arrow-right ms-1"
                                       aria-hidden="true"></i>

                                </a>

                            </article>
                        }

                    </section>

                    <Pagination CurrentPage="projectList.CurrentPage"
                                TotalPages="projectList.Data.TotalPages"
                                TotalCount="projectList.Data.TotalCount"
                                PageSize="@projectList.Data.PageSize"
                                PageChanged="LoadProjectsAsync" />
                }

            </ChildContent>

        </DataListPanel>

    </div>
}
else
{
    <PageTitle>@(project?.Name ?? "Project details") | FlowBoard</PageTitle>

    <div class="page-shell manager-project-details-page">

        <a class="btn btn-link px-0 manager-project-back"
           href="/manager/projects">

            <i class="bi bi-arrow-left me-1"
               aria-hidden="true"></i>

            Back to my projects

        </a>

        @if (projectDetailsLoad.IsLoading)
        {
            <div class="manager-projects-loading"
                 role="status"
                 aria-live="polite">

                <span class="spinner-border spinner-border-sm text-primary"
                      aria-hidden="true"></span>

                <span>Loading project details...</span>

            </div>
        }
        else if (project is null)
        {
            <div class="manager-projects-error" role="alert">

                <span>
                    @(projectDetailsLoad.Error ??
                      "Project details could not be loaded or you do not have access.")
                </span>

                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="() => LoadProjectDetailsAsync(Id.Value)">

                    Try again

                </button>

            </div>
        }
        else
        {
            <PageHeader Title="@project.Name"
                        Eyebrow="Project details"
                        Description="@(string.IsNullOrWhiteSpace(project.Description)
                            ? "No description provided."
                            : project.Description)" />

            @* Project summary *@

            <section class="manager-project-summary"
                     aria-label="Project information">

                <div class="manager-project-facts">

                    <div>
                        <span class="manager-project-label">Workspace</span>
                        <p>@project.WorkspaceName</p>
                    </div>

                    <div>
                        <span class="manager-project-label">Status</span>

                        <p>
                            <span class="manager-project-status manager-project-status-@GetStatusClass(project.Status)">
                                @GetStatusLabel(project.Status)
                            </span>
                        </p>
                    </div>

                    <div>
                        <span class="manager-project-label">Schedule</span>

                        <p>
                            @project.StartDate.ToString("MMM d, yyyy")
                            -
                            @project.EndDate.ToString("MMM d, yyyy")
                        </p>
                    </div>

                    <div class="manager-project-manager">

                        <span class="manager-project-label">
                            Project manager
                        </span>

                        <div class="manager-project-person">

                            <UserAvatar FirstName="@project.Manager.FirstName"
                                        LastName="@project.Manager.LastName"
                                        SizeRem="2.25" />

                            <span>
                                <strong>
                                    @GetFullName(
                                        project.Manager.FirstName,
                                        project.Manager.LastName)
                                </strong>

                                <small>@project.Manager.Email</small>
                            </span>

                        </div>

                    </div>

                </div>

            </section>

            @* Accessible boards *@

            <DataListPanel Title="Accessible boards"
                           TitleId="manager-project-boards-title"
                           Description="Board access"
                           CountText="@(projectBoards is null
                               ? null
                               : $"{projectBoards.Count} {(projectBoards.Count == 1 ? "board" : "boards")}")"
                           CssClass="manager-project-resource-panel">

                <ChildContent>

                    @if (projectBoardsLoad.IsLoading)
                    {
                        <div class="manager-projects-loading"
                             role="status">

                            <span class="spinner-border spinner-border-sm text-primary"
                                  aria-hidden="true"></span>

                            <span>Loading accessible boards...</span>

                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(projectBoardsLoad.Error))
                    {
                        <div class="manager-projects-error"
                             role="alert">

                            <span>@projectBoardsLoad.Error</span>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="RetryProjectBoardsAsync">

                                Try again

                            </button>

                        </div>
                    }
                    else if (projectBoards is { Count: 0 })
                    {
                        <EmptyState Title="No accessible project boards"
                                    Message="You may not have board access to every board associated with this project." />
                    }
                    else if (projectBoards is not null)
                    {
                        <div class="manager-project-board-list">

                            @foreach (var board in projectBoards)
                            {
                                <article class="manager-project-board-row"
                                         @key="board.Id">

                                    <div class="manager-project-board-copy">

                                        <strong>@board.Name</strong>

                                        <span>
                                            @(board.Purpose == BoardPurpose.GeneralLearning
                                                ? "General / Learning"
                                                : "Project")
                                        </span>

                                    </div>

                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@($"/workspaces/{board.WorkspaceId}/boards/{board.Id}")"
                                       aria-label="@($"Open board {board.Name}")">

                                        Open board

                                        <i class="bi bi-arrow-up-right ms-1"
                                           aria-hidden="true"></i>

                                    </a>

                                </article>
                            }

                        </div>
                    }

                </ChildContent>

            </DataListPanel>

            @* Project members *@

            <DataListPanel Title="Project members"
                           TitleId="manager-project-members-title"
                           Description="Project membership"
                           CountText="@(memberList.Data is null
                               ? null
                               : $"{memberList.Data.TotalCount} {(memberList.Data.TotalCount == 1 ? "member" : "members")}")"
                           CssClass="manager-project-resource-panel">

                <ChildContent>

                    @if (memberList.IsLoading)
                    {
                        <div class="manager-projects-loading"
                             role="status">

                            <span class="spinner-border spinner-border-sm text-primary"
                                  aria-hidden="true"></span>

                            <span>Loading project members...</span>

                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(memberList.Error))
                    {
                        <div class="manager-projects-error"
                             role="alert">

                            <span>@memberList.Error</span>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="RetryProjectMembersAsync">

                                Try again

                            </button>

                        </div>
                    }
                    else if (memberList.Data is { Items.Count: 0 })
                    {
                        <EmptyState Title="No project members"
                                    Message="Employees added to this project will appear here." />
                    }
                    else if (memberList.Data is not null)
                    {
                        <div class="manager-project-member-list">

                            @foreach (var member in memberList.Data.Items)
                            {
                                <article class="manager-project-member-row"
                                         @key="member.UserId">

                                    <UserAvatar FirstName="@member.User.FirstName"
                                                LastName="@member.User.LastName"
                                                SizeRem="2.25" />

                                    <span class="manager-project-person-copy">

                                        <strong>
                                            @GetFullName(
                                                member.User.FirstName,
                                                member.User.LastName)
                                        </strong>

                                        <small>@member.User.Email</small>

                                    </span>

                                    <span class="manager-project-joined">
                                        Joined @member.JoinedAt.ToLocalTime().ToString("MMM d, yyyy")
                                    </span>

                                </article>
                            }

                        </div>

                        <Pagination CurrentPage="memberList.CurrentPage"
                                    TotalPages="memberList.Data.TotalPages"
                                    TotalCount="memberList.Data.TotalCount"
                                    PageSize="@memberList.Data.PageSize"
                                    PageChanged="HandleMembersPageChangedAsync" />
                    }

                </ChildContent>

            </DataListPanel>

        }

    </div>
}

@code {
    private const int ProjectPageSize = 12;
    private const int BoardPageSize = 100;
    private const int MemberPageSize = 10;

    [Parameter]
    public Guid? Id { get; set; }

    // Project listing
    private PagedListState<ProjectResponse> projectList = new()
    {
        PageSize = ProjectPageSize,
        IsLoading = true
    };

    // Project details
    private ProjectResponse? project;

    private AsyncOperationState projectDetailsLoad = new();

    // Project boards
    private List<BoardResponse>? projectBoards;

    private AsyncOperationState projectBoardsLoad = new();

    // Project members
    private PagedListState<ProjectMemberResponse> memberList = new()
    {
        PageSize = MemberPageSize
    };

    // Search
    private string? search;

    private readonly DebouncedAction searchDebounce = new();

    // Request versioning
    private long projectsRequestVersion;
    private long detailsRequestVersion;
    private long membersRequestVersion;

    // Cancellation
    private CancellationTokenSource? activeProjectsCts;
    private CancellationTokenSource? activeDetailsCts;

    // Route tracking
    private Guid? lastRequestedProjectId;
    private bool hasLoadedRoute;

    protected override async Task OnParametersSetAsync()
    {
        if (hasLoadedRoute && lastRequestedProjectId == Id)
        {
            return;
        }

        hasLoadedRoute = true;
        lastRequestedProjectId = Id;

        if (Id.HasValue)
        {
            await LoadProjectDetailsAsync(Id.Value);
        }
        else
        {
            CancelProjectDetails();
            await LoadProjectsAsync(1);
        }
    }

    private Task HandleSearchChangedAsync(string? value)
    {
        search = value?.Trim();

        projectList.CurrentPage = 1;

        return searchDebounce.ExecuteAsync(
            () => LoadProjectsAsync(1));
    }

    // Load projects

    private async Task LoadProjectsAsync(int requestedPage)
    {
        projectList.CurrentPage = requestedPage;
        projectList.Error = null;
        projectList.IsLoading = true;

        activeProjectsCts?.Cancel();
        activeProjectsCts?.Dispose();

        activeProjectsCts = new CancellationTokenSource();

        var cancellationToken = activeProjectsCts.Token;
        var requestVersion = ++projectsRequestVersion;

        try
        {
            var result = await ProjectApiService.GetMineAsync(
                new ProjectQueryRequest
                {
                    Page = requestedPage,
                    PageSize = projectList.PageSize,
                    Search = search?.Trim()
                },
                cancellationToken);

            if (requestVersion != projectsRequestVersion)
            {
                return;
            }

            if (result is null)
            {
                projectList.Data = null;
                projectList.Error =
                    "Unable to load your projects. Please try again.";

                return;
            }

            projectList.Data = result;
        }
        catch (OperationCanceledException)
        {
            // A newer request has replaced this request.
        }
        catch (HttpRequestException)
        {
            if (requestVersion == projectsRequestVersion)
            {
                projectList.Data = null;
                projectList.Error =
                    "The project service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == projectsRequestVersion)
            {
                projectList.Data = null;
                projectList.Error =
                    "The project service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == projectsRequestVersion)
            {
                projectList.IsLoading = false;
            }
        }
    }

    // Load project details

    private async Task LoadProjectDetailsAsync(Guid projectId)
    {
        CancelProjectDetails();

        activeDetailsCts = new CancellationTokenSource();

        var cancellationToken = activeDetailsCts.Token;
        var requestVersion = ++detailsRequestVersion;

        projectDetailsLoad.IsLoading = true;
        projectDetailsLoad.Error = null;

        projectBoardsLoad.IsLoading = false;
        projectBoardsLoad.Error = null;

        memberList.Data = null;
        memberList.Error = null;
        memberList.IsLoading = false;
        memberList.CurrentPage = 1;

        project = null;
        projectBoards = null;

        try
        {
            var result = await ProjectApiService.GetByIdAsync(
                projectId,
                cancellationToken);

            if (requestVersion != detailsRequestVersion)
            {
                return;
            }

            if (result is null)
            {
                projectDetailsLoad.Error =
                    "Project details could not be loaded or you do not have access.";

                return;
            }

            project = result;

            await Task.WhenAll(
                LoadProjectBoardsAsync(
                    requestVersion,
                    result,
                    cancellationToken),

                LoadProjectMembersAsync(
                    1,
                    requestVersion,
                    cancellationToken));
        }
        catch (OperationCanceledException)
        {
            // A newer request or route change cancelled this request.
        }
        catch (HttpRequestException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectDetailsLoad.Error =
                    "The project service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectDetailsLoad.Error =
                    "The project service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectDetailsLoad.IsLoading = false;
            }
        }
    }

    // Load accessible boards

    private async Task LoadProjectBoardsAsync(
        long requestVersion,
        ProjectResponse selectedProject,
        CancellationToken cancellationToken)
    {
        projectBoardsLoad.IsLoading = true;
        projectBoardsLoad.Error = null;

        try
        {
            var firstPage = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    WorkspaceId = selectedProject.WorkspaceId,
                    Page = 1,
                    PageSize = BoardPageSize
                },
                cancellationToken);

            if (requestVersion != detailsRequestVersion)
            {
                return;
            }

            if (firstPage is null)
            {
                projectBoards = null;
                projectBoardsLoad.Error =
                    "Accessible project boards could not be loaded.";

                return;
            }

            var accessibleBoards = firstPage.Items.ToList();

            for (var requestedPage = 2;
                 requestedPage <= firstPage.TotalPages;
                 requestedPage++)
            {
                var nextPage = await BoardApiService.GetAsync(
                    new BoardQueryRequest
                    {
                        WorkspaceId = selectedProject.WorkspaceId,
                        Page = requestedPage,
                        PageSize = BoardPageSize
                    },
                    cancellationToken);

                if (requestVersion != detailsRequestVersion)
                {
                    return;
                }

                if (nextPage is null)
                {
                    projectBoards = null;

                    projectBoardsLoad.Error =
                        "Accessible boards could not be fully loaded. Partial results are withheld.";

                    return;
                }

                accessibleBoards.AddRange(nextPage.Items);
            }

            projectBoards = accessibleBoards
                .Where(board =>
                    board.ProjectId == selectedProject.ProjectId &&
                    board.WorkspaceId == selectedProject.WorkspaceId)
                .OrderBy(board => board.Name)
                .ToList();
        }
        catch (OperationCanceledException)
        {
            // Request cancelled.
        }
        catch (HttpRequestException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectBoards = null;

                projectBoardsLoad.Error =
                    "The board service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectBoards = null;

                projectBoardsLoad.Error =
                    "The board service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectBoardsLoad.IsLoading = false;
            }
        }
    }

    // Load project members

    private async Task LoadProjectMembersAsync(
        int requestedPage,
        long requestVersion,
        CancellationToken cancellationToken)
    {
        if (project is null)
        {
            return;
        }

        memberList.CurrentPage = requestedPage;
        memberList.IsLoading = true;
        memberList.Error = null;

        var membersVersion = ++membersRequestVersion;

        try
        {
            var result = await ProjectApiService.GetMembersAsync(
                project.ProjectId,
                new PagedSearchRequest
                {
                    Page = requestedPage,
                    PageSize = memberList.PageSize
                },
                cancellationToken);

            if (requestVersion != detailsRequestVersion ||
                membersVersion != membersRequestVersion)
            {
                return;
            }

            if (result is null)
            {
                memberList.Data = null;
                memberList.Error =
                    "Project members could not be loaded.";

                return;
            }

            memberList.Data = result;
        }
        catch (OperationCanceledException)
        {
            // Request cancelled.
        }
        catch (HttpRequestException)
        {
            if (requestVersion == detailsRequestVersion &&
                membersVersion == membersRequestVersion)
            {
                memberList.Data = null;
                memberList.Error =
                    "The project service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == detailsRequestVersion &&
                membersVersion == membersRequestVersion)
            {
                memberList.Data = null;
                memberList.Error =
                    "The project service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == detailsRequestVersion &&
                membersVersion == membersRequestVersion)
            {
                memberList.IsLoading = false;
            }
        }
    }

    // Member pagination

    private Task HandleMembersPageChangedAsync(int requestedPage)
    {
        if (activeDetailsCts is null)
        {
            return Task.CompletedTask;
        }

        return LoadProjectMembersAsync(
            requestedPage,
            detailsRequestVersion,
            activeDetailsCts.Token);
    }

    // Retry boards

    private Task RetryProjectBoardsAsync()
    {
        if (project is null || activeDetailsCts is null)
        {
            return Task.CompletedTask;
        }

        return LoadProjectBoardsAsync(
            detailsRequestVersion,
            project,
            activeDetailsCts.Token);
    }

    // Retry members

    private Task RetryProjectMembersAsync()
    {
        if (project is null || activeDetailsCts is null)
        {
            return Task.CompletedTask;
        }

        return LoadProjectMembersAsync(
            memberList.CurrentPage,
            detailsRequestVersion,
            activeDetailsCts.Token);
    }

    // Cancel project details requests

    private void CancelProjectDetails()
    {
        detailsRequestVersion++;
        membersRequestVersion++;

        activeDetailsCts?.Cancel();
        activeDetailsCts?.Dispose();
        activeDetailsCts = null;

        project = null;
        projectBoards = null;

        projectDetailsLoad.IsLoading = false;
        projectDetailsLoad.Error = null;

        projectBoardsLoad.IsLoading = false;
        projectBoardsLoad.Error = null;

        memberList.Data = null;
        memberList.IsLoading = false;
        memberList.Error = null;
        memberList.CurrentPage = 1;
    }

    // Project status helpers

    private static string GetStatusLabel(ProjectStatus status) =>
        status switch
        {
            ProjectStatus.Active => "Active",
            ProjectStatus.Completed => "Completed",
            ProjectStatus.OnHold => "On hold",
            _ => status.ToString()
        };

    private static string GetStatusClass(ProjectStatus status) =>
        status switch
        {
            ProjectStatus.Active => "active",
            ProjectStatus.Completed => "completed",
            ProjectStatus.OnHold => "on-hold",
            _ => "unknown"
        };

    private static string GetFullName(
        string firstName,
        string lastName) =>
        $"{firstName} {lastName}".Trim();

    // Cleanup

    public void Dispose()
    {
        searchDebounce.Dispose();

        activeProjectsCts?.Cancel();
        activeProjectsCts?.Dispose();

        activeDetailsCts?.Cancel();
        activeDetailsCts?.Dispose();
    }
}
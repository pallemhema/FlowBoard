@page "/manager/projects"
@page "/manager/projects/{Id:guid}"
@attribute [Authorize(Policy = AuthorizationPolicies.ManagerOnly)]
@implements IDisposable

@using System.Net.Http
@using System.Text.Json
@using FlowBoard.Shared.DTOs.Boards
@using FlowBoard.Shared.DTOs.Projects
@using FlowBoard.Shared.Enums

@inject IProjectApiService ProjectApiService
@inject IBoardApiService BoardApiService

@if (Id is null)
{
    <PageTitle>My Projects | FlowBoard</PageTitle>

    <div class="page-shell manager-projects-page">
        <PageHeader Title="My projects"
                    Eyebrow="Your work"
                    Description="Projects assigned to you and the boards you can access." />

        <div class="manager-projects-search">
            <SearchBox Value="@search"
                       ValueChanged="HandleSearchChangedAsync"
                       Placeholder="Search projects..." />
        </div>

        @if (isLoadingProjects)
        {
            <div class="manager-projects-loading" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                <span>Loading your projects...</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(projectsError))
        {
            <div class="manager-projects-error" role="alert">
                <span>@projectsError</span>
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="() => LoadProjectsAsync(page)">
                    Try again
                </button>
            </div>
        }
        else if (projectPage is { Items.Count: 0 })
        {
            <EmptyState Title="@(string.IsNullOrWhiteSpace(search) ? "No projects available" : "No projects match your search")"
                        Message="@(string.IsNullOrWhiteSpace(search) ? "Projects you can access will appear here." : "Try changing your search.")" />
        }
        else if (projectPage is not null)
        {
            <div class="manager-projects-results-heading">
                <p class="mb-0">@projectPage.TotalCount @(projectPage.TotalCount == 1 ? "project" : "projects")</p>
            </div>

            <section class="manager-project-grid" aria-label="Projects you can access">
                @foreach (var project in projectPage.Items)
                {
                    <article class="manager-project-card" @key="project.ProjectId">
                        <div class="manager-project-card-header">
                            <div class="manager-project-icon" aria-hidden="true">
                                <i class="bi bi-kanban"></i>
                            </div>
                            <span class="manager-project-status manager-project-status-@GetStatusClass(project.Status)">
                                @GetStatusLabel(project.Status)
                            </span>
                        </div>

                        <h2>@project.Name</h2>
                        <p class="manager-project-description">
                            @(string.IsNullOrWhiteSpace(project.Description)
                                ? "No description provided."
                                : project.Description)
                        </p>

                        <div class="manager-project-workspace">
                            <i class="bi bi-grid" aria-hidden="true"></i>
                            <span>@project.WorkspaceName</span>
                        </div>

                        <a class="btn btn-outline-primary manager-project-open"
                           href="@($"/manager/projects/{project.ProjectId}")">
                            View project
                            <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                        </a>
                    </article>
                }
            </section>

            <Pagination CurrentPage="page"
                        TotalPages="projectPage.TotalPages"
                        TotalCount="projectPage.TotalCount"
                        PageChanged="LoadProjectsAsync" />
        }
    </div>
}
else
{
    <PageTitle>@(project?.Name ?? "Project details") | FlowBoard</PageTitle>

    <div class="page-shell manager-project-details-page">
        <a class="btn btn-link px-0 manager-project-back" href="/manager/projects">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Back to my projects
        </a>

        @if (isLoadingProject)
        {
            <div class="manager-projects-loading" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                <span>Loading project details...</span>
            </div>
        }
        else if (project is null)
        {
            <div class="manager-projects-error" role="alert">
                <span>@(projectError ?? "Project details could not be loaded or you do not have access.")</span>
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="() => LoadProjectDetailsAsync(Id.Value)">
                    Try again
                </button>
            </div>
        }
        else
        {
            <PageHeader Title="@project.Name"
                        Eyebrow="Project details"
                        Description="@(string.IsNullOrWhiteSpace(project.Description) ? "No description provided." : project.Description)" />

            <section class="manager-project-summary" aria-label="Project information">
                <div class="manager-project-facts">
                    <div>
                        <span class="manager-project-label">Workspace</span>
                        <p>@project.WorkspaceName</p>
                    </div>
                    <div>
                        <span class="manager-project-label">Status</span>
                        <p>
                            <span class="manager-project-status manager-project-status-@GetStatusClass(project.Status)">
                                @GetStatusLabel(project.Status)
                            </span>
                        </p>
                    </div>
                    <div>
                        <span class="manager-project-label">Schedule</span>
                        <p>@project.StartDate.ToLocalTime().ToString("MMM d, yyyy") - @project.EndDate.ToLocalTime().ToString("MMM d, yyyy")</p>
                    </div>
                    <div class="manager-project-manager">
                        <span class="manager-project-label">Project manager</span>
                        <div class="manager-project-person">
                            <UserAvatar FirstName="@project.Manager.FirstName"
                                        LastName="@project.Manager.LastName"
                                        SizeRem="2.25" />
                            <span>
                                <strong>@GetFullName(project.Manager.FirstName, project.Manager.LastName)</strong>
                                <small>@project.Manager.Email</small>
                            </span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="manager-project-resource-panel" aria-labelledby="manager-project-boards-title">
                <div class="manager-project-section-heading">
                    <div>
                        <p class="section-label mb-1">Board access</p>
                        <h2 id="manager-project-boards-title">Accessible boards</h2>
                    </div>
                    @if (projectBoards is not null)
                    {
                        <span class="manager-project-count">@projectBoards.Count @(projectBoards.Count == 1 ? "board" : "boards")</span>
                    }
                </div>

                @if (isLoadingProjectBoards)
                {
                    <div class="manager-projects-loading" role="status">
                        <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                        <span>Loading accessible boards...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(projectBoardsError))
                {
                    <div class="manager-projects-error" role="alert">
                        <span>@projectBoardsError</span>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="RetryProjectBoardsAsync">
                            Try again
                        </button>
                    </div>
                }
                else if (projectBoards is { Count: 0 })
                {
                    <EmptyState Title="No accessible project boards"
                                Message="You may not have board access to every board associated with this project." />
                }
                else if (projectBoards is not null)
                {
                    <div class="manager-project-board-list">
                        @foreach (var board in projectBoards)
                        {
                            <article class="manager-project-board-row" @key="board.Id">
                                <div class="manager-project-board-copy">
                                    <strong>@board.Name</strong>
                                    <span>@(board.Purpose == BoardPurpose.GeneralLearning ? "General / Learning" : "Project")</span>
                                </div>
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@($"/workspaces/{board.WorkspaceId}/boards/{board.Id}")"
                                   aria-label="@($"Open board {board.Name}")">
                                    Open board
                                    <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i>
                                </a>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="manager-project-resource-panel" aria-labelledby="manager-project-members-title">
                <div class="manager-project-section-heading">
                    <div>
                        <p class="section-label mb-1">Project membership</p>
                        <h2 id="manager-project-members-title">Project members</h2>
                    </div>
                    @if (projectMembers is not null)
                    {
                        <span class="manager-project-count">@projectMembers.TotalCount @(projectMembers.TotalCount == 1 ? "member" : "members")</span>
                    }
                </div>

                @if (isLoadingProjectMembers)
                {
                    <div class="manager-projects-loading" role="status">
                        <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                        <span>Loading project members...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(projectMembersError))
                {
                    <div class="manager-projects-error" role="alert">
                        <span>@projectMembersError</span>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="RetryProjectMembersAsync">
                            Try again
                        </button>
                    </div>
                }
                else if (projectMembers is { Items.Count: 0 })
                {
                    <EmptyState Title="No project members"
                                Message="Employees added to this project will appear here." />
                }
                else if (projectMembers is not null)
                {
                    <div class="manager-project-member-list">
                        @foreach (var member in projectMembers.Items)
                        {
                            <article class="manager-project-member-row" @key="member.UserId">
                                <UserAvatar FirstName="@member.User.FirstName"
                                            LastName="@member.User.LastName"
                                            SizeRem="2.25" />
                                <span class="manager-project-person-copy">
                                    <strong>@GetFullName(member.User.FirstName, member.User.LastName)</strong>
                                    <small>@member.User.Email</small>
                                </span>
                                <span class="manager-project-joined">
                                    Joined @member.JoinedAt.ToLocalTime().ToString("MMM d, yyyy")
                                </span>
                            </article>
                        }
                    </div>

                    <Pagination CurrentPage="projectMembersPage"
                                TotalPages="projectMembers.TotalPages"
                                TotalCount="projectMembers.TotalCount"
                                PageChanged="HandleMembersPageChangedAsync" />
                }
            </section>
        }
    </div>
}

@code {
    private const int ProjectPageSize = 12;
    private const int BoardPageSize = 100;
    private const int MemberPageSize = 10;

    [Parameter]
    public Guid? Id { get; set; }

    private PagedResponse<ProjectResponse>? projectPage;
    private ProjectResponse? project;
    private List<BoardResponse>? projectBoards;
    private PagedResponse<ProjectMemberResponse>? projectMembers;
    private string? search;
    private string? projectsError;
    private string? projectError;
    private string? projectBoardsError;
    private string? projectMembersError;
    private bool isLoadingProjects;
    private bool isLoadingProject;
    private bool isLoadingProjectBoards;
    private bool isLoadingProjectMembers;
    private int page = 1;
    private int projectMembersPage = 1;
    private long projectsRequestVersion;
    private long detailsRequestVersion;
    private long membersRequestVersion;
    private CancellationTokenSource? activeProjectsCts;
    private CancellationTokenSource? activeDetailsCts;
    private CancellationTokenSource? searchDebounceCts;
    private Guid? lastRequestedProjectId;
    private bool hasLoadedRoute;

    protected override async Task OnParametersSetAsync()
    {
        if (hasLoadedRoute && lastRequestedProjectId == Id)
        {
            return;
        }

        hasLoadedRoute = true;
        lastRequestedProjectId = Id;

        if (Id.HasValue)
        {
            await LoadProjectDetailsAsync(Id.Value);
        }
        else
        {
            CancelProjectDetails();
            await LoadProjectsAsync(1);
        }
    }

    private async Task HandleSearchChangedAsync(string? value)
    {
        search = value;
        searchDebounceCts?.Cancel();
        searchDebounceCts?.Dispose();
        var debounceCts = searchDebounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(250), debounceCts.Token);
            await LoadProjectsAsync(1);
        }
        catch (OperationCanceledException) when (debounceCts.IsCancellationRequested)
        {
        }
    }

    private async Task LoadProjectsAsync(int requestedPage)
    {
        page = requestedPage;
        projectsError = null;
        activeProjectsCts?.Cancel();
        activeProjectsCts?.Dispose();
        var loadCts = activeProjectsCts = new CancellationTokenSource();
        var requestVersion = ++projectsRequestVersion;
        isLoadingProjects = true;

        try
        {
            var result = await ProjectApiService.GetMineAsync(
                new ProjectQueryRequest
                {
                    Page = requestedPage,
                    PageSize = ProjectPageSize,
                    Search = search?.Trim()
                },
                loadCts.Token);

            if (requestVersion != projectsRequestVersion)
            {
                return;
            }

            if (result is null)
            {
                projectPage = null;
                projectsError = "Unable to load your projects. Please try again.";
                return;
            }

            projectPage = result;
        }
        catch (OperationCanceledException) when (loadCts.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            if (requestVersion == projectsRequestVersion)
            {
                projectPage = null;
                projectsError = "The project service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == projectsRequestVersion)
            {
                projectPage = null;
                projectsError = "The project service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == projectsRequestVersion)
            {
                isLoadingProjects = false;
            }
        }
    }

    private async Task LoadProjectDetailsAsync(Guid projectId)
    {
        CancelProjectDetails();
        var loadCts = activeDetailsCts = new CancellationTokenSource();
        var requestVersion = ++detailsRequestVersion;
        project = null;
        projectBoards = null;
        projectMembers = null;
        projectError = null;
        projectBoardsError = null;
        projectMembersError = null;
        projectMembersPage = 1;
        isLoadingProject = true;
        isLoadingProjectBoards = false;
        isLoadingProjectMembers = false;

        try
        {
            var result = await ProjectApiService.GetByIdAsync(projectId, loadCts.Token);
            if (requestVersion != detailsRequestVersion)
            {
                return;
            }

            if (result is null)
            {
                projectError = "Project details could not be loaded or you do not have access.";
                return;
            }

            project = result;
            await Task.WhenAll(
                LoadProjectBoardsAsync(requestVersion, result, loadCts.Token),
                LoadProjectMembersAsync(1, requestVersion, loadCts.Token));
        }
        catch (OperationCanceledException) when (loadCts.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectError = "The project service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectError = "The project service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == detailsRequestVersion)
            {
                isLoadingProject = false;
            }
        }
    }

    private async Task LoadProjectBoardsAsync(
        long requestVersion,
        ProjectResponse selectedProject,
        CancellationToken cancellationToken)
    {
        isLoadingProjectBoards = true;
        projectBoardsError = null;

        try
        {
            var firstPage = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    WorkspaceId = selectedProject.WorkspaceId,
                    Page = 1,
                    PageSize = BoardPageSize
                },
                cancellationToken);

            if (requestVersion != detailsRequestVersion)
            {
                return;
            }

            if (firstPage is null)
            {
                projectBoards = null;
                projectBoardsError = "Accessible project boards could not be loaded.";
                return;
            }

            var accessibleBoards = firstPage.Items.ToList();
            for (var requestedPage = 2; requestedPage <= firstPage.TotalPages; requestedPage++)
            {
                var nextPage = await BoardApiService.GetAsync(
                    new BoardQueryRequest
                    {
                        WorkspaceId = selectedProject.WorkspaceId,
                        Page = requestedPage,
                        PageSize = BoardPageSize
                    },
                    cancellationToken);

                if (requestVersion != detailsRequestVersion)
                {
                    return;
                }

                if (nextPage is null)
                {
                    projectBoards = null;
                    projectBoardsError = "Accessible boards could not be fully loaded. Partial results are withheld.";
                    return;
                }

                accessibleBoards.AddRange(nextPage.Items);
            }

            projectBoards = accessibleBoards
                .Where(board =>
                    board.ProjectId == selectedProject.ProjectId &&
                    board.WorkspaceId == selectedProject.WorkspaceId)
                .OrderBy(board => board.Name)
                .ToList();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectBoards = null;
                projectBoardsError = "The board service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectBoards = null;
                projectBoardsError = "The board service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == detailsRequestVersion)
            {
                isLoadingProjectBoards = false;
            }
        }
    }

    private async Task LoadProjectMembersAsync(
        int requestedPage,
        long requestVersion,
        CancellationToken cancellationToken)
    {
        if (project is null)
        {
            return;
        }

        projectMembersPage = requestedPage;
        isLoadingProjectMembers = true;
        projectMembersError = null;
        var membersVersion = ++membersRequestVersion;

        try
        {
            var result = await ProjectApiService.GetMembersAsync(
                project.ProjectId,
                new PagedSearchRequest
                {
                    Page = requestedPage,
                    PageSize = MemberPageSize
                },
                cancellationToken);

            if (requestVersion != detailsRequestVersion ||
                membersVersion != membersRequestVersion)
            {
                return;
            }

            if (result is null)
            {
                projectMembers = null;
                projectMembersError = "Project members could not be loaded.";
                return;
            }

            projectMembers = result;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            if (requestVersion == detailsRequestVersion &&
                membersVersion == membersRequestVersion)
            {
                projectMembers = null;
                projectMembersError = "The project service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == detailsRequestVersion &&
                membersVersion == membersRequestVersion)
            {
                projectMembers = null;
                projectMembersError = "The project service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == detailsRequestVersion &&
                membersVersion == membersRequestVersion)
            {
                isLoadingProjectMembers = false;
            }
        }
    }

    private Task HandleMembersPageChangedAsync(int requestedPage) =>
        activeDetailsCts is null
            ? Task.CompletedTask
            : LoadProjectMembersAsync(
                requestedPage,
                detailsRequestVersion,
                activeDetailsCts.Token);

    private Task RetryProjectBoardsAsync() =>
        project is null || activeDetailsCts is null
            ? Task.CompletedTask
            : LoadProjectBoardsAsync(
                detailsRequestVersion,
                project,
                activeDetailsCts.Token);

    private Task RetryProjectMembersAsync() =>
        activeDetailsCts is null
            ? Task.CompletedTask
            : LoadProjectMembersAsync(
                projectMembersPage,
                detailsRequestVersion,
                activeDetailsCts.Token);

    private void CancelProjectDetails()
    {
        detailsRequestVersion++;
        membersRequestVersion++;
        activeDetailsCts?.Cancel();
        activeDetailsCts?.Dispose();
        activeDetailsCts = null;
        project = null;
        projectBoards = null;
        projectMembers = null;
        projectError = null;
        projectBoardsError = null;
        projectMembersError = null;
        isLoadingProject = false;
        isLoadingProjectBoards = false;
        isLoadingProjectMembers = false;
    }

    private static string GetStatusLabel(ProjectStatus status) =>
        status switch
        {
            ProjectStatus.Active => "Active",
            ProjectStatus.Completed => "Completed",
            ProjectStatus.OnHold => "On hold",
            _ => status.ToString()
        };

    private static string GetStatusClass(ProjectStatus status) =>
        status switch
        {
            ProjectStatus.Active => "active",
            ProjectStatus.Completed => "completed",
            ProjectStatus.OnHold => "on-hold",
            _ => "unknown"
        };

    private static string GetFullName(string firstName, string lastName) =>
        $"{firstName} {lastName}".Trim();

    public void Dispose()
    {
        searchDebounceCts?.Cancel();
        searchDebounceCts?.Dispose();
        activeProjectsCts?.Cancel();
        activeProjectsCts?.Dispose();
        activeDetailsCts?.Cancel();
        activeDetailsCts?.Dispose();
    }
}

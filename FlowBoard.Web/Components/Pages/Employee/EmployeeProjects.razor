@page "/employee/projects"

@attribute [Authorize(Policy = AuthorizationPolicies.EmployeeOnly)]

@implements IDisposable

@using System.Net.Http
@using System.Text.Json
@using FlowBoard.Shared.DTOs.Boards
@using FlowBoard.Shared.DTOs.Projects

@inject IProjectApiService ProjectApiService
@inject IBoardApiService BoardApiService

<PageTitle>My Projects | FlowBoard</PageTitle>

<div class="page-shell employee-projects">
    <PageHeader Title="My projects"
                Eyebrow="Your work"
                Description="Projects you can access, with links to their available boards." />

        <DataListPanel Title="My projects"
                    TitleId="employee-projects-title"
                    Description="Browse projects you can access and explore their available boards."
                    CountText="@(projectPage is not null && projectsLoad.Error is null
                        ? $"{projectPage.TotalCount} {(projectPage.TotalCount == 1 ? "project" : "projects")}"
                        : null)"
                    CssClass="employee-projects-panel">

            <Toolbar>
                <DataListToolBar SearchValue="@search"
                                SearchValueChanged="HandleProjectSearchChanged"
                                SearchPlaceholder="Search projects..." />
            </Toolbar>

        <ChildContent>
            @if (projectsLoad.IsLoading)
            {
                <div class="projects-loading" role="status" aria-live="polite">
                    <span class="spinner-border spinner-border-sm text-primary"
                          aria-hidden="true"></span>
                    <span>Loading your projects...</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(projectsLoad.Error))
            {
                <div class="projects-error" role="alert">
                    <span>@projectsLoad.Error</span>

                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="() => LoadProjectsAsync(page)">
                        Try again
                    </button>
                </div>
            }
            else if (projectPage is { Items.Count: 0 })
            {
                <EmptyState Title="@(string.IsNullOrWhiteSpace(search)
                    ? "No projects available"
                    : "No projects match your search")"
                            Message="@(string.IsNullOrWhiteSpace(search)
                    ? "Projects you can access will appear here."
                    : "Try changing your search.")" />
            }
            else if (projectPage is not null)
            {
                <section class="employee-project-grid"
                         aria-label="Projects you can access">

                    @foreach (var project in projectPage.Items)
                    {
                        <article class="employee-project-card"
                                 @key="project.ProjectId">

                            <div class="employee-project-card-header">
                                <div class="employee-project-icon"
                                     aria-hidden="true">
                                    <i class="bi bi-kanban"></i>
                                </div>

                                <span class="employee-project-status employee-project-status-@GetStatusClass(project.Status)">
                                    @GetStatusLabel(project.Status)
                                </span>
                            </div>

                            <h2>@project.Name</h2>

                            <p class="employee-project-description">
                                @(string.IsNullOrWhiteSpace(project.Description)
                                    ? "No description provided."
                                    : project.Description)
                            </p>

                            <div class="employee-project-workspace">
                                <i class="bi bi-grid" aria-hidden="true"></i>
                                <span>@project.WorkspaceName</span>
                            </div>

                            <button type="button"
                                    class="btn btn-outline-primary employee-project-open"
                                    aria-expanded="@(selectedProjectId == project.ProjectId)"
                                    @onclick="() => OpenProjectDetailsAsync(project)">
                                @(selectedProjectId == project.ProjectId
                                    ? "Close details"
                                    : "View details and boards")

                                <i class="bi bi-arrow-right ms-1"
                                   aria-hidden="true"></i>
                            </button>
                        </article>
                    }
                </section>

                <Pagination CurrentPage="page"
                            TotalPages="projectPage.TotalPages"
                            TotalCount="projectPage.TotalCount"
                            PageSize="@projectPage.PageSize"
                            PageChanged="LoadProjectsAsync" />
            }
        </ChildContent>
    </DataListPanel>

    @if (selectedProject is not null)
    {
        <section class="employee-project-details"
                 aria-labelledby="employee-project-details-title">

            <div class="employee-project-details-header">
                <div>
                    <p class="section-label mb-1">Project details</p>
                    <h2 id="employee-project-details-title">
                        @selectedProject.Name
                    </h2>
                </div>

                <button type="button"
                        class="btn-close"
                        aria-label="Close project details"
                        @onclick="CloseProjectDetails">
                </button>
            </div>

            @if (projectDetailsLoad.IsLoading)
            {
                <div class="projects-loading" role="status">
                    <span class="spinner-border spinner-border-sm text-primary"
                          aria-hidden="true"></span>
                    <span>Loading project details...</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(projectDetailsLoad.Error))
            {
                <div class="projects-error" role="alert">
                    <span>@projectDetailsLoad.Error</span>

                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="() => OpenProjectDetailsAsync(selectedProject, forceRefresh: true)">
                        Try again
                    </button>
                </div>
            }
            else
            {
                <p class="employee-project-details-description">
                    @(string.IsNullOrWhiteSpace(selectedProject.Description)
                        ? "No description provided."
                        : selectedProject.Description)
                </p>

                <dl class="employee-project-facts">
                    <div>
                        <dt>Workspace</dt>
                        <dd>@selectedProject.WorkspaceName</dd>
                    </div>

                    <div>
                        <dt>Status</dt>
                        <dd>@GetStatusLabel(selectedProject.Status)</dd>
                    </div>

                    <div>
                        <dt>Schedule</dt>
                        <dd>
                            @selectedProject.StartDate.ToString("MMM d, yyyy")
                            –
                            @selectedProject.EndDate.ToString("MMM d, yyyy")
                        </dd>
                    </div>
                </dl>

                <section class="employee-project-boards"
                         aria-labelledby="employee-project-boards-title">

                    <div class="employee-project-boards-heading">
                        <div>
                            <h3 id="employee-project-boards-title">
                                Accessible project boards
                            </h3>

                            @if (projectBoards is not null)
                            {
                                <span>
                                    @projectBoards.Count
                                    @(projectBoards.Count == 1 ? "board" : "boards")
                                </span>
                            }
                        </div>
                    </div>

                    @if (projectBoardsLoad.IsLoading)
                    {
                        <div class="projects-loading" role="status">
                            <span class="spinner-border spinner-border-sm text-primary"
                                  aria-hidden="true"></span>
                            <span>Loading accessible boards...</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(projectBoardsLoad.Error))
                    {
                        <div class="projects-error" role="alert">
                            <span>@projectBoardsLoad.Error</span>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="RetryProjectBoardsAsync">
                                Try again
                            </button>
                        </div>
                    }
                    else if (projectBoards is { Count: 0 })
                    {
                        <EmptyState Title="No accessible project boards"
                                    Message="You may not have board access to every board associated with this project." />
                    }
                    else if (projectBoards is not null)
                    {
                        <div class="employee-project-board-list">
                            @foreach (var board in projectBoards)
                            {
                                <article class="employee-project-board-row"
                                         @key="board.Id">

                                    <div class="employee-project-board-copy">
                                        <strong>@board.Name</strong>

                                        <span>
                                            @(board.Purpose == BoardPurpose.GeneralLearning
                                                ? "General / Learning"
                                                : "Project")
                                        </span>
                                    </div>

                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@($"/workspaces/{board.WorkspaceId}/boards/{board.Id}")"
                                       aria-label="@($"Open board {board.Name}")">
                                        Open board

                                        <i class="bi bi-arrow-up-right ms-1"
                                           aria-hidden="true"></i>
                                    </a>
                                </article>
                            }
                        </div>
                    }
                </section>
            }
        </section>
    }
</div>

@code {
    private const int ProjectPageSize = PageSizeDefaults.Default;
    private const int BoardPageSize = PageSizeDefaults.Resource;

    [Parameter]
    [SupplyParameterFromQuery(Name = "workspaceId")]
    public Guid? WorkspaceId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectId { get; set; }

    private readonly AsyncOperationState projectsLoad = new();
    private readonly AsyncOperationState projectDetailsLoad = new();
    private readonly AsyncOperationState projectBoardsLoad = new();

    private readonly DebouncedAction searchDebounce = new();

    private PagedResponse<ProjectResponse>? projectPage;
    private ProjectResponse? selectedProject;
    private List<BoardResponse>? projectBoards;

    private string? search;

    private int page = 1;
    private Guid? selectedProjectId;

    private long projectsRequestVersion;
    private long detailsRequestVersion;

    private CancellationTokenSource? activeProjectsCts;
    private CancellationTokenSource? activeDetailsCts;

    private bool hasLoadedProjectFilters;
    private Guid? lastWorkspaceFilter;
    private Guid? lastProjectFilter;

    protected override async Task OnParametersSetAsync()
    {
        if (!hasLoadedProjectFilters ||
            lastWorkspaceFilter != WorkspaceId ||
            lastProjectFilter != ProjectId)
        {
            hasLoadedProjectFilters = true;
            lastWorkspaceFilter = WorkspaceId;
            lastProjectFilter = ProjectId;

            await LoadProjectsAsync(1);

            var requestedProject = projectPage?.Items
                .FirstOrDefault(project => project.ProjectId == ProjectId);

            if (requestedProject is not null)
            {
                await OpenProjectDetailsAsync(requestedProject);
            }
        }
    }


    private Task HandleProjectSearchChanged(string? value)
    {
        search = value?.Trim();

        return searchDebounce.ExecuteAsync(
            () => LoadProjectsAsync(1));
    }

    private async Task LoadProjectsAsync(int requestedPage)
    {
        page = requestedPage;

        projectsLoad.Error = null;

        activeProjectsCts?.Cancel();
        activeProjectsCts?.Dispose();

        var requestVersion = ++projectsRequestVersion;
        var loadCts = activeProjectsCts = new CancellationTokenSource();

        projectsLoad.IsLoading = true;

        try
        {
            var result = await ProjectApiService.GetMineAsync(
                new ProjectQueryRequest
                {
                    Page = requestedPage,
                    PageSize = ProjectPageSize,
                    Search = search?.Trim(),
                    WorkspaceId = WorkspaceId
                },
                loadCts.Token);

            if (requestVersion != projectsRequestVersion)
            {
                return;
            }

            if (result is null)
            {
                projectPage = null;
                projectsLoad.Error =
                    "Unable to load your projects. Please try again.";

                return;
            }

            projectPage = result;

            if (selectedProjectId.HasValue &&
                !result.Items.Any(project =>
                    project.ProjectId == selectedProjectId.Value))
            {
                CloseProjectDetails();
            }
        }
        catch (OperationCanceledException) when (loadCts.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            if (requestVersion == projectsRequestVersion)
            {
                projectPage = null;
                projectsLoad.Error =
                    "The project service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == projectsRequestVersion)
            {
                projectPage = null;
                projectsLoad.Error =
                    "The project service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == projectsRequestVersion)
            {
                projectsLoad.IsLoading = false;
            }
        }
    }

    private async Task OpenProjectDetailsAsync(
        ProjectResponse project,
        bool forceRefresh = false)
    {
        if (!forceRefresh &&
            selectedProjectId == project.ProjectId &&
            selectedProject is not null)
        {
            CloseProjectDetails();
            return;
        }

        activeDetailsCts?.Cancel();
        activeDetailsCts?.Dispose();

        var loadCts = activeDetailsCts = new CancellationTokenSource();
        var requestVersion = ++detailsRequestVersion;

        selectedProjectId = project.ProjectId;
        selectedProject = project;

        projectBoards = null;

        projectDetailsLoad.Error = null;
        projectBoardsLoad.Error = null;

        projectDetailsLoad.IsLoading = true;
        projectBoardsLoad.IsLoading = false;

        try
        {
            var fullProject = await ProjectApiService.GetByIdAsync(
                project.ProjectId,
                loadCts.Token);

            if (requestVersion != detailsRequestVersion)
            {
                return;
            }

            if (fullProject is null)
            {
                projectDetailsLoad.Error =
                    "Project details could not be loaded. Confirm your access and retry.";

                return;
            }

            selectedProject = fullProject;

            await LoadProjectBoardsAsync(
                requestVersion,
                fullProject,
                loadCts.Token);
        }
        catch (OperationCanceledException) when (loadCts.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectDetailsLoad.Error =
                    "The project service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectDetailsLoad.Error =
                    "The project service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectDetailsLoad.IsLoading = false;
            }
        }
    }

    private async Task LoadProjectBoardsAsync(
        long requestVersion,
        ProjectResponse project,
        CancellationToken cancellationToken)
    {
        projectBoardsLoad.IsLoading = true;
        projectBoardsLoad.Error = null;

        try
        {
            var firstPage = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    WorkspaceId = project.WorkspaceId,
                    Page = 1,
                    PageSize = BoardPageSize
                },
                cancellationToken);

            if (requestVersion != detailsRequestVersion)
            {
                return;
            }

            if (firstPage is null)
            {
                projectBoards = null;
                projectBoardsLoad.Error =
                    "Accessible project boards could not be loaded.";

                return;
            }

            var accessibleBoards = firstPage.Items.ToList();

            for (var requestedPage = 2;
                 requestedPage <= firstPage.TotalPages;
                 requestedPage++)
            {
                var nextPage = await BoardApiService.GetAsync(
                    new BoardQueryRequest
                    {
                        WorkspaceId = project.WorkspaceId,
                        Page = requestedPage,
                        PageSize = BoardPageSize
                    },
                    cancellationToken);

                if (requestVersion != detailsRequestVersion)
                {
                    return;
                }

                if (nextPage is null)
                {
                    projectBoards = null;
                    projectBoardsLoad.Error =
                        "Accessible boards could not be fully loaded. Partial results are withheld.";

                    return;
                }

                accessibleBoards.AddRange(nextPage.Items);
            }

            projectBoards = accessibleBoards
                .Where(board =>
                    board.ProjectId == project.ProjectId &&
                    board.WorkspaceId == project.WorkspaceId)
                .OrderBy(board => board.Name)
                .ToList();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectBoards = null;
                projectBoardsLoad.Error =
                    "The board service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectBoards = null;
                projectBoardsLoad.Error =
                    "The board service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == detailsRequestVersion)
            {
                projectBoardsLoad.IsLoading = false;
            }
        }
    }

    private Task RetryProjectBoardsAsync()
    {
        return selectedProject is null || activeDetailsCts is null
            ? Task.CompletedTask
            : LoadProjectBoardsAsync(
                detailsRequestVersion,
                selectedProject,
                activeDetailsCts.Token);
    }

    private void CloseProjectDetails()
    {
        detailsRequestVersion++;

        activeDetailsCts?.Cancel();
        activeDetailsCts?.Dispose();
        activeDetailsCts = null;

        selectedProjectId = null;
        selectedProject = null;
        projectBoards = null;

        projectDetailsLoad.Error = null;
        projectBoardsLoad.Error = null;

        projectDetailsLoad.IsLoading = false;
        projectBoardsLoad.IsLoading = false;
    }

    private static string GetStatusLabel(ProjectStatus status) =>
        status switch
        {
            ProjectStatus.Active => "Active",
            ProjectStatus.Completed => "Completed",
            ProjectStatus.OnHold => "On hold",
            _ => status.ToString()
        };

    private static string GetStatusClass(ProjectStatus status) =>
        status switch
        {
            ProjectStatus.Active => "active",
            ProjectStatus.Completed => "completed",
            ProjectStatus.OnHold => "on-hold",
            _ => "unknown"
        };

    public void Dispose()
    {
        searchDebounce.Cancel();
        searchDebounce.Dispose();

        activeProjectsCts?.Cancel();
        activeProjectsCts?.Dispose();

        activeDetailsCts?.Cancel();
        activeDetailsCts?.Dispose();
    }
}
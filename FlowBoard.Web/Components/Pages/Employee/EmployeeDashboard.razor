@page "/employee/dashboard"

@attribute [Authorize(Policy = AuthorizationPolicies.EmployeeOnly)]

@inject ITaskApiService TaskApiService
@inject IBoardApiService BoardApiService
@inject IProjectApiService ProjectApiService
@inject IWorkspaceApiService WorkspaceApiService

<PageTitle>Employee Dashboard | FlowBoard</PageTitle>

<div class="page-shell employee-dashboard">

    <PageHeader Title="Dashboard"
                Eyebrow="Your workspace"
                Description="A focused view of your assigned tasks, upcoming deadlines, and accessible work." />

    @if (dashboardLoad.IsLoading)
    {
        <div class="employee-dashboard-loading" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm text-primary"
                  aria-hidden="true"></span>
            <span>Loading your work overview…</span>
        </div>
    }

    @* Dashboard statistics *@

    <section class="employee-stat-grid" aria-label="Your work statistics">

        <DashboardStatCard Label="Assigned tasks"
                           Icon="bi-check2-square"
                           IconTone="stat-tone-indigo"
                           Value="@(taskSummary?.TotalCount ?? 0)"
                           IsLoading="@dashboardLoad.IsLoading"
                           IsUnavailable="@(taskSummary is null)"
                           UnavailableReason="@taskSummaryLoad.Error" />

        <DashboardStatCard Label="Due next 7 days"
                           Icon="bi-calendar2-week"
                           IconTone="stat-tone-amber"
                           Value="@(upcomingTasks?.TotalCount ?? 0)"
                           IsLoading="@dashboardLoad.IsLoading"
                           IsUnavailable="@(upcomingTasks is null)"
                           UnavailableReason="@upcomingTasksLoad.Error" />

        <DashboardStatCard Label="Accessible boards"
                           Icon="bi-columns-gap"
                           IconTone="stat-tone-blue"
                           Value="@(boards?.TotalCount ?? 0)"
                           IsLoading="@dashboardLoad.IsLoading"
                           IsUnavailable="@(boards is null)"
                           UnavailableReason="@boardsLoad.Error" />

        <DashboardStatCard Label="My projects"
                           Icon="bi-kanban"
                           IconTone="stat-tone-violet"
                           Value="@(projects?.TotalCount ?? 0)"
                           IsLoading="@dashboardLoad.IsLoading"
                           IsUnavailable="@(projects is null)"
                           UnavailableReason="@projectsLoad.Error" />

        <DashboardStatCard Label="My workspaces"
                           Icon="bi-grid"
                           IconTone="stat-tone-green"
                           Value="@(workspaces?.TotalCount ?? 0)"
                           IsLoading="@dashboardLoad.IsLoading"
                           IsUnavailable="@(workspaces is null)"
                           UnavailableReason="@workspacesLoad.Error" />

    </section>

    @* Upcoming tasks *@

    <DataListPanel Title="Upcoming task deadlines"
                   TitleId="upcoming-tasks-title"
                   Description="Stay ahead of your upcoming deadlines."
                   CountText="@(upcomingTasks is not null &&
                                !dashboardLoad.IsLoading &&
                                upcomingTasksLoad.Error is null
                       ? $"{upcomingTasks.TotalCount} {(upcomingTasks.TotalCount == 1 ? "task" : "tasks")}"
                       : null)"
                   CssClass="employee-dashboard-panel">

        <ChildContent>

            @if (dashboardLoad.IsLoading)
            {
                <div class="employee-inline-loading" role="status">

                    <span class="spinner-border spinner-border-sm text-primary"
                          aria-hidden="true"></span>

                    <span>Loading upcoming tasks…</span>

                </div>
            }
            else if (!string.IsNullOrWhiteSpace(upcomingTasksLoad.Error))
            {
                <div class="employee-dashboard-error" role="alert">
                    @upcomingTasksLoad.Error
                </div>
            }
            else if (upcomingTasks is { Items.Count: 0 })
            {
                <EmptyState Title="No upcoming deadlines"
                            Message="You have no assigned tasks due in the next 7 days." />
            }
            else if (upcomingTasks is not null)
            {
                <div class="employee-task-list">

                    @foreach (var task in upcomingTasks.Items)
                    {
                        <article class="employee-task-row"
                                 @key="task.CardId">

                            <div class="employee-task-copy">

                                <h3>@task.Title</h3>

                                <p>
                                    @task.ColumnName · @task.BoardName
                                </p>

                                <small>
                                    @task.WorkspaceName

                                    @if (!string.IsNullOrWhiteSpace(task.ProjectName))
                                    {
                                        <span> · @task.ProjectName</span>
                                    }
                                </small>

                            </div>

                            <div class="employee-task-meta">

                                <span class="employee-priority employee-priority-@GetPriorityClass(task.Priority)">
                                    @GetPriorityLabel(task.Priority)
                                </span>

                                <time datetime="@task.DueDate?.ToString("O")">
                                    @task.DueDate?.ToLocalTime().ToString("MMM d")
                                </time>

                            </div>

                        </article>
                    }

                </div>
            }

            <p class="employee-dashboard-note">
                Completion totals are omitted because the task API does not expose a reliable completed-status field.
                The deadline list includes your assigned tasks with dates in this window.
            </p>

        </ChildContent>

    </DataListPanel>

</div>

@code {
    private PagedResponse<MyTaskResponse>? taskSummary;
    private PagedResponse<MyTaskResponse>? upcomingTasks;
    private PagedResponse<BoardResponse>? boards;
    private PagedResponse<ProjectResponse>? projects;
    private PagedResponse<WorkspaceResponse>? workspaces;

    private readonly AsyncOperationState dashboardLoad = new();

    private readonly AsyncOperationState taskSummaryLoad = new();
    private readonly AsyncOperationState upcomingTasksLoad = new();
    private readonly AsyncOperationState boardsLoad = new();
    private readonly AsyncOperationState projectsLoad = new();
    private readonly AsyncOperationState workspacesLoad = new();

    protected override async Task OnInitializedAsync()
    {
        dashboardLoad.IsLoading = true;

        try
        {
            await Task.WhenAll(
                LoadTaskSummaryAsync(),
                LoadUpcomingTasksAsync(),
                LoadBoardsAsync(),
                LoadProjectsAsync(),
                LoadWorkspacesAsync());
        }
        finally
        {
            dashboardLoad.IsLoading = false;
        }
    }

    private async Task LoadTaskSummaryAsync()
    {
        taskSummaryLoad.IsLoading = true;
        taskSummaryLoad.Error = null;

        try
        {
            taskSummary = await TaskApiService.GetMyTasksAsync(
                new MyTasksQueryRequest
                {
                    Page = 1,
                    PageSize = 1
                });

            if (taskSummary is null)
            {
                taskSummaryLoad.Error = "Assigned task totals are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            taskSummaryLoad.Error = "The task service could not be reached.";
        }
        catch (JsonException)
        {
            taskSummaryLoad.Error = "The task service returned an invalid response.";
        }
        finally
        {
            taskSummaryLoad.IsLoading = false;
        }
    }

    private async Task LoadUpcomingTasksAsync()
    {
        upcomingTasksLoad.IsLoading = true;
        upcomingTasksLoad.Error = null;

        try
        {
            var today = DateTime.UtcNow.Date;

            upcomingTasks = await TaskApiService.GetMyTasksAsync(
                new MyTasksQueryRequest
                {
                    Page = 1,
                    PageSize = 5,
                    DueDateFrom = today,
                    DueDateTo = today.AddDays(7)
                });

            if (upcomingTasks is null)
            {
                upcomingTasksLoad.Error = "Upcoming task deadlines are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            upcomingTasksLoad.Error = "The task service could not be reached.";
        }
        catch (JsonException)
        {
            upcomingTasksLoad.Error = "The task service returned an invalid response.";
        }
        finally
        {
            upcomingTasksLoad.IsLoading = false;
        }
    }

    private async Task LoadBoardsAsync()
    {
        boardsLoad.IsLoading = true;
        boardsLoad.Error = null;

        try
        {
            boards = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    Page = 1,
                    PageSize = 1
                });

            if (boards is null)
            {
                boardsLoad.Error = "Accessible board totals are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            boardsLoad.Error = "The board service could not be reached.";
        }
        catch (JsonException)
        {
            boardsLoad.Error = "The board service returned an invalid response.";
        }
        finally
        {
            boardsLoad.IsLoading = false;
        }
    }

    private async Task LoadProjectsAsync()
    {
        projectsLoad.IsLoading = true;
        projectsLoad.Error = null;

        try
        {
            projects = await ProjectApiService.GetMineAsync(
                new ProjectQueryRequest
                {
                    Page = 1,
                    PageSize = 1
                });

            if (projects is null)
            {
                projectsLoad.Error = "Your project totals are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            projectsLoad.Error = "The project service could not be reached.";
        }
        catch (JsonException)
        {
            projectsLoad.Error = "The project service returned an invalid response.";
        }
        finally
        {
            projectsLoad.IsLoading = false;
        }
    }

    private async Task LoadWorkspacesAsync()
    {
        workspacesLoad.IsLoading = true;
        workspacesLoad.Error = null;

        try
        {
            workspaces = await WorkspaceApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = 1,
                    PageSize = 1
                });

            if (workspaces is null)
            {
                workspacesLoad.Error = "Your workspace totals are unavailable.";
            }
        }
        catch (HttpRequestException)
        {
            workspacesLoad.Error = "The workspace service could not be reached.";
        }
        catch (JsonException)
        {
            workspacesLoad.Error = "The workspace service returned an invalid response.";
        }
        finally
        {
            workspacesLoad.IsLoading = false;
        }
    }

    private static string GetPriorityLabel(CardPriority priority) =>
        priority switch
        {
            CardPriority.Low => "Low",
            CardPriority.Medium => "Medium",
            CardPriority.High => "High",
            CardPriority.Critical => "Critical",
            _ => priority.ToString()
        };

    private static string GetPriorityClass(CardPriority priority) =>
        priority switch
        {
            CardPriority.Low => "low",
            CardPriority.Medium => "medium",
            CardPriority.High => "high",
            CardPriority.Critical => "critical",
            _ => "unknown"
        };
}
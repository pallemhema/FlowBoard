@page "/employee/boards"

@attribute [Authorize(Policy = AuthorizationPolicies.EmployeeOnly)]
@implements IDisposable

@inject IBoardApiService BoardApiService

<PageTitle>My Boards | FlowBoard</PageTitle>

<div class="page-shell employee-boards">

    <PageHeader Title="My boards"
                Eyebrow="Your work"
                Description="Boards you are authorized to access, with their columns and cards." />

    <DataListPanel Title="My boards"
                   TitleId="employee-boards-title"
                   Description="Browse and search boards you can access."
                   CountText="@(boardPage is not null &&
                                !boardsLoad.IsLoading &&
                                boardsLoad.Error is null
                       ? $"{boardPage.TotalCount} {(boardPage.TotalCount == 1 ? "board" : "boards")}"
                       : null)"
                   CssClass="employee-boards-panel">

        <Toolbar>
                <DataListToolBar SearchValue="@search"
                         SearchValueChanged="SearchChangedAsync"
                         SearchPlaceholder="Search boards..." />
        </Toolbar>

        <ChildContent>

            @if (boardsLoad.IsLoading)
            {
                <div class="boards-loading" role="status" aria-live="polite">
                    <span class="spinner-border spinner-border-sm text-primary"
                          aria-hidden="true"></span>
                    <span>Loading your boards...</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(boardsLoad.Error))
            {
                <div class="boards-error" role="alert">

                    <span>@boardsLoad.Error</span>

                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="() => LoadBoardsAsync(page)">
                        Try again
                    </button>

                </div>
            }
            else if (boardPage is { Items.Count: 0 })
            {
                <EmptyState Title="@(string.IsNullOrWhiteSpace(search)
                                      ? "No boards available"
                                      : "No boards match your search")"
                            Message="@(string.IsNullOrWhiteSpace(search)
                                        ? "Boards you can access will appear here."
                                        : "Try changing your search.")" />
            }
            else if (boardPage is not null)
            {
                <section class="employee-board-grid"
                         aria-label="Boards you can access">

                    @foreach (var board in boardPage.Items)
                    {
                        <article class="employee-board-card"
                                 @key="board.Id">

                            <div class="employee-board-card-header">

                                <div class="employee-board-icon"
                                     aria-hidden="true">
                                    <i class="bi bi-columns-gap"></i>
                                </div>

                                <span class="employee-board-purpose">
                                    @GetPurposeLabel(board.Purpose)
                                </span>

                            </div>

                            <h2>@board.Name</h2>

                            <p class="employee-board-description">
                                @(string.IsNullOrWhiteSpace(board.Description)
                                    ? "No description provided."
                                    : board.Description)
                            </p>

                            <dl class="employee-board-details">

                                <div>
                                    <dt>Workspace</dt>
                                    <dd>@board.WorkspaceName</dd>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(board.ProjectName))
                                {
                                    <div>
                                        <dt>Project</dt>
                                        <dd>@board.ProjectName</dd>
                                    </div>
                                }

                                <div>
                                    <dt>Your board role</dt>
                                    <dd>@GetBoardRoleLabel(board)</dd>
                                </div>

                            </dl>

                            <a class="btn btn-outline-primary employee-board-open"
                               href="@($"/workspaces/{board.WorkspaceId}/boards/{board.Id}")"
                               aria-label="@($"Open board {board.Name}")">

                                Open board

                                <i class="bi bi-arrow-right ms-1"
                                   aria-hidden="true"></i>

                            </a>

                        </article>
                    }

                </section>

                <Pagination CurrentPage="@boardPage.Page"
                            TotalPages="@boardPage.TotalPages"
                            TotalCount="@boardPage.TotalCount"
                            PageSize="@boardPage.PageSize"
                            PageChanged="LoadBoardsAsync" />
            }

        </ChildContent>

    </DataListPanel>

</div>

@code {
    private const int PageSize = PageSizeDefaults.Default;

    private PagedResponse<BoardResponse>? boardPage;

    private readonly AsyncOperationState boardsLoad = new();

    private readonly DebouncedAction searchDebounce = new();

    private string? search;

    private int page = 1;

    private long loadVersion;

    private CancellationTokenSource? activeLoadCts;

    protected override Task OnInitializedAsync() =>
        LoadBoardsAsync(1);
    private Task SearchChangedAsync(string? value)
    {
        search = value?.Trim();

        return searchDebounce.ExecuteAsync(
            () => LoadBoardsAsync(1));
    }

    private async Task LoadBoardsAsync(int requestedPage)
    {
        page = requestedPage;

        boardsLoad.Error = null;

        activeLoadCts?.Cancel();
        activeLoadCts?.Dispose();
        activeLoadCts = null;

        var requestVersion = ++loadVersion;

        var loadCts = activeLoadCts = new CancellationTokenSource();

        boardsLoad.IsLoading = true;

        try
        {
            var result = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    Page = requestedPage,
                    PageSize = PageSize,
                    Search = search?.Trim()
                },
                loadCts.Token);

            if (requestVersion != loadVersion)
            {
                return;
            }

            if (result is null)
            {
                boardPage = null;
                boardsLoad.Error = "Unable to load your boards. Please try again.";
                return;
            }

            boardPage = result;
        }
        catch (OperationCanceledException) when (loadCts.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            if (requestVersion == loadVersion)
            {
                boardPage = null;
                boardsLoad.Error = "The board service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == loadVersion)
            {
                boardPage = null;
                boardsLoad.Error = "The board service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == loadVersion)
            {
                boardsLoad.IsLoading = false;
            }
        }
    }

    private static string GetPurposeLabel(BoardPurpose purpose) =>
        purpose == BoardPurpose.GeneralLearning
            ? "General / Learning"
            : "Project";

    private static string GetBoardRoleLabel(BoardResponse board) =>
        board.CurrentUserRole?.ToString() ??
        "Workspace access";

    public void Dispose()
    {
        searchDebounce.Cancel();
        searchDebounce.Dispose();

        activeLoadCts?.Cancel();
        activeLoadCts?.Dispose();
    }
}
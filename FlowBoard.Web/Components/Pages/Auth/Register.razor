@page "/register"

@rendermode InteractiveServer

@using FlowBoard.Shared.DTOs.Auth
@using FlowBoard.Web.Services.Authentication

@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<div class="auth-shell">
    <section class="auth-panel">
        <span class="brand-mark auth-brand-mark"><i class="bi bi-kanban-fill" aria-hidden="true"></i></span>
        <p class="section-label mt-4 mb-2">Get started</p>
        <h1 class="page-title mb-2">Create your account</h1>
        <p class="page-subtitle mb-4">Set up your profile to start organizing work.</p>

    <EditForm Model="@registerRequest"
              OnValidSubmit="@RegisterAsync"
              FormName="Register">

        <DataAnnotationsValidator />

        <div class="mb-3">

            <label class="form-label" for="register-first-name">First name</label>

            <InputText id="register-first-name" @bind-Value="registerRequest.FirstName"
                       class="form-control"
                       placeholder="Enter your first name" />

            <ValidationMessage
                For="@(() => registerRequest.FirstName)" />

        </div>

        <div class="mb-3">

            <label class="form-label" for="register-last-name">Last name</label>

            <InputText id="register-last-name" @bind-Value="registerRequest.LastName"
                       class="form-control"
                       placeholder="Enter your last name" />

            <ValidationMessage
                For="@(() => registerRequest.LastName)" />

        </div>

        <div class="mb-3">

            <label class="form-label" for="register-email">Email</label>

            <InputText id="register-email" @bind-Value="registerRequest.Email"
                       class="form-control"
                       placeholder="Enter your email" />

            <ValidationMessage
                For="@(() => registerRequest.Email)" />

        </div>

        <div class="mb-4">

            <label class="form-label" for="register-password">Password</label>

            <InputText id="register-password" @bind-Value="registerRequest.Password"
                       type="password"
                       class="form-control"
                       placeholder="Enter your password" />

            <ValidationMessage
                For="@(() => registerRequest.Password)" />

        </div>

        <button type="submit"
                class="btn btn-primary w-100"
                disabled="@isSubmitting">

            @(isSubmitting
                ? "Creating account..."
                : "Register")

        </button>

        </EditForm>
        <p class="text-muted text-center small mt-4 mb-0">
            Already have an account? <NavLink href="/login">Log in</NavLink>
        </p>
    </section>
</div>

@code {

    private readonly RegisterRequest registerRequest = new();

    private bool isSubmitting;

    private async Task RegisterAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;

        try
        {
            var success =
                await AuthenticationService.RegisterAsync(
                    registerRequest);

            if (!success)
            {
                return;
            }

            Navigation.NavigateTo("/");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

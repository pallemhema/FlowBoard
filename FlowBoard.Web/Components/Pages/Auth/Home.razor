@page "/"

<PageTitle>FlowBoard</PageTitle>

<div class="page-shell">
    <section class="home-hero">
        <div class="home-hero-copy">
            <p class="section-label mb-3">Work, made visible</p>
            <h1 class="home-title">Bring your projects<br />into focus.</h1>
            <p class="home-description">
                Plan work with your team, keep every task moving, and see progress clearly from the first idea to done.
            </p>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="btn btn-primary btn-lg" href="/workspaces">
                        Go to workspaces <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                    </NavLink>
                </Authorized>
                <NotAuthorized>
                    <div class="d-flex flex-wrap gap-2">
                        <NavLink class="btn btn-primary btn-lg" href="/register">Get started</NavLink>
                        <NavLink class="btn btn-outline-secondary btn-lg" href="/login">Log in</NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <div class="home-hero-art" aria-hidden="true">
            <div class="hero-board">
                <div class="hero-board-title"><span></span><span></span><span></span></div>
                <div class="hero-columns">
                    <div class="hero-column"><i></i><i></i><i></i></div>
                    <div class="hero-column"><i></i><i></i></div>
                    <div class="hero-column"><i></i><i></i><i></i></div>
                </div>
            </div>
            <span class="hero-orbit hero-orbit-one"></span>
            <span class="hero-orbit hero-orbit-two"></span>
        </div>
    </section>
</div>

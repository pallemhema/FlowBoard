@page "/login"

@using FlowBoard.Shared.DTOs.Auth
@using FlowBoard.Web.Navigation
@using FlowBoard.Web.Services.Authentication

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="auth-shell">
    <section class="auth-panel">
        <span class="brand-mark auth-brand-mark"><i class="bi bi-kanban-fill" aria-hidden="true"></i></span>
        <p class="section-label mt-4 mb-2">Welcome back</p>
        <h1 class="page-title mb-2">Log in to FlowBoard</h1>
        <p class="page-subtitle mb-4">Pick up where your team left off.</p>

    <EditForm Model="@model"
              OnValidSubmit="@LoginAsync"
              FormName="Login">

        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label" for="login-email">Email</label>

            <InputText id="login-email" @bind-Value="model.Email"
                       class="form-control" />

            <ValidationMessage For="@(() => model.Email)" />
        </div>

        <div class="mb-4">
            <label class="form-label" for="login-password">Password</label>

            <InputText id="login-password" @bind-Value="model.Password"
                       type="password"
                       class="form-control" />

            <ValidationMessage For="@(() => model.Password)" />
        </div>

        <button class="btn btn-primary w-100"
                type="submit"
                disabled="@isSubmitting">

            @(isSubmitting ? "Logging in..." : "Log in")

        </button>

        </EditForm>
        <p class="text-muted text-center small mt-4 mb-0">
            Invitations are issued by your FlowBoard administrator.
        </p>
    </section>
</div>

@code {

    private readonly LoginRequest model = new();

    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        Navigation.NavigateTo(
            AppNavigation.DashboardHrefForPolicies(
                await AppNavigation.GetAuthorizedPoliciesAsync(
                    user,
                    AuthorizationService)),
            replace: true);
    }

    private async Task LoginAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;

        try
        {
            var success =
                await AuthenticationService.LoginAsync(model);

            if (!success)
            {
                return;
            }

            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            Navigation.NavigateTo(
                AppNavigation.DashboardHrefForPolicies(
                    await AppNavigation.GetAuthorizedPoliciesAsync(
                        authenticationState.User,
                        AuthorizationService)));
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

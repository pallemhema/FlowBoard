@page "/workspaces/{Id:guid}"

@using FlowBoard.Shared.DTOs.Workspaces

@inject IWorkspaceApiService WorkspaceApiService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Workspace</PageTitle>

<div class="page-shell">

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading workspace...</p>
        </div>
    }
    else if (workspace is null)
    {
        <EmptyState
            Title="Workspace not found"
            Message="The workspace could not be found." />

        <div class="mt-3">
            <button type="button"
                    class="btn btn-secondary"
                    @onclick="GoBack">
                Back to Workspaces
            </button>
        </div>
    }
    else
    {
        <!-- Workspace Header -->

        <header class="mb-4">
            <Breadcrumbs>
                <li class="breadcrumb-item">
                    <NavLink href="/workspaces">Workspaces</NavLink>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    @workspace.Name
                </li>
            </Breadcrumbs>

            <div class="page-header mb-0">

                <div>
                    <p class="section-label mb-2">Workspace</p>
                    <h1 class="page-title">
                        @workspace.Name
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(workspace.Description))
                    {
                        <p class="page-subtitle">
                            @workspace.Description
                        </p>
                    }
                </div>

                <div class="d-flex gap-2 flex-shrink-0">
                    <button type="button" class="btn btn-outline-secondary" @onclick="EditWorkspace">
                        <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
                    </button>
                    <button type="button" class="btn btn-outline-danger" disabled="@isDeleting" @onclick="HandleDelete">
                        <i class="bi bi-trash me-1" aria-hidden="true"></i>
                        @(isDeleting ? "Deleting..." : "Delete")
                    </button>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="alert alert-danger mt-3" role="alert">@deleteError</div>
        }

        <section class="detail-panel mb-5" aria-label="Workspace information">
            <div class="row g-2">
                <div class="col-sm-4">
                    <div class="detail-metric">
                        <span class="detail-metric-label">Created</span>
                        <span>@workspace.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                    </div>
                </div>
                <div class="col-sm-8">
                    <div class="detail-metric">
                        <span class="detail-metric-label">Description</span>
                        <span>@(string.IsNullOrWhiteSpace(workspace.Description) ? "No description provided." : workspace.Description)</span>
                    </div>
                </div>
            </div>
        </section>

        <Boards WorkspaceId="@Id" />
    }

</div>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private WorkspaceResponse? workspace;

    private bool isLoading;

    private bool isDeleting;

    private string? deleteError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        isLoading = true;

        try
        {
            workspace =
                await WorkspaceApiService.GetByIdAsync(Id);

            if (workspace is null)
            {
                return;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/workspaces");
    }

    private void EditWorkspace()
    {
        Navigation.NavigateTo($"/workspaces/{Id}/edit");
    }

    private async Task HandleDelete()
    {
        if (workspace is null || isDeleting)
        {
            return;
        }

        deleteError = null;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete the workspace '{workspace.Name}'?");

        if (!confirmed)
        {
            return;
        }

        isDeleting = true;

        try
        {
            var deleted =
                await WorkspaceApiService.DeleteAsync(workspace.Id);

            if (deleted)
            {
                Navigation.NavigateTo("/workspaces");
            }
            else
            {
                deleteError =
                    "The workspace could not be deleted. Please try again.";
            }
        }
        catch
        {
            deleteError =
                "An error occurred while deleting the workspace. Please try again.";
        }
        finally
        {
            isDeleting = false;
        }
    }
}

@page "/workspaces/create"
@page "/manager/workspaces/create"
@attribute [Authorize(Policy = AuthorizationPolicies.AdminOrManager)]

@using FlowBoard.Shared.DTOs.Workspaces
@using FlowBoard.Web.Models.Workspaces
@using System.Text.Json

@inject IWorkspaceApiService WorkspaceApiService
@inject NavigationManager Navigation

<PageTitle>Create Workspace</PageTitle>

<div class="page-shell">

    <Breadcrumbs>
        <li class="breadcrumb-item"><NavLink href="@WorkspaceRoot">Workspaces</NavLink></li>
        <li class="breadcrumb-item active" aria-current="page">Create Workspace</li>
    </Breadcrumbs>

    <header class="page-header">
        <div>
            <p class="section-label mb-2">Workspaces</p>
            <h1 class="page-title">Create workspace</h1>
            <p class="page-subtitle">
                Create a new workspace for your projects and boards.
            </p>
        </div>
    </header>

    <div class="form-surface">
        <WorkspaceForm
            Model="@model"
            IsSubmitting="@isCreating"
            SubmitText="Create workspace"
            ErrorMessage="@errorMessage"
            OnSubmit="@CreateAsync"
            OnCancel="@Cancel" />
    </div>

</div>

@code {

    private WorkspaceFormModel model = new();

    private bool isCreating;

    private string? errorMessage;

    private async Task CreateAsync(
        WorkspaceFormModel form)
    {
        if (isCreating)
        {
            return;
        }

        isCreating = true;
        errorMessage = null;

        try
        {
            var request =
                new CreateWorkspaceRequest
                {
                    Name = form.Name,
                    Description = form.Description
                };

            var workspace =
                await WorkspaceApiService.CreateAsync(
                    request);

            if (workspace is null)
            {
                errorMessage = "Unable to create the workspace. Please try again.";
                return;
            }

            Navigation.NavigateTo(
                $"{WorkspaceRoot}/{workspace.Id}");
        }
            catch (HttpRequestException)
            {
                errorMessage = "The workspace service could not be reached.";
            }
            catch (JsonException)
            {
                errorMessage = "The workspace service returned an invalid response.";
            }
        finally
        {
            isCreating = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(
            WorkspaceRoot);
    }

    private string WorkspaceRoot =>
        Navigation.Uri.Contains(
            "/manager/workspaces/create",
            StringComparison.OrdinalIgnoreCase)
            ? "/manager/workspaces"
            : "/workspaces";
}
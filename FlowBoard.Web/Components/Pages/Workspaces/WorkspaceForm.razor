@using FlowBoard.Web.Models.Workspaces

<EditForm Model="@Model"
          OnValidSubmit="@HandleSubmitAsync">

    <DataAnnotationsValidator />

    <div class="mb-3">

        <label class="form-label">
            Workspace Name
        </label>

        <InputText @bind-Value="Model.Name"
                   class="form-control"
                   placeholder="Enter workspace name" />

        <ValidationMessage
            For="@(() => Model.Name)" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Description
        </label>

        <InputTextArea @bind-Value="Model.Description"
                       class="form-control"
                       rows="3"
                       placeholder="Enter workspace description" />

        <ValidationMessage
            For="@(() => Model.Description)" />

    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }

    <div class="d-flex justify-content-end gap-2">

        <button type="button"
                class="btn btn-secondary"
                @onclick="OnCancel"
                disabled="@IsSubmitting">

            Cancel

        </button>

        <button type="submit"
                class="btn btn-primary"
                disabled="@IsSubmitting">

            @if (IsSubmitting)
            {
                <span>Saving...</span>
            }
            else
            {
                <span>@SubmitText</span>
            }

        </button>

    </div>

</EditForm>

@code {

    [Parameter]
    public WorkspaceFormModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<WorkspaceFormModel> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Save";

    [Parameter]
    public string? ErrorMessage { get; set; }

    private async Task HandleSubmitAsync()
    {
        await OnSubmit.InvokeAsync(Model);
    }
}
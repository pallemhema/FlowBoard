@page "/workspaces/{Id:guid}/edit"
@page "/manager/workspaces/{Id:guid}/edit"
@attribute [Authorize(Policy = AuthorizationPolicies.AdminOrManager)]

@using FlowBoard.Shared.DTOs.Workspaces
@using FlowBoard.Web.Models.Workspaces
@using System.Text.Json
@using System.Security.Claims

@inject IWorkspaceApiService WorkspaceApiService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Edit Workspace</PageTitle>

<div class="page-shell">

    @if (isLoading)
    {
        <div class="text-center py-5">
            Loading workspace...
        </div>
    }
    else if (workspace is null)
    {
        <EmptyState
            Title="@(isUnauthorized ? "Workspace management unavailable" : "Workspace not found")"
            Message="@(isUnauthorized ? "Only an administrator or the owning Manager can edit this workspace." : "The workspace could not be found.")" />

        <div class="mt-3">

            <button class="btn btn-secondary"
                    @onclick="Cancel">

                Back to Workspaces

            </button>

        </div>
    }
    else
    {
        <Breadcrumbs>
            <li class="breadcrumb-item"><NavLink href="@WorkspaceRoot">Workspaces</NavLink></li>
            <li class="breadcrumb-item"><NavLink href="@($"{WorkspaceRoot}/{Id}")">@workspace.Name</NavLink></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </Breadcrumbs>

        <header class="page-header">
            <div>
                <p class="section-label mb-2">Workspace settings</p>
                <h1 class="page-title">Edit workspace</h1>
                <p class="page-subtitle">
                    Update your workspace information.
                </p>
            </div>
        </header>

        <div class="form-surface">
            <WorkspaceForm
                Model="@model"
                IsSubmitting="@isUpdating"
                SubmitText="Save changes"
                ErrorMessage="@errorMessage"
                OnSubmit="@UpdateAsync"
                OnCancel="@Cancel" />
        </div>
    }

</div>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private WorkspaceResponse? workspace;

    private WorkspaceFormModel model = new();

    private bool isLoading;

    private bool isUpdating;

    private bool isUnauthorized;

    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        isLoading = true;
        isUnauthorized = false;

        try
        {
            workspace =
                await WorkspaceApiService.GetByIdAsync(Id);

            if (workspace is null)
            {
                return;
            }

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            var isAdmin = authState.User.IsInRole("Admin");
            if (!isAdmin &&
                (!Guid.TryParse(currentUserId, out var userId) ||
                 workspace.OwnerId != userId))
            {
                workspace = null;
                isUnauthorized = true;
                return;
            }

            model = new WorkspaceFormModel
            {
                Name = workspace.Name,
                Description = workspace.Description
            };
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateAsync(
        WorkspaceFormModel form)
    {
        if (isUpdating)
        {
            return;
        }

        isUpdating = true;
        errorMessage = null;

        try
        {
            var request =
                new UpdateWorkspaceRequest
                {
                    Name = form.Name,
                    Description = form.Description
                };

            var workspace =
                await WorkspaceApiService.UpdateAsync(
                    Id,
                    request);

            if (workspace is null)
            {
                errorMessage = "Unable to update the workspace. Please try again.";
                return;
            }

            Navigation.NavigateTo(
                $"{WorkspaceRoot}/{Id}");
        }
            catch (HttpRequestException)
            {
                errorMessage = "The workspace service could not be reached.";
            }
            catch (JsonException)
            {
                errorMessage = "The workspace service returned an invalid response.";
            }
        finally
        {
            isUpdating = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(
            $"{WorkspaceRoot}/{Id}");
    }

    private string WorkspaceRoot =>
        Navigation.Uri.Contains(
            "/manager/workspaces/",
            StringComparison.OrdinalIgnoreCase)
            ? "/manager/workspaces"
            : "/workspaces";
}
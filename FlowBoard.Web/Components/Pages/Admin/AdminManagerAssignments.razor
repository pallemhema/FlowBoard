@page "/admin/manager-assignments"
@attribute [Authorize(Policy = AuthorizationPolicies.AdminOnly)]
@implements IDisposable
@inject IManagerEmployeeApiService ManagerEmployeeApiService
@inject IUserDirectoryApiService UserDirectoryApiService
@inject ToastService ToastService

<PageTitle>Manager-Employee Assignments | FlowBoard</PageTitle>

<div class="page-shell admin-assignments-page">

    <PageHeader Title="Manager-Employee Assignments"
                Eyebrow="Administration"
                Description="Manage reporting relationships between managers and employees." />

    @if (isLoadingAssignments)
    {
        <div class="assignment-loading" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm text-primary"
                  aria-hidden="true"></span>
            <span>Loading manager assignments...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(assignmentsLoad.Error))
    {
        <div class="assignment-error" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>@assignmentsLoad.Error</span>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary ms-auto"
                    @onclick="LoadAllAssignmentsAsync">
                Retry
            </button>
        </div>
    }
    else
    {
        <div class="assignment-layout">

            <!-- Managers panel -->
            <section class="manager-panel"
                     aria-labelledby="manager-list-title">

                <div class="assignment-panel-heading">
                    <div>
                        <h2 id="manager-list-title">Managers</h2>
                        <p>
                            @(managerGroups.Count == 1
                                ? "1 manager with assignments"
                                : $"{managerGroups.Count:N0} managers with assignments")
                        </p>
                    </div>

                    <span class="assignment-count-icon">
                        <i class="bi bi-person-badge" aria-hidden="true"></i>
                    </span>
                </div>

                <div class="manager-search">
                    <SearchBox Value="@managerSearch"
                               ValueChanged="HandleManagerSearchChanged"
                               Placeholder="Search assigned managers" />
                </div>

                @if (filteredManagers.Count == 0)
                {
                    <EmptyState Title="@(string.IsNullOrWhiteSpace(managerSearch)
                                            ? "No assignments yet"
                                            : "No matching managers")"
                                Message="@(string.IsNullOrWhiteSpace(managerSearch)
                                            ? "Select a manager account in the assignment form to add the first relationship."
                                            : "Try another name or email address.")" />
                }
                else
                {
                    <div class="manager-list">
                        @foreach (var manager in filteredManagers)
                        {
                            <button type="button"
                                    class="manager-list-item @(selectedManager?.UserId == manager.UserId ? "manager-list-item-selected" : null)"
                                    aria-current="@(selectedManager?.UserId == manager.UserId ? "true" : null)"
                                    @onclick="() => SelectManager(manager)">

                                <UserAvatar FirstName="@manager.FirstName"
                                            LastName="@manager.LastName"
                                            SizeRem="2.35" />

                                <span class="manager-list-copy">
                                    <strong>
                                        @GetFullName(manager.FirstName, manager.LastName)
                                    </strong>
                                    <small>@manager.Email</small>
                                </span>

                                <span class="manager-employee-count">
                                    @GetEmployeesForManager(manager.UserId).Count
                                </span>

                                <i class="bi bi-chevron-right manager-chevron"
                                   aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                }

                <!-- Manager account search -->
                <div class="manager-account-search">
                    <p class="form-label">Find a manager account</p>

                    <SearchBox Value="@managerAccountSearch"
                               ValueChanged="HandleManagerAccountSearchChanged"
                               Placeholder="Search by name or email" />

                    @if (managerCandidates.IsLoading)
                    {
                        <div class="assignment-inline-loading" role="status">
                            <span class="spinner-border spinner-border-sm text-primary"
                                  aria-hidden="true"></span>
                            Searching managers...
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(managerCandidates.Error))
                    {
                        <div class="assignment-error compact" role="alert">
                            @managerCandidates.Error
                        </div>
                    }
                    else if (managerCandidates.Data is not null &&
                             managerCandidates.Data.Items.Count == 0)
                    {
                        <p class="assignment-empty-hint">
                            No manager accounts match this search.
                        </p>
                    }
                    else if (managerCandidates.Data is not null)
                    {
                        <div class="manager-candidate-list">
                            @foreach (var account in managerCandidates.Data.Items)
                            {
                                <button type="button"
                                        class="manager-candidate-button @(selectedManager?.UserId == account.UserId ? "manager-candidate-selected" : null)"
                                        @onclick="() => SelectManager(account)">

                                    <UserAvatar FirstName="@account.FirstName"
                                                LastName="@account.LastName" />

                                    <span class="manager-list-copy">
                                        <strong>
                                            @GetFullName(account.FirstName, account.LastName)
                                        </strong>
                                        <small>@account.Email</small>
                                    </span>

                                    @if (selectedManager?.UserId == account.UserId)
                                    {
                                        <i class="bi bi-check2"
                                           aria-label="Selected"></i>
                                    }
                                </button>
                            }
                        </div>

                        <Pagination CurrentPage="@managerCandidates.CurrentPage"
                                    TotalPages="@managerCandidates.Data.TotalPages"
                                    TotalCount="@managerCandidates.Data.TotalCount"
                                    PageSize="@managerCandidates.PageSize"
                                    PageChanged="LoadManagerCandidatesAsync" />
                    }
                    </div>
                
            </section>

            <!-- Assignment detail panel -->
            <section class="assignment-detail-panel"
                     aria-labelledby="assignment-detail-title">

                @if (selectedManager is null)
                {
                    <div class="assignment-detail-empty">
                        <span class="assignment-empty-icon">
                            <i class="bi bi-diagram-2" aria-hidden="true"></i>
                        </span>

                        <h2 id="assignment-detail-title">
                            Select a manager
                        </h2>
                    </div>
                }
                else
                {
                    <div class="assignment-detail-header">
                        <div class="manager-detail-identity">
                            <UserAvatar FirstName="@selectedManager.FirstName"
                                        LastName="@selectedManager.LastName"
                                        SizeRem="3"
                                        Square="true" />

                            <div>
                                <p class="section-label mb-1">Manager</p>

                                <h2 id="assignment-detail-title">
                                    @GetFullName(selectedManager.FirstName, selectedManager.LastName)
                                </h2>

                                <a href="mailto:@selectedManager.Email">
                                    @selectedManager.Email
                                </a>
                            </div>
                        </div>

                        <span class="assignment-total-badge">
                            @selectedManagerEmployees.Count employee@(selectedManagerEmployees.Count == 1 ? "" : "s")
                        </span>
                    </div>

                    <!-- Assign employees -->
                    <section class="assign-employee-section"
                             aria-labelledby="assign-employee-title">

                        <div class="assign-section-heading">
                            <div>
                                <h3 id="assign-employee-title">Assign employees</h3>
                                <p>Select an account and add it to this manager.</p>
                            </div>
                        </div>

                        <p class="form-label">Search account directory</p>

                        <div class="assignment-search">
                            <SearchBox Value="@employeeSearch"
                                       ValueChanged="HandleEmployeeSearchChanged"
                                       Placeholder="Search employee by name or email" />
                        </div>

                        @if (employeeCandidates.IsLoading)
                        {
                            <div class="assignment-inline-loading" role="status">
                                <span class="spinner-border spinner-border-sm text-primary"
                                      aria-hidden="true"></span>
                                Searching accounts...
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(employeeCandidates.Error))
                        {
                            <div class="assignment-error compact" role="alert">
                                <span>@employeeCandidates.Error</span>

                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary ms-auto"
                                        @onclick="() => LoadEmployeeCandidatesAsync(employeeCandidates.CurrentPage)">
                                    Retry
                                </button>
                            </div>
                        }
                        else if (employeeCandidates.Data is not null &&
                                 employeeCandidates.Data.Items.Count == 0)
                        {
                            <p class="assignment-empty-hint">
                                No accounts match this search.
                            </p>
                        }
                        else if (employeeCandidates.Data is not null)
                        {
                            <div class="assignment-candidate-list">
                                @foreach (var account in employeeCandidates.Data.Items)
                                {
                                    var isAlreadyAssigned = selectedManagerEmployees.Any(
                                        assignment => assignment.EmployeeId == account.UserId);

                                    <div class="assignment-candidate"
                                         @key="account.UserId">

                                        <UserAvatar FirstName="@account.FirstName"
                                                    LastName="@account.LastName"
                                                    SizeRem="2.35" />

                                        <span class="employee-candidate-copy">
                                            <strong>
                                                @GetFullName(account.FirstName, account.LastName)
                                            </strong>
                                            <small>@account.Email</small>
                                        </span>

                                        @if (isAlreadyAssigned)
                                        {
                                            <span class="assignment-already-added">
                                                <i class="bi bi-check2 me-1"
                                                   aria-hidden="true"></i>
                                                Assigned
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    disabled="@isSubmitting"
                                                    @onclick="() => AssignEmployeeAsync(account)">
                                                <i class="bi bi-plus-lg me-1"
                                                   aria-hidden="true"></i>
                                                Assign
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <Pagination CurrentPage="@employeeCandidates.CurrentPage"
                                        TotalPages="@employeeCandidates.Data.TotalPages"
                                        TotalCount="@employeeCandidates.Data.TotalCount"
                                        PageSize="@employeeCandidates.PageSize"
                                        PageChanged="LoadEmployeeCandidatesAsync" />
                        }
                    </section>

                    <!-- Assigned employees -->
                    <section class="assigned-employees-section"
                             aria-labelledby="assigned-employees-title">

                        <div class="assign-section-heading">
                            <div>
                                <h3 id="assigned-employees-title">
                                    Assigned employees
                                </h3>
                            </div>

                            @if (selectedManagerEmployees.Count > 0)
                            {
                                <span class="assigned-list-count">
                                    @selectedManagerEmployees.Count
                                </span>
                            }
                        </div>

                        <div class="assigned-search">
                            <SearchBox Value="@assignedEmployeeSearch"
                                       ValueChanged="HandleAssignedEmployeeSearchChanged"
                                       Placeholder="Filter assigned employees" />
                        </div>

                        @if (filteredAssignments.Count == 0)
                        {
                            <EmptyState Title="@(selectedManagerEmployees.Count == 0
                                                    ? "No employees assigned"
                                                    : "No matching employees")"
                                        Message="@(selectedManagerEmployees.Count == 0
                                                    ? "Use the account search above to add Employee accounts."
                                                    : "Try another name or email address.")" />
                        }
                        else
                        {
                            <div class="assigned-employee-list">
                                @foreach (var assignment in pagedAssignments)
                                {
                                    <div class="assigned-employee-row"
                                         @key="assignment.EmployeeId">

                                        <UserAvatar FirstName="@assignment.Employee.FirstName"
                                                    LastName="@assignment.Employee.LastName"
                                                    SizeRem="2.35" />

                                        <span class="assigned-employee-copy">
                                            <strong>
                                                @GetFullName(assignment.Employee.FirstName, assignment.Employee.LastName)
                                            </strong>
                                            <small>@assignment.Employee.Email</small>
                                        </span>

                                        <span class="assignment-date">
                                            @assignment.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                                        </span>

                                        @if (pendingRemovalEmployeeId == assignment.EmployeeId)
                                        {
                                            <span class="assignment-remove-confirm">
                                                <span>Remove?</span>

                                                <button type="button"
                                                        class="btn btn-sm btn-danger"
                                                        disabled="@isSubmitting"
                                                        @onclick="() => RemoveAssignmentAsync(assignment)">
                                                    Confirm
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        @onclick="CancelRemoval">
                                                    Cancel
                                                </button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    aria-label="@($"Remove assignment for {assignment.Employee.FirstName} {assignment.Employee.LastName}")"
                                                    @onclick="() => RequestRemoval(assignment.EmployeeId)">
                                                Remove
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="assignment-local-pagination">
                                <span>
                                    Showing @assignmentRangeStart-@assignmentRangeEnd
                                    of @filteredAssignments.Count
                                </span>

                                @if (filteredAssignments.Count > AssignmentPageSize)
                                {
                                    <div class="btn-group btn-group-sm"
                                         role="group"
                                         aria-label="Assigned employee pages">

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                disabled="@(assignedEmployeePage <= 1)"
                                                aria-label="Previous employee page"
                                                @onclick="PreviousAssignmentPage">
                                            Previous
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                disabled="@(assignedEmployeePage >= assignmentPageCount)"
                                                aria-label="Next employee page"
                                                @onclick="NextAssignmentPage">
                                            Next
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }
            </section>
        </div>
    }
</div>
@code {
    // Page sizes
    private const int RelationshipPageSize = PageSizeDefaults.Resource;
    private const int DirectoryPageSize = PageSizeDefaults.Default;
    private const int AssignmentPageSize = PageSizeDefaults.Default;

    // Assignment data
    private readonly List<ManagerEmployeeResponse> allAssignments = [];

    // Operation states
    private AsyncOperationState assignmentsLoad = new()
    {
        IsLoading = true
    };

    private AsyncOperationState assignmentOperation = new();

    // Candidate list states
    private PagedListState<UserDirectoryResponse> employeeCandidates = new()
    {
        PageSize = DirectoryPageSize
    };

    private PagedListState<UserDirectoryResponse> managerCandidates = new()
    {
        PageSize = DirectoryPageSize
    };

    // Selected manager
    private UserDirectoryResponse? selectedManager;

    // Search values
    private string? managerSearch;
    private string? managerAccountSearch;
    private string? employeeSearch;
    private string? assignedEmployeeSearch;

    // Assignment pagination
    private int assignedEmployeePage = 1;

    // Removal confirmation
    private Guid? pendingRemovalEmployeeId;

    // Search debounce


    private readonly DebouncedAction managerAccountSearchDebounce = new();
private readonly DebouncedAction employeeSearchDebounce = new();

    // Request versioning
    private long managerAccountSearchVersion;
    private long employeeSearchVersion;

    // Loading and operation status
    private bool isLoadingAssignments => assignmentsLoad.IsLoading;

    private bool isSubmitting => assignmentOperation.IsSubmitting;

    // Manager groups
    private List<UserDirectoryResponse> managerGroups => allAssignments
        .GroupBy(assignment => assignment.ManagerId)
        .Select(group => group.First().Manager)
        .OrderBy(manager => manager.FirstName)
        .ThenBy(manager => manager.LastName)
        .ThenBy(manager => manager.Email)
        .ToList();

    private List<UserDirectoryResponse> filteredManagers => managerGroups
        .Where(manager => Matches(
            $"{manager.FirstName} {manager.LastName} {manager.Email}",
            managerSearch))
        .ToList();

    // Selected manager employees
    private List<ManagerEmployeeResponse> selectedManagerEmployees =>
        selectedManager is null
            ? []
            : allAssignments
                .Where(assignment =>
                    assignment.ManagerId == selectedManager.UserId)
                .OrderBy(assignment => assignment.Employee.FirstName)
                .ThenBy(assignment => assignment.Employee.LastName)
                .ThenBy(assignment => assignment.Employee.Email)
                .ToList();

    // Filtered assignments
    private List<ManagerEmployeeResponse> filteredAssignments =>
        selectedManagerEmployees
            .Where(assignment => Matches(
                $"{assignment.Employee.FirstName} {assignment.Employee.LastName} {assignment.Employee.Email}",
                assignedEmployeeSearch))
            .ToList();

    // Paginated assignments
    private List<ManagerEmployeeResponse> pagedAssignments =>
        filteredAssignments
            .Skip((assignedEmployeePage - 1) * AssignmentPageSize)
            .Take(AssignmentPageSize)
            .ToList();

    private int assignmentPageCount => Math.Max(
        1,
        (int)Math.Ceiling(
            filteredAssignments.Count / (double)AssignmentPageSize));

    private int assignmentRangeStart => filteredAssignments.Count == 0
        ? 0
        : (assignedEmployeePage - 1) * AssignmentPageSize + 1;

    private int assignmentRangeEnd => Math.Min(
        assignedEmployeePage * AssignmentPageSize,
        filteredAssignments.Count);

    // Initialization
    protected override Task OnInitializedAsync() =>
        LoadAllAssignmentsAsync();

    // Load all manager-employee relationships
    private async Task LoadAllAssignmentsAsync()
    {
        assignmentsLoad.IsLoading = true;
        assignmentsLoad.Error = null;

        allAssignments.Clear();

        try
        {
            var firstPage = await ManagerEmployeeApiService.GetAllAsync(
                new PagedRequest
                {
                    Page = 1,
                    PageSize = RelationshipPageSize
                });

            if (firstPage is null)
            {
                assignmentsLoad.Error =
                    "Assignments could not be loaded. Confirm your Admin access and retry.";

                return;
            }

            allAssignments.AddRange(firstPage.Items);

            for (var page = 2; page <= firstPage.TotalPages; page++)
            {
                var response = await ManagerEmployeeApiService.GetAllAsync(
                    new PagedRequest
                    {
                        Page = page,
                        PageSize = RelationshipPageSize
                    });

                if (response is null)
                {
                    allAssignments.Clear();

                    assignmentsLoad.Error =
                        "The assignment list could not be fully loaded. Results are withheld to avoid partial manager counts.";

                    return;
                }

                allAssignments.AddRange(response.Items);
            }

            if (selectedManager is not null)
            {
                assignedEmployeePage = Math.Clamp(
                    assignedEmployeePage,
                    1,
                    assignmentPageCount);

                var refreshed = allAssignments
                    .FirstOrDefault(assignment =>
                        assignment.ManagerId == selectedManager.UserId)
                    ?.Manager;

                if (refreshed is not null)
                {
                    selectedManager = refreshed;
                }
            }
        }
        catch (HttpRequestException)
        {
            allAssignments.Clear();

            assignmentsLoad.Error =
                "The assignment service could not be reached. Check your connection and retry.";
        }
        catch (JsonException)
        {
            allAssignments.Clear();

            assignmentsLoad.Error =
                "The assignment service returned an invalid response.";
        }
        finally
        {
            assignmentsLoad.IsLoading = false;
        }
    }

    // Select manager
    private void SelectManager(UserDirectoryResponse manager)
    {
        selectedManager = manager;

        employeeSearchVersion++;

        employeeSearchDebounce?.Dispose();

        employeeCandidates.Data = null;
        employeeCandidates.CurrentPage = 1;
        employeeCandidates.Error = null;
        employeeCandidates.IsLoading = false;

        employeeSearch = null;
        assignedEmployeeSearch = null;
        assignedEmployeePage = 1;

        pendingRemovalEmployeeId = null;
    }

    // Manager group search
    private Task HandleManagerSearchChanged(string? value)
    {
        managerSearch = value?.Trim();

        return Task.CompletedTask;
    }

    // Manager account search with debounce

        private Task HandleManagerAccountSearchChanged(string? value)
    {
        managerAccountSearch = value?.Trim();

        return managerAccountSearchDebounce.ExecuteAsync(
            () => LoadManagerCandidatesAsync(1));
    }
   

    // Load manager account candidates
    private async Task LoadManagerCandidatesAsync(int page)
    {
        var version = ++managerAccountSearchVersion;

        managerCandidates.CurrentPage = page;
        managerCandidates.IsLoading = true;
        managerCandidates.Error = null;

        try
        {
            var response = await UserDirectoryApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = managerCandidates.PageSize,
                    Search = string.IsNullOrWhiteSpace(managerAccountSearch)
                        ? null
                        : managerAccountSearch
                });

            if (version != managerAccountSearchVersion)
            {
                return;
            }

            if (response is null)
            {
                managerCandidates.Data = null;

                managerCandidates.Error =
                    "The account directory could not be loaded. Confirm your Admin access and retry.";

                return;
            }

            managerCandidates.Data = response;
        }
        catch (HttpRequestException)
        {
            if (version == managerAccountSearchVersion)
            {
                managerCandidates.Data = null;

                managerCandidates.Error =
                    "The account directory could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == managerAccountSearchVersion)
            {
                managerCandidates.Data = null;

                managerCandidates.Error =
                    "The account directory returned an invalid response.";
            }
        }
        finally
        {
            if (version == managerAccountSearchVersion)
            {
                managerCandidates.IsLoading = false;
            }
        }
    }

    // Employee search with debounce

    private Task HandleEmployeeSearchChanged(string? value)
    {
        employeeSearch = value?.Trim();

        return employeeSearchDebounce.ExecuteAsync(
            () => LoadEmployeeCandidatesAsync(1));
    }
    

    // Load employee candidates
    private async Task LoadEmployeeCandidatesAsync(int page)
    {
        var version = ++employeeSearchVersion;

        employeeCandidates.CurrentPage = page;
        employeeCandidates.IsLoading = true;
        employeeCandidates.Error = null;

        try
        {
            var response = await UserDirectoryApiService.GetEmployeesAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = employeeCandidates.PageSize,
                    Search = string.IsNullOrWhiteSpace(employeeSearch)
                        ? null
                        : employeeSearch
                });

            if (version != employeeSearchVersion)
            {
                return;
            }

            if (response is null)
            {
                employeeCandidates.Data = null;

                employeeCandidates.Error =
                    "The account directory could not be loaded. Confirm your Admin access and retry.";

                return;
            }

            employeeCandidates.Data = response;
        }
        catch (HttpRequestException)
        {
            if (version == employeeSearchVersion)
            {
                employeeCandidates.Data = null;

                employeeCandidates.Error =
                    "The account directory could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == employeeSearchVersion)
            {
                employeeCandidates.Data = null;

                employeeCandidates.Error =
                    "The account directory returned an invalid response.";
            }
        }
        finally
        {
            if (version == employeeSearchVersion)
            {
                employeeCandidates.IsLoading = false;
            }
        }
    }

    // Assign employee to manager
    private async Task AssignEmployeeAsync(UserDirectoryResponse employee)
    {
        if (selectedManager is null ||
            assignmentOperation.IsSubmitting)
        {
            return;
        }

        if (selectedManagerEmployees.Any(
            assignment => assignment.EmployeeId == employee.UserId))
        {
            ToastService.Warning(
                "This employee is already assigned to this manager.");

            return;
        }

        assignmentOperation.IsSubmitting = true;

        try
        {
            var result = await ManagerEmployeeApiService.AssignAsync(
                selectedManager.UserId,
                new AssignEmployeeToManagerRequest
                {
                    EmployeeId = employee.UserId
                });

            if (result is null)
            {
                return;
            }

            ToastService.Success(
                $"{GetFullName(employee.FirstName, employee.LastName)} assigned to {GetFullName(selectedManager.FirstName, selectedManager.LastName)}.");

            await LoadAllAssignmentsAsync();

            if (employeeCandidates.Data is not null)
            {
                await LoadEmployeeCandidatesAsync(
                    employeeCandidates.CurrentPage);
            }
        }
        catch (HttpRequestException)
        {
            ToastService.Error(
                "The assignment service could not be reached. No assignment was confirmed.");
        }
        catch (JsonException)
        {
            ToastService.Error(
                "The assignment service returned an invalid response. Refresh assignments to confirm the result.");
        }
        finally
        {
            assignmentOperation.IsSubmitting = false;
        }
    }

    // Request assignment removal
    private void RequestRemoval(Guid employeeId)
    {
        pendingRemovalEmployeeId = employeeId;
    }

    // Cancel assignment removal
    private void CancelRemoval()
    {
        pendingRemovalEmployeeId = null;
    }

    // Remove employee assignment
    private async Task RemoveAssignmentAsync(
        ManagerEmployeeResponse assignment)
    {
        if (selectedManager is null ||
            assignmentOperation.IsSubmitting)
        {
            return;
        }

        assignmentOperation.IsSubmitting = true;

        try
        {
            var removed = await ManagerEmployeeApiService.RemoveAsync(
                assignment.ManagerId,
                assignment.EmployeeId);

            if (!removed)
            {
                return;
            }

            ToastService.Success(
                $"The assignment for {GetFullName(assignment.Employee.FirstName, assignment.Employee.LastName)} was removed.");

            pendingRemovalEmployeeId = null;

            await LoadAllAssignmentsAsync();
        }
        catch (HttpRequestException)
        {
            ToastService.Error(
                "The assignment service could not be reached. The relationship was not confirmed as removed.");
        }
        finally
        {
            assignmentOperation.IsSubmitting = false;
        }
    }

    // Assigned employee search
    private Task HandleAssignedEmployeeSearchChanged(string? value)
    {
        assignedEmployeeSearch = value?.Trim();
        assignedEmployeePage = 1;

        return Task.CompletedTask;
    }

    // Assignment pagination
    private void PreviousAssignmentPage()
    {
        if (assignedEmployeePage > 1)
        {
            assignedEmployeePage--;
        }
    }

    private void NextAssignmentPage()
    {
        if (assignedEmployeePage < assignmentPageCount)
        {
            assignedEmployeePage++;
        }
    }

    // Get employees assigned to a manager
    private List<ManagerEmployeeResponse> GetEmployeesForManager(
        Guid managerId) =>
        allAssignments
            .Where(assignment => assignment.ManagerId == managerId)
            .ToList();

    // Search matching
    private static bool Matches(string value, string? search) =>
        string.IsNullOrWhiteSpace(search) ||
        value.Contains(search, StringComparison.OrdinalIgnoreCase);

    // Full name
    private static string GetFullName(
        string firstName,
        string lastName)
    {
        var name = $"{firstName} {lastName}".Trim();

        return string.IsNullOrWhiteSpace(name)
            ? "Unnamed account"
            : name;
    }

    // Cleanup
    public void Dispose()
    {
        managerAccountSearchDebounce?.Dispose();

        employeeSearchDebounce?.Dispose();
    }
}
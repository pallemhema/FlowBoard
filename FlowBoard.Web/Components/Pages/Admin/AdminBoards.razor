    private async Task LoadBoardDetailsAsync(Guid boardId)
    {
        var version = ++boardDetailsVersion;

        selectedBoard ??= localFilteredBoards
            .Concat(boardList.Data?.Items ?? [])
            .FirstOrDefault(board => board.Id == boardId);

        // Reset board details
        boardDetails = null;
        boardWorkspace = null;
        boardProject = null;
        boardDetailsLoad.Error = null;

        // Reset board members
        boardMembers.Data = null;
        boardMembers.Error = null;
        boardMembers.CurrentPage = 1;

        // Reset member candidates
        memberCandidates.Data = null;
        memberCandidates.Error = null;
        memberCandidateSearch = null;

        // Reset member operations
        memberOperation.Error = null;
        memberSearch = null;
        pendingRemovalUserId = null;

        // Invalidate previous candidate requests
        memberCandidateRequestVersion++;

        // Cancel pending searches
        memberCandidateSearchDebounce.Cancel();
        memberSearchDebounce.Cancel();

        boardDetailsLoad.IsLoading = true;

        await Task.WhenAll(
            LoadBoardDetailsRecordAsync(version, boardId),
            LoadBoardMembersAsync(version, boardId, 1));
    }

    private async Task LoadBoardDetailsRecordAsync(long version, Guid boardId)
    {
        try
        {
            var board = await BoardApiService.GetByIdAsync(boardId);
            if (version != boardDetailsVersion)
            {
                return;
            }

            if (board is null)
            {
                boardDetailsLoad.Error = "Board details could not be loaded. Confirm your access and retry.";
                return;
            }

            boardDetails = board;
            selectedBoard = board;
            var workspaceTask = WorkspaceApiService.GetByIdAsync(board.WorkspaceId);
            var projectTask = board.ProjectId.HasValue
                ? ProjectApiService.GetByIdAsync(board.ProjectId.Value)
                : Task.FromResult<ProjectResponse?>(null);
            await Task.WhenAll(workspaceTask, projectTask);
            if (version != boardDetailsVersion)
            {
                return;
            }

            boardWorkspace = await workspaceTask;
            boardProject = await projectTask;
        }
        catch (HttpRequestException)
        {
            if (version == boardDetailsVersion)
            {
                boardDetailsLoad.Error = "The board details service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == boardDetailsVersion)
            {
                boardDetailsLoad.Error = "The board details service returned an invalid response.";
            }
        }
        finally
        {
            if (version == boardDetailsVersion)
            {
                boardDetailsLoad.IsLoading = false;
            }
        }
    }

    private Task RetryBoardDetailsAsync() =>
        selectedBoard is null
            ? Task.CompletedTask
            : LoadBoardDetailsAsync(selectedBoard.Id);


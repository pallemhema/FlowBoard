@page "/admin/boards"
@attribute [Authorize(Policy = AuthorizationPolicies.AdminOnly)]
@implements IDisposable

@inject IBoardApiService BoardApiService
@inject IBoardMemberApiService BoardMemberApiService
@inject IWorkspaceApiService WorkspaceApiService
@inject IProjectApiService ProjectApiService
@inject IUserDirectoryApiService UserDirectoryApiService
@inject ToastService ToastService

<PageTitle>Board Management | FlowBoard</PageTitle>

<div class="page-shell admin-boards-page">
    <PageHeader Title="Board Management"
                Eyebrow="Administration"
                Description="Manage project boards and workspace-level General and Learning boards.">
        <Actions>
            <button type="button" class="btn btn-primary" @onclick="OpenCreateForm">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Create board
            </button>
        </Actions>
    </PageHeader>

@if (showBoardForm)
{
    <section class="board-form-panel"
             aria-labelledby="board-form-title">

        <div class="board-panel-heading">
            <div>
                <p class="section-label mb-1">Board settings</p>
                <h2 id="board-form-title">
                    @(isEditingBoard ? "Edit board" : "Create a board")
                </h2>
            </div>

            <button type="button"
                    class="btn-close"
                    aria-label="Close board form"
                    disabled="@boardFormOperation.IsSubmitting"
                    @onclick="CloseBoardForm">
            </button>
        </div>

        <BoardForm FormName="admin-board-form"
                   Model="@boardForm"
                   OnSubmit="@SaveBoardAsync"
                   OnCancel="@CloseBoardForm"
                   IsLoading="@boardFormOperation.IsSubmitting"
                   SubmitText="@(isEditingBoard ? "Save changes" : "Create board")"
                   LoadingText="Saving..."
                   ErrorMessage="@boardFormOperation.Error"
                   ShowPurpose="true"
                   ShowWorkspace="true"
                   IsWorkspaceReadOnly="@isEditingBoard"
                   Workspaces="@workspaces"
                   Projects="@formProjects"
                   IsLoadingWorkspaces="@workspaceLoad.IsLoading"
                   IsLoadingProjects="@formProjectsLoad.IsLoading"
                   OnPurposeChanged="@HandleFormPurposeChanged"
                   OnWorkspaceChanged="@HandleFormWorkspaceChanged" />



    </section>
}

    <DataListPanel Title="Boards"
                TitleId="board-list-title"
                Description="Board visibility and available actions remain subject to backend authorization."
                CountText="@BoardCountText"
                CssClass="board-list-panel">

        <Toolbar>
            <DataListToolBar SearchValue="@boardSearch"
                            SearchValueChanged="HandleBoardSearchChanged"
                            SearchPlaceholder="Search board name or description">

                <Filters>

                    <DataListSelectFilter TValue="Guid?"
                                        Id="board-workspace-filter"
                                        Label="Filter by workspace"
                                        Placeholder="All workspaces"
                                        Options="@WorkspaceFilterOptions"
                                        @bind-Value="workspaceFilter"
                                        @bind-Value:after="HandleWorkspaceFilterChanged"
                                        Disabled="@workspaceLoad.IsLoading" />

                    <DataListSelectFilter TValue="BoardPurpose?"
                                        Id="board-purpose-filter"
                                        Label="Filter by board purpose"
                                        Placeholder="All purposes"
                                        Options="@PurposeFilterOptions"
                                        @bind-Value="purposeFilter"
                                        @bind-Value:after="HandlePurposeFilterChanged"
                                        Disabled="@(!workspaceFilter.HasValue)" />

                    <DataListSelectFilter TValue="Guid?"
                                        Id="board-project-filter"
                                        Label="Filter by project"
                                        Placeholder="All projects"
                                        Options="@ProjectFilterOptions"
                                        @bind-Value="projectFilter"
                                        @bind-Value:after="HandleProjectFilterChanged"
                                        Disabled="@(!workspaceFilter.HasValue || filterProjectsLoad.IsLoading)" />

                </Filters>

                <Messages>
                    @if (!string.IsNullOrWhiteSpace(workspaceLoad.Error))
                    {
                        <div class="board-error compact" role="alert">
                            <span>@workspaceLoad.Error</span>

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="LoadWorkspacesAsync">
                                Retry workspaces
                            </button>
                        </div>
                    }
                </Messages>

                <Actions>
                    <button type="button"
                            class="btn btn-outline-secondary board-clear-button"
                            disabled="@(!HasActiveFilters)"
                            @onclick="ClearFilters">
                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>
                        Clear filters
                    </button>
                </Actions>

            </DataListToolBar>
        </Toolbar>

    <ChildContent>

        @if (workspaceFilter.HasValue &&
            (purposeFilter.HasValue || projectFilter.HasValue))
        {
            <p class="board-filter-note">
                Project and purpose filters search the selected workspace's
                matching boards.
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(boardList.Error))
        {
            <div class="board-error" role="alert">
                <span>@boardList.Error</span>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary ms-auto"
                        @onclick="() => LoadBoardsAsync(boardList.CurrentPage)">
                    Retry
                </button>
            </div>
        }
        else if (boardList.IsLoading)
        {
            <div class="board-loading" role="status">
                Loading boards...
            </div>
        }
        else if (UsesLocalFilters
            ? localFilteredBoards.Count == 0
            : boardList.Data?.Items.Count == 0)
        {
            <EmptyState Title="@(HasActiveFilters
                                ? "No matching boards"
                                : "No boards yet")"
                        Message="@(HasActiveFilters
                                ? "Try changing or clearing the selected filters."
                                : "Create a project board or a General/Learning board to get started.")" />
        }
        else if (UsesLocalFilters || boardList.Data is not null)
        {
            <DataTable TItem="BoardResponse"
                    Items="@VisibleBoards"
                    Columns="@BoardColumns"
                    ItemKeySelector="@(board => board.Id)"
                    CssClass="table board-table align-middle" />

            @if (UsesLocalFilters)
            {
                <Pagination CurrentPage="@boardList.CurrentPage"
                            TotalPages="@LocalBoardTotalPages"
                            TotalCount="@localFilteredBoards.Count"
                            PageSize="@boardList.PageSize"
                            PageChanged="LoadBoardsAsync" />
            }
            else if (boardList.Data is not null)
            {
                <Pagination CurrentPage="@boardList.Data.Page"
                            TotalPages="@boardList.Data.TotalPages"
                            TotalCount="@boardList.Data.TotalCount"
                            PageSize="@boardList.Data.PageSize"
                            PageChanged="LoadBoardsAsync" />
            }
        }

    </ChildContent>

    </DataListPanel>

    @if (selectedBoard is not null)
    {
        <div class="board-modal-backdrop board-details-backdrop"
             role="presentation"
             @onclick="CloseBoardDetails">
        <section class="board-details-panel board-details-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="board-details-title"
                 @onclick:stopPropagation>
            <div class="board-details-header">
                <div>
                    <p class="section-label mb-1">Board details</p>
                    <h2 id="board-details-title">@selectedBoard.Name</h2>
                    @if (boardDetails is not null)
                    {
                        <span class="board-purpose-badge">@GetPurposeLabel(boardDetails.Purpose)</span>
                    }
                </div>
                <button type="button" class="btn-close" aria-label="Close board details" @onclick="CloseBoardDetails"></button>
            </div>

            @if (boardDetailsLoad.IsLoading)
            {
                <div class="board-loading" role="status">
                    <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                    <span>Loading board details…</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(boardDetailsLoad.Error))
            {
                <div class="board-error" role="alert">
                    <span>@boardDetailsLoad.Error</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="RetryBoardDetailsAsync">Retry</button>
                </div>
            }
            else if (boardDetails is not null)
            {
                <div class="board-detail-grid">
                    <div class="board-detail-item">
                        <span>Workspace</span>
                        <strong>@(boardWorkspace?.Name ?? "Workspace name unavailable")</strong>
                    </div>
                    <div class="board-detail-item">
                        <span>Project</span>
                        <strong>@(boardDetails.ProjectId.HasValue ? boardProject?.Name ?? $"Project ID: {boardDetails.ProjectId}" : "No project — workspace-level board")</strong>
                    </div>
                    <div class="board-detail-item">
                        <span>Owner ID</span>
                        <strong class="board-id-value">@boardDetails.OwnerId</strong>
                    </div>
                    <div class="board-detail-item">
                        <span>Created</span>
                        <strong>@boardDetails.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</strong>
                    </div>
                    @if (boardDetails.ModifiedAt.HasValue)
                    {
                        <div class="board-detail-item">
                            <span>Last updated</span>
                            <strong>@boardDetails.ModifiedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</strong>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(boardDetails.Description))
                    {
                        <div class="board-detail-item board-detail-wide">
                            <span>Description</span>
                            <p>@boardDetails.Description</p>
                        </div>
                    }
                </div>

                <section class="board-members-section" aria-labelledby="board-members-title">
                    <div class="board-subsection-heading">
                        <div>
                            <h3 id="board-members-title">Board membership</h3>
                            <p>The Owner is set by the board record; member roles available here are Editor and Viewer.</p>
                        </div>
                        @if (boardMembers is not null)
                        {
                            <span class="board-detail-count">@boardMembers.TotalCount.ToString("N0") members</span>
                        }
                    </div>

                    <div class="board-owner-row">
                        <span class="board-member-avatar" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
                        <span class="board-member-copy">
                            <strong>Board owner</strong>
                            <small>@boardDetails.OwnerId</small>
                        </span>
                        <span class="board-role-pill owner-role">Owner</span>
                    </div>

                    <div class="board-member-add">
                        <div class="board-subsection-heading compact-heading">
                            <div>
                                <h4>Add an existing user</h4>
                                <p>Eligible accounts must already be members of this board's project or workspace, as required by the backend.</p>
                            </div>
                        </div>
                        <div class="board-member-add-controls">
                            <div class="board-member-search">
                                <SearchBox Value="@memberCandidateSearch"
                                           ValueChanged="HandleMemberCandidateSearchChanged"
                                           Placeholder="Search users by name or email" />
                            </div>
                            <label class="visually-hidden" for="new-board-member-role">Role for new board member</label>
                            <InputSelect id="new-board-member-role" class="form-select board-role-select" @bind-Value="newMemberRole">
                                <option value="@BoardMemberRole.Viewer">Viewer</option>
                                <option value="@BoardMemberRole.Editor">Editor</option>
                            </InputSelect>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(memberCandidates.Error))
{
    <div class="board-error compact" role="alert">
        <span>@memberCandidates.Error</span>
        <button type="button"
                class="btn btn-sm btn-outline-secondary ms-auto"
                @onclick="RetryMemberCandidatesAsync">
            Retry
        </button>
    </div>
}
else if (string.IsNullOrWhiteSpace(memberCandidateSearch) ||
         memberCandidateSearch.Trim().Length < 2)
{
    <p class="board-help-text">
        Enter at least two characters to search the user directory.
        The directory does not include roles; the backend validates eligibility.
    </p>
}
else if (memberCandidates.IsLoading)
{
    <div class="board-inline-loading" role="status">
        <span class="spinner-border spinner-border-sm text-primary"
              aria-hidden="true"></span>
        Searching users...
    </div>
}
else if (memberCandidates.Data is not null)
{
    @if (memberCandidates.Data.Items.Count == 0)
    {
        <EmptyState Title="No users found"
                    Message="Try another name or email address." />
    }
    else
    {
        <div class="board-candidate-list">
            @foreach (var candidate in memberCandidates.Data.Items)
            {
                var isBoardOwner =
                    boardDetails?.OwnerId == candidate.UserId;

               var isCurrentMember =
                    boardMembers?.Data?.Items?
                        .Any(member => member.UserId == candidate.UserId) == true;

                <div class="board-person-row" @key="candidate.UserId">
                    <UserAvatar FirstName="@candidate.FirstName"
                                LastName="@candidate.LastName" />

                    <span class="board-member-copy">
                        <strong>
                            @GetFullName(candidate.FirstName, candidate.LastName)
                        </strong>
                        <small>@candidate.Email</small>
                    </span>

                    @if (isBoardOwner)
                    {
                        <span class="board-role-pill owner-role">Owner</span>
                    }
                    else if (isCurrentMember)
                    {
                        <span class="board-role-pill">Member</span>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                disabled="@memberOperation.IsSubmitting"
                                @onclick="() => AddBoardMemberAsync(candidate)">
                            <i class="bi bi-plus-lg me-1"
                               aria-hidden="true"></i>
                            Add
                        </button>
                    }
                </div>
            }
        </div>
    }

    <Pagination CurrentPage="@memberCandidates.CurrentPage"
                TotalPages="@memberCandidates.TotalPages"
                TotalCount="@memberCandidates.TotalCount"
                PageSize="@memberCandidates.PageSize"
                PageChanged="LoadMemberCandidatePageAsync" />

                        }
                        else if (string.IsNullOrWhiteSpace(memberCandidateSearch) || memberCandidateSearch.Trim().Length < 2)
                        {
                            <p class="board-help-text">Enter at least two characters to search the user directory. The directory does not include roles; the backend validates eligibility.</p>
                        }
                    </div>

                    <div class="board-current-members-heading">
                        <label class="form-label" for="board-member-search">Current members</label>

                        <SearchBox Value="@memberSearch"
                                ValueChanged="HandleBoardMemberSearchChanged"
                                Placeholder="Filter members by name or email" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(boardMembers?.Error))

                    {
                        <div class="board-error compact" role="alert">
                            <span>@boardMembers.Error</span>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary ms-auto"
                                    @onclick="RetryBoardMembersAsync">
                                Retry
                            </button>
                        </div>
                    }
                    else if (boardMembers?.IsLoading == true){
                        <div class="board-inline-loading" role="status">
                            <span class="spinner-border spinner-border-sm text-primary"
                                aria-hidden="true"></span>
                            Loading board members...
                        </div>
                    }
                    else if (boardMembers?.Data is not null &&
                            boardMembers.Data.Items.Count == 0)
                    {
                        <EmptyState Title="@(boardMembers.TotalCount == 0
                                            ? "No board members"
                                            : "No matching members")"
                                    Message="@(boardMembers.TotalCount == 0
                                            ? "The owner is listed separately. Add eligible project or workspace members when needed."
                                            : "Try another name or email address.")" />
                    }
                    else if (boardMembers?.Data is not null)
                    {
                        <div class="board-current-member-list">
                            @foreach (var member in boardMembers.Data.Items)
                            {
                                <div class="board-person-row" @key="member.UserId">
                                    <UserAvatar FirstName="@member.FirstName"
                                                LastName="@member.LastName" />

                                    <span class="board-member-copy">
                                        <strong>@GetFullName(member.FirstName, member.LastName)</strong>
                                        <small>@member.Email</small>
                                    </span>

                                    <label class="visually-hidden"
                                        for="@($"member-role-{member.UserId}")">
                                        Role for @GetFullName(member.FirstName, member.LastName)
                                    </label>

                                    <select id="@($"member-role-{member.UserId}")"
                                            class="form-select form-select-sm board-role-select"
                                            value="@member.Role"
                                            disabled="@memberOperation.IsSubmitting"
                                            @onchange="args => UpdateBoardMemberRoleAsync(member, args)">
                                        <option value="@BoardMemberRole.Viewer">Viewer</option>
                                        <option value="@BoardMemberRole.Editor">Editor</option>
                                    </select>

                                    @if (pendingRemovalUserId == member.UserId)
                                    {
                                        <span class="board-remove-confirm">
                                            <span>Remove?</span>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    disabled="@memberOperation.IsSubmitting"
                                                    @onclick="() => RemoveBoardMemberAsync(member)">
                                                Confirm
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    disabled="@memberOperation.IsSubmitting"
                                                    @onclick="CancelMemberRemoval">
                                                Cancel
                                            </button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                disabled="@memberOperation.IsSubmitting"
                                                aria-label="@($"Remove {member.FirstName} {member.LastName} from board")"
                                                @onclick="() => RequestMemberRemoval(member.UserId)">
                                            Remove
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <Pagination CurrentPage="@boardMembers.CurrentPage"
                                    TotalPages="@boardMembers.TotalPages"
                                    TotalCount="@boardMembers.TotalCount"
                                    PageSize="@boardMembers.PageSize"
                                    PageChanged="LoadBoardMemberPageAsync" />
                    }

                    @if (!string.IsNullOrWhiteSpace(memberOperation.Error))
                    {
                        <div class="board-error compact mt-2" role="alert">
                            @memberOperation.Error
                        </div>
                    }
                </section>
            }
        </section>
        </div>
    }

    @if (boardPendingDelete is not null)
    {
        <div class="board-modal-backdrop" role="presentation">
            <section class="board-delete-dialog" role="dialog" aria-modal="true" aria-labelledby="board-delete-title">
                <div class="board-dialog-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
                <h2 id="board-delete-title">Delete @boardPendingDelete.Name?</h2>
                <p>Boards with columns or members cannot be deleted. Resolve those dependencies first; this action will not remove them automatically.</p>
                @if (!string.IsNullOrWhiteSpace(deleteBoardOperation.Error))
                {
                    <div class="board-error compact" role="alert">@deleteBoardOperation.Error</div>
                }
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary" disabled="@boardFormOperation.IsSubmitting" @onclick="CancelBoardDeletion">Cancel</button>
                    <button type="button" class="btn btn-danger" disabled="@boardFormOperation.IsSubmitting" @onclick="DeleteBoardAsync">
                        @(boardFormOperation.IsSubmitting ? "Deleting..." : "Delete board")
                    </button>
                </div>
            </section>
        </div>
    }
</div>

 
@code {
    // Pagination defaults
// Page size defaults
private const int BoardPageSize = PageSizeDefaults.Default;
private const int ResourcePageSize = PageSizeDefaults.Resource;
private const int DirectoryPageSize = PageSizeDefaults.Default;
private const int MemberPageSize = PageSizeDefaults.Default;

// Board list
private PagedListState<BoardResponse> boardList = new()
{
    PageSize = BoardPageSize,
    IsLoading = true
};

// Workspace board cache and local filtering
private List<BoardResponse> localFilteredBoards = [];
private List<BoardResponse> workspaceBoardCache = [];
private Guid? workspaceBoardCacheWorkspaceId;
private string? workspaceBoardCacheSearch;

// Reference data
private List<WorkspaceResponse> workspaces = [];
private List<ProjectResponse> filterProjects = [];
private List<ProjectResponse> formProjectResponses = [];
private List<BoardProjectOptionResponse> formProjects = [];

// Selected board
private BoardResponse? selectedBoard;
private BoardResponse? boardDetails;
private BoardResponse? boardPendingDelete;
private WorkspaceResponse? boardWorkspace;
private ProjectResponse? boardProject;

// Board members
private PagedListState<BoardMemberResponse> boardMembers = new()
{
    PageSize = MemberPageSize
};

// Member candidates
private PagedListState<UserDirectoryResponse> memberCandidates = new()
{
    PageSize = DirectoryPageSize
};

// Async operations
private AsyncOperationState workspaceLoad = new();
private AsyncOperationState filterProjectsLoad = new();
private AsyncOperationState formProjectsLoad = new();
private AsyncOperationState boardDetailsLoad = new();
private AsyncOperationState boardFormOperation = new();
private AsyncOperationState memberOperation = new();
private AsyncOperationState deleteBoardOperation = new();

// Board form
private BoardFormModel boardForm = new();
private bool showBoardForm;
private bool isEditingBoard;

// Search and filters
private string? boardSearch;
private Guid? workspaceFilter;
private Guid? projectFilter;
private BoardPurpose? purposeFilter;
private string? memberSearch;
private string? memberCandidateSearch;

// Board member operations
private BoardMemberRole newMemberRole = BoardMemberRole.Viewer;
private Guid? pendingRemovalUserId;

// Request versioning
private long boardListRequestVersion;
private long formProjectRequestVersion;
private long filterProjectRequestVersion;
private long boardDetailsVersion;
private long boardMemberRequestVersion;
private long memberCandidateRequestVersion;

// Search debounce
private readonly DebouncedAction boardSearchDebounce = new();
private readonly DebouncedAction memberSearchDebounce = new();
private readonly DebouncedAction memberCandidateSearchDebounce = new();

    // Search debounce
    private static readonly string[] BoardHeaders =
    [
        "Board",
        "Purpose",
        "Workspace",
        "Project",
        "Owner",
        "Created",
        "Actions"
    ];

    private bool UsesLocalFilters =>
        workspaceFilter.HasValue &&
        (purposeFilter.HasValue || projectFilter.HasValue);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(boardSearch) ||
        workspaceFilter.HasValue ||
        projectFilter.HasValue ||
        purposeFilter.HasValue;

    private int LocalBoardTotalPages =>
        Math.Max(1, (int)Math.Ceiling(localFilteredBoards.Count / (double)BoardPageSize));


    private string BoardCountText =>
        UsesLocalFilters
            ? $"{localFilteredBoards.Count:N0} matching boards"
            : $"{boardList.TotalCount:N0} boards";

    private IEnumerable<BoardResponse> VisibleBoards =>
        UsesLocalFilters
            ? GetVisibleLocalBoards()
            : boardList.Data?.Items ?? [];



    private IReadOnlyList<DataTableColumn<BoardResponse>> BoardColumns =>
    [
        new()
        {
            Header = "Board",
            Template = board => @<div class="board-name-cell">
                <strong>@board.Name</strong>
                <small>
                    @(string.IsNullOrWhiteSpace(board.Description)
                        ? "No description"
                        : board.Description)
                </small>
            </div>
        },

        new()
        {
            Header = "Purpose",
            Template = board => @<span class="board-purpose-badge">
                @GetPurposeLabel(board.Purpose)
            </span>
        },

        new()
        {
            Header = "Workspace",
            Template = board => @<span>
                @GetWorkspaceName(board.WorkspaceId)
            </span>
        },
        new()
        {
            Header = "Project",
            Template = board => @<span>
                @(board.Purpose == BoardPurpose.Project
                    ? board.ProjectName ?? "Project name unavailable"
                    : "-")
            </span>
        },

        new()
        {
            Header = "Owner",
            Template = board => @<div class="board-owner-cell">
                <strong>@(board.OwnerName ?? "Unknown user")</strong>
                <small>@board.OwnerEmail</small>
            </div>
        },

        new()
        {
            Header = "Created",
            Template = board => @<span>
                @board.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
            </span>
        },

        new()
        {
            Header = "Actions",
            HeaderClass = "text-end",
            CellClass = "text-end",
            Template = board => @<div class="board-row-actions">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="() => OpenBoardDetailsAsync(board)">
                    View
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        @onclick="() => OpenEditForm(board)">
                    Edit
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="() => RequestBoardDeletion(board)">
                    Delete
                </button>
            </div>
        }
            
        ];

    private IReadOnlyList<DataListFilterOption<Guid?>> WorkspaceFilterOptions =>
    [
        .. workspaces.Select(workspace => new DataListFilterOption<Guid?>
        {
            Value = workspace.Id,
            Text = workspace.Name
        })
    ];

    private IReadOnlyList<DataListFilterOption<BoardPurpose?>> PurposeFilterOptions =>
    [
        new()
        {
            Value = BoardPurpose.Project,
            Text = "Project"
        },
        new()
        {
            Value = BoardPurpose.GeneralLearning,
            Text = "General/Learning"
        }
    ];

    private IReadOnlyList<DataListFilterOption<Guid?>> ProjectFilterOptions =>
    [
        .. filterProjects.Select(project => new DataListFilterOption<Guid?>
        {
            Value = project.ProjectId,
            Text = project.Name
        })
    ];

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadWorkspacesAsync(), LoadBoardsAsync(1));
    }

    private async Task LoadWorkspacesAsync()
    {
        workspaceLoad.IsLoading = true;
        workspaceLoad.Error = null;
        try
        {
            var firstPage = await WorkspaceApiService.GetAsync(
                new PagedSearchRequest { Page = 1, PageSize = ResourcePageSize });
            if (firstPage is null)
            {
                workspaceLoad.Error = "Workspace options could not be loaded. Confirm your access and retry.";
                return;
            }

            var results = firstPage.Items.ToList();
            for (var page = 2; page <= firstPage.TotalPages; page++)
            {
                var response = await WorkspaceApiService.GetAsync(
                    new PagedSearchRequest { Page = page, PageSize = ResourcePageSize });
                if (response is null)
                {
                    workspaceLoad.Error = "Workspace options could not be fully loaded. Partial results are withheld.";
                    return;
                }

                results.AddRange(response.Items);
            }

            workspaces = results;
        }
        catch (HttpRequestException)
        {
            workspaceLoad.Error = "The workspace service could not be reached.";
        }
        catch (JsonException)
        {
            workspaceLoad.Error = "The workspace service returned an invalid response.";
        }
        finally
        {
            workspaceLoad.IsLoading = false;
        }
    }

    private async Task LoadBoardsAsync(int page)
    {
        var requestVersion = ++boardListRequestVersion;

        boardList.CurrentPage = page;
        boardList.IsLoading = true;
        boardList.Error = null;

        try
        {
            if (UsesLocalFilters)
            {
                await LoadWorkspaceFilteredBoardsAsync(requestVersion);
                return;
            }

            var response = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    Page = page,
                    PageSize = boardList.PageSize,
                    Search = NormalizeSearch(boardSearch),
                    WorkspaceId = workspaceFilter
                });

            if (requestVersion != boardListRequestVersion)
                return;

            if (response is null)
            {
                boardList.Data = null;
                boardList.Error = "Boards could not be loaded. Confirm your access and retry.";
                return;
            }

            boardList.Data = response;
        }
        catch (HttpRequestException)
        {
            if (requestVersion == boardListRequestVersion)
            {
                boardList.Data = null;
                boardList.Error = "The board service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == boardListRequestVersion)
            {
                boardList.Data = null;
                boardList.Error = "The board service returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == boardListRequestVersion)
            {
                boardList.IsLoading = false;
            }
        }
    }
    private async Task LoadWorkspaceFilteredBoardsAsync(long requestVersion)
    {
        if (!workspaceFilter.HasValue)
        {
            localFilteredBoards = [];
            return;
        }

        var normalizedSearch = NormalizeSearch(boardSearch);

        if (workspaceBoardCacheWorkspaceId != workspaceFilter ||
            !string.Equals(
                workspaceBoardCacheSearch,
                normalizedSearch,
                StringComparison.Ordinal))
        {
            var firstPage = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    WorkspaceId = workspaceFilter,
                    Search = normalizedSearch,
                    Page = 1,
                    PageSize = ResourcePageSize
                });

            if (requestVersion != boardListRequestVersion)
                return;

            if (firstPage is null)
            {
                localFilteredBoards = [];
                boardList.Error = "Boards for the selected workspace could not be loaded.";
                return;
            }

            var results = firstPage.Items.ToList();

            for (var page = 2; page <= firstPage.TotalPages; page++)
            {
                var response = await BoardApiService.GetAsync(
                    new BoardQueryRequest
                    {
                        WorkspaceId = workspaceFilter,
                        Search = normalizedSearch,
                        Page = page,
                        PageSize = ResourcePageSize
                    });

                if (requestVersion != boardListRequestVersion)
                    return;

                if (response is null)
                {
                    localFilteredBoards = [];
                    boardList.Error =
                        "The selected workspace's board list could not be fully loaded. Partial results are withheld.";
                    return;
                }

                results.AddRange(response.Items);
            }

            workspaceBoardCache = results;
            workspaceBoardCacheWorkspaceId = workspaceFilter;
            workspaceBoardCacheSearch = normalizedSearch;
        }

        localFilteredBoards = workspaceBoardCache
            .Where(board =>
                (!purposeFilter.HasValue ||
                board.Purpose == purposeFilter.Value) &&
                (!projectFilter.HasValue ||
                board.ProjectId == projectFilter.Value))
            .OrderBy(board => board.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        boardList.CurrentPage = Math.Clamp(
            boardList.CurrentPage,
            1,
            LocalBoardTotalPages);
    }
        

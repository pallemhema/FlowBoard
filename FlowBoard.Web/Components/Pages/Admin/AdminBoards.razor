        boardWorkspace = null;
        boardProject = null;

        // Reset board members
        boardMembers.Data = null;
        boardMembers.Error = null;
        boardMembers.IsLoading = false;
        boardMembers.CurrentPage = 1;

        // Reset member candidates
        memberCandidates.Data = null;
        memberCandidates.Error = null;
        memberCandidates.IsLoading = false;
        memberCandidates.CurrentPage = 1;

        pendingRemovalUserId = null;
        memberCandidateSearch = null;
        memberSearch = null;

        boardDetailsLoad.IsLoading = false;
        boardDetailsLoad.Error = null;
        memberOperation.Error = null;

        memberCandidateSearchDebounce.Cancel();
        memberSearchDebounce.Cancel();
    }
    private async Task LoadBoardMembersAsync(
        long detailsVersion,
        Guid boardId,
        int page)
    {
        var requestVersion = ++boardMemberRequestVersion;

        boardMembers.CurrentPage = page;
        boardMembers.IsLoading = true;
        boardMembers.Error = null;

        try
        {
            var response = await BoardMemberApiService.GetAsync(
                boardId,
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = boardMembers.PageSize,
                    Search = NormalizeSearch(memberSearch)
                });

            if (detailsVersion != boardDetailsVersion ||
                requestVersion != boardMemberRequestVersion)
            {
                return;
            }

            if (response is null)
            {
                boardMembers.Data = null;
                boardMembers.Error =
                    "Board members could not be loaded. Confirm your access and retry.";
                return;
            }

            boardMembers.Data = response;
        }
        catch (HttpRequestException)
        {
            if (detailsVersion == boardDetailsVersion &&
                requestVersion == boardMemberRequestVersion)
            {
                boardMembers.Data = null;
                boardMembers.Error =
                    "The board member service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (detailsVersion == boardDetailsVersion &&
                requestVersion == boardMemberRequestVersion)
            {
                boardMembers.Data = null;
                boardMembers.Error =
                    "The board member service returned an invalid response.";
            }
        }
        finally
        {
            if (detailsVersion == boardDetailsVersion &&
                requestVersion == boardMemberRequestVersion)
            {
                boardMembers.IsLoading = false;
            }
        }
    }    

    private Task RetryBoardMembersAsync() =>
        selectedBoard is null
            ? Task.CompletedTask
            : LoadBoardMembersAsync(
                boardDetailsVersion,
                selectedBoard.Id,
                boardMembers.CurrentPage);


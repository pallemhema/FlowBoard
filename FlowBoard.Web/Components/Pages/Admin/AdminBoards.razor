    private async Task RemoveBoardMemberAsync(BoardMemberResponse member)
    {
        if (selectedBoard is null || boardFormOperation.IsSubmitting)
        {
            return;
        }

        boardFormOperation.IsSubmitting = true;
        memberOperation.Error = null;
        try
        {
            var removed = await BoardMemberApiService.DeleteAsync(
                selectedBoard.Id,
                member.UserId);
            if (!removed)
            {
                memberOperation.Error = "The member was not removed. The backend may require resolving task assignments first.";
                return;
            }

            pendingRemovalUserId = null;
            var page = boardMembers.Data?.Items.Count == 1 && boardMembers.CurrentPage > 1
                ? boardMembers.CurrentPage - 1
                : boardMembers.CurrentPage;
            await LoadBoardMembersAsync(boardDetailsVersion, selectedBoard.Id, page);
        }
        catch (HttpRequestException)
        {
            memberOperation.Error = "The board member service could not be reached. Membership was not confirmed as removed.";
        }
        finally
        {
            boardFormOperation.IsSubmitting = false;
        }
    }


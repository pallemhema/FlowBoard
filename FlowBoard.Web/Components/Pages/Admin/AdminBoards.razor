    private async Task LoadMemberCandidatesAsync(int page)
    {
        var requestVersion = ++memberCandidateRequestVersion;
        memberCandidates.Data = null;
        memberCandidates.Error = null;
        var search = NormalizeSearch(memberCandidateSearch);
        if (search is null || search.Length < 2)
        {
            memberCandidates.IsLoading = false;
            return;
        }

        memberCandidates.IsLoading = true;
        try
        {
            var response = await UserDirectoryApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = DirectoryPageSize,
                    Search = search
                });
            if (requestVersion != memberCandidateRequestVersion)
            {
                return;
            }

            if (response is null)
            {
                memberCandidates.Error = "User search could not be completed. Confirm your access and retry.";
                return;
            }

            memberCandidates.Data = response;
        }
        catch (HttpRequestException)
        {
            if (requestVersion == memberCandidateRequestVersion)
            {
                memberCandidates.Error = "The user directory could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == memberCandidateRequestVersion)
            {
                memberCandidates.Error = "The user directory returned an invalid response.";
            }
        }
        finally
        {
            if (requestVersion == memberCandidateRequestVersion)
            {
                memberCandidates.IsLoading = false;
            }
        }
    }

    private Task RetryMemberCandidatesAsync() =>
        LoadMemberCandidatesAsync(memberCandidates.CurrentPage);
    private Task LoadMemberCandidatePageAsync(int page) => LoadMemberCandidatesAsync(page);

    private async Task AddBoardMemberAsync(UserDirectoryResponse candidate)
    {
        if (boardDetails is null || boardFormOperation.IsSubmitting)
        {
            return;
        }

        memberOperation.Error = null;
        if (candidate.UserId == boardDetails.OwnerId)
        {
            ToastService.Warning("The board owner is already represented by the board's Owner role.");
            return;
        }

        if (boardMembers.Data?.Items.Any(member => member.UserId == candidate.UserId) == true)
        {
            ToastService.Warning("This user is already a member of the board.");
            return;
        }

        boardFormOperation.IsSubmitting = true;
        try
        {
            var added = await BoardMemberApiService.AddAsync(
                boardDetails.Id,
                new AddBoardMemberRequest
                {
                    UserId = candidate.UserId,
                    Role = newMemberRole
                });
            if (added is null)
            {
                memberOperation.Error = "The member was not added. The backend accepts only eligible Employees and prevents duplicate membership.";
                return;
            }

            await LoadBoardMembersAsync(boardDetailsVersion, boardDetails.Id, 1);
        }
        catch (HttpRequestException)
        {
            memberOperation.Error = "The board member service could not be reached. Membership was not confirmed.";
        }
        catch (JsonException)
        {
            memberOperation.Error = "The board member service returned an invalid response. Refresh members to confirm the result.";
        }
        finally
        {
            boardFormOperation.IsSubmitting = false;
        }
    }

    private async Task UpdateBoardMemberRoleAsync(BoardMemberResponse member, ChangeEventArgs args)
    {
        if (!Enum.TryParse<BoardMemberRole>(args.Value?.ToString(), out var role) ||
            role is not (BoardMemberRole.Viewer or BoardMemberRole.Editor))
        {
            memberOperation.Error = "Select a supported board member role.";
            return;
        }

        if (selectedBoard is null || boardFormOperation.IsSubmitting || role == member.Role)
        {
            return;
        }

        boardFormOperation.IsSubmitting = true;
        memberOperation.Error = null;
        try
        {
            var updated = await BoardMemberApiService.UpdateRoleAsync(
                selectedBoard.Id,
                member.UserId,
                new UpdateBoardMemberRoleRequest { Role = role });
            if (!updated)
            {
                memberOperation.Error = "The role was not updated. The Owner role is managed separately from board membership.";
                return;
            }

            member.Role = role;
        }
        catch (HttpRequestException)
        {
            memberOperation.Error = "The board member service could not be reached. The role change was not confirmed.";
        }
    }


                        PageSize = RelatedResourcePageSize
                    });

                if (firstPage is null)
                {
                    if (selectedWorkspace?.Id == workspaceId)
                    {
                        projects = null;
                        projectsLoad.Error =
                            "Associated projects could not be loaded.";
                    }

                    return;
                }

                var result = firstPage.Items.ToList();

                for (var page = 2; page <= firstPage.TotalPages; page++)
                {
                    var response = await ProjectApiService.GetAsync(
                        new ProjectQueryRequest
                        {
                            WorkspaceId = workspaceId,
                            Page = page,
                            PageSize = RelatedResourcePageSize
                        });

                    if (response is null)
                    {
                        if (selectedWorkspace?.Id == workspaceId)
                        {
                            projects = null;
                            projectsLoad.Error =
                                "The project list could not be fully loaded. Partial results are withheld.";
                        }

                        return;
                    }

                    result.AddRange(response.Items);
                }

                if (selectedWorkspace?.Id == workspaceId)
                {
                    projects = result;
                }
            }
            catch (HttpRequestException)
            {
                if (selectedWorkspace?.Id == workspaceId)
                {
                    projects = null;
                    projectsLoad.Error =
                        "The project service could not be reached.";
                }
            }
            catch (JsonException)
            {
                if (selectedWorkspace?.Id == workspaceId)
                {
                    projects = null;
                    projectsLoad.Error =
                        "The project service returned an invalid response.";
                }
            }
            finally
            {
                if (selectedWorkspace?.Id == workspaceId)
                {
                    projectsLoad.IsLoading = false;
                }
            }

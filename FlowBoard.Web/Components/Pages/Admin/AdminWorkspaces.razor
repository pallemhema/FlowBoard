private void OpenEditForm(WorkspaceResponse workspace)
{
    editingWorkspaceId = workspace.Id;

    workspaceForm = new CreateWorkspaceRequest
    {
        Name = workspace.Name,
        Description = workspace.Description
    };

    workspaceFormOperation.Error = null;
    isEditingWorkspace = true;
    showWorkspaceForm = true;
}
private void CloseWorkspaceForm()
{
    if (workspaceFormOperation.IsSubmitting)
        return;

    showWorkspaceForm = false;
    workspaceFormOperation.Error = null;
    editingWorkspaceId = null;
}
private async Task SaveWorkspaceAsync()
{
    if (workspaceFormOperation.IsSubmitting)
        return;

    workspaceFormOperation.IsSubmitting = true;
    workspaceFormOperation.Error = null;

    try
    {
        if (isEditingWorkspace)
        {
            if (!editingWorkspaceId.HasValue)
            {
                workspaceFormOperation.Error =
                    "Select a workspace to edit.";
                return;
            }

            var updated = await WorkspaceApiService.UpdateAsync(
                editingWorkspaceId.Value,
                new UpdateWorkspaceRequest
                {
                    Name = workspaceForm.Name,
                    Description = workspaceForm.Description
                });

            if (updated is null)
            {
                workspaceFormOperation.Error =
                    "The workspace was not updated. Check your access and retry.";
                return;
            }

            selectedWorkspace = updated;
            showWorkspaceForm = false;
            editingWorkspaceId = null;

            await LoadWorkspacesAsync(workspaceList.CurrentPage);
            await LoadWorkspaceDetailsAsync(updated);
        }
        else
        {
            var created = await WorkspaceApiService.CreateAsync(workspaceForm);

            if (created is null)
            {
                workspaceFormOperation.Error =
                    "The workspace was not created. Check your access and retry.";
                return;
            }

            showWorkspaceForm = false;

            await LoadWorkspacesAsync(1);
            await OpenWorkspaceDetailsAsync(created);
        }
    }
    catch (HttpRequestException)
    {
        workspaceFormOperation.Error =
            "The workspace service could not be reached.";
    }
    catch (JsonException)
    {
        workspaceFormOperation.Error =
            "The workspace service returned an invalid response.";
    }
    finally
    {
        workspaceFormOperation.IsSubmitting = false;
    }
}

    private async Task OpenWorkspaceDetailsAsync(WorkspaceResponse workspace)
    {
        selectedWorkspace = workspace;
        await LoadWorkspaceDetailsAsync(workspace);
    }


private async Task LoadWorkspaceDetailsAsync(WorkspaceResponse workspace)
{
    selectedWorkspace = workspace;


    // Reset members
    allMembers = null;
    membersLoad.Error = null;
    membersLoad.IsLoading = false;
    memberOperation.Error = null;

    // Reset related resources
    blockingBoardMemberships = null;

    projects = null;
    projectsLoad.Error = null;
    projectsLoad.IsLoading = false;

    directBoards = null;
    boardsLoad.Error = null;
    boardsLoad.IsLoading = false;

    // Reset candidates
    candidateSearchDebounce.Cancel();
    candidateSearch = null;
    candidateList.Data = null;
    candidateList.Error = null;
    candidateList.CurrentPage = 1;
    candidateList.IsLoading = false;

    // Reset member filters and pagination
    memberSearch = null;
    memberListPage = 1;
    pendingRemovalUserId = null;

    
    
    await Task.WhenAll(
            LoadMembersAsync(),
            LoadProjectsAsync(workspace.Id),
            LoadDirectBoardsAsync(workspace.Id),
            LoadCandidatesAsync(1));
    
   
}
private void CloseWorkspaceDetails()
{
    selectedWorkspace = null;

    allMembers = null;
    membersLoad.Error = null;

    candidateSearchDebounce.Cancel();
    candidateList.Data = null;
    candidateList.Error = null;
    candidateList.IsLoading = false;

    projects = null;
    projectsLoad.Error = null;

    directBoards = null;
    boardsLoad.Error = null;

    pendingRemovalUserId = null;

    // Invalidate any candidate request still in progress.
    candidateRequestVersion++;
}

    private async Task LoadMembersAsync()
    {
        if (selectedWorkspace is null)
            return;

        var workspaceId = selectedWorkspace.Id;

        membersLoad.IsLoading = true;
        membersLoad.Error = null;

        try
        {
            var firstPage = await WorkspaceApiService.GetMembersAsync(
                workspaceId,
                new PagedSearchRequest
                {
                    Page = 1,
                    PageSize = RelatedResourcePageSize
                });

            if (firstPage is null)
            {
                if (selectedWorkspace?.Id == workspaceId)
                {
                    allMembers = null;
                    membersLoad.Error =
                        "Workspace members could not be loaded. Confirm your access and retry.";
                }

                return;
            }

            var members = firstPage.Items.ToList();

            for (var page = 2; page <= firstPage.TotalPages; page++)
            {
                var response = await WorkspaceApiService.GetMembersAsync(
                    workspaceId,
                    new PagedSearchRequest
                    {
                        Page = page,
                        PageSize = RelatedResourcePageSize
                    });

                if (response is null)
                {
                    if (selectedWorkspace?.Id == workspaceId)
                    {
                        allMembers = null;
                        membersLoad.Error =
                            "Workspace memberships could not be fully loaded. Results are withheld to avoid partial membership details.";
                    }

                    return;
                }

                members.AddRange(response.Items);
            }

            if (selectedWorkspace?.Id == workspaceId)
            {
                allMembers = members;
                memberListPage = Math.Clamp(memberListPage, 1, memberPageCount);
            }
        }
        catch (HttpRequestException)
        {
            if (selectedWorkspace?.Id == workspaceId)
            {
                allMembers = null;
                membersLoad.Error =
                    "The workspace member service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (selectedWorkspace?.Id == workspaceId)
            {
                allMembers = null;
                membersLoad.Error =
                    "The workspace member service returned an invalid response.";
            }
        }
        finally
        {
            if (selectedWorkspace?.Id == workspaceId)
            {
                membersLoad.IsLoading = false;
            }
        }
    }

    private async Task LoadProjectsAsync(Guid workspaceId)

    private void OpenEditForm(WorkspaceResponse workspace)
    {
        editingWorkspaceId = workspace.Id;
        workspaceForm = new CreateWorkspaceRequest
        {
            Name = workspace.Name,
            Description = workspace.Description
        };
        workspaceFormError = null;

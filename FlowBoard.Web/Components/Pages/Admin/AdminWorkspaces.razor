    private async Task LoadCandidatesAsync(int page)
    {
        if (selectedWorkspace is null)
        {
            return;
        }

        var workspaceId = selectedWorkspace.Id;
        var version = ++candidateRequestVersion;
        candidatePage = page;
        isLoadingCandidates = true;
        candidateError = null;
        try
        {
            var response = await UserDirectoryApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = CandidatePageSize,
                    Search = string.IsNullOrWhiteSpace(candidateSearch) ? null : candidateSearch
                });
            if (version != candidateRequestVersion || selectedWorkspace?.Id != workspaceId)
            {
                return;
            }

            if (response is null)
            {
                candidates = null;
                candidateError = "The account directory could not be loaded. Confirm your Admin access and retry.";
                return;
            }

            candidates = response;
        }
        catch (HttpRequestException)
        {
            if (version == candidateRequestVersion)
            {
                candidates = null;
                candidateError = "The account directory could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == candidateRequestVersion)
            {
                candidates = null;
                candidateError = "The account directory returned an invalid response.";
            }
        }
        finally
        {
            if (version == candidateRequestVersion)
            {
                isLoadingCandidates = false;
            }
        }
    }

    private async Task AddMemberAsync(UserDirectoryResponse candidate)
    {
        if (selectedWorkspace is null || isSubmitting)
        {
            return;
        }

        var workspace = selectedWorkspace;
        memberOperationError = null;
        if (workspace.OwnerId == candidate.UserId)
        {
            ToastService.Warning("The workspace owner is not managed as a workspace member.");
            return;
        }

        if (allMembers?.Any(member => member.UserId == candidate.UserId) == true)
        {
            ToastService.Warning("This account is already a workspace member.");
            return;
        }

        isSubmitting = true;
        try
        {
            var added = await WorkspaceApiService.AddMemberAsync(
                workspace.Id,
                new AddWorkspaceMemberRequest { UserId = candidate.UserId });
            if (added is null)
            {
                memberOperationError = "Membership was not added. Confirm the account is eligible and retry.";
                return;
            }

            await LoadMembersAsync();
        }
        catch (HttpRequestException)
        {
            memberOperationError = "The workspace service could not be reached. Membership was not confirmed.";
        }
        catch (JsonException)
        {
            memberOperationError = "The workspace service returned an invalid response. Refresh membership to confirm the result.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Task HandleMemberSearchChanged(string? value)
    {
        memberSearch = value?.Trim();
        memberListPage = 1;
        return Task.CompletedTask;
    }

    private void PreviousMemberPage()
    {
        if (memberListPage > 1)
        {
            memberListPage--;
        }
    }

    private void NextMemberPage()
    {
        if (memberListPage < memberPageCount)
        {
            memberListPage++;
        }
    }

    private void RequestMemberRemoval(Guid userId)
    {
        pendingRemovalUserId = userId;
    }

    private void CancelMemberRemoval()
    {
        if (!isSubmitting)
        {
            pendingRemovalUserId = null;
        }
    }

    private async Task RemoveMemberAsync(WorkspaceMemberResponse member)
    {
        if (selectedWorkspace is null || isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        memberOperationError = null;
        try
        {
            var removed = await WorkspaceApiService.RemoveMemberAsync(
                selectedWorkspace.Id,
                member.UserId);
            if (!removed)
            {
                memberOperationError = "Membership was not removed. The API may require related board access or task dependencies to be resolved first.";
                return;
            }

            pendingRemovalUserId = null;
            await LoadMembersAsync();
        }
        catch (HttpRequestException)
        {
            memberOperationError = "The workspace service could not be reached. Membership was not confirmed as removed.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void RequestWorkspaceDeletion(WorkspaceResponse workspace)
    {
        workspacePendingDeletion = workspace;
        deleteWorkspaceError = null;
    }

    private void CancelWorkspaceDeletion()
    {
        if (!isSubmitting)
        {
            workspacePendingDeletion = null;
            deleteWorkspaceError = null;
        }
    }

    private async Task DeleteWorkspaceAsync()
    {
        if (workspacePendingDeletion is null || isSubmitting)
        {
            return;
        }

        var workspace = workspacePendingDeletion;
        isSubmitting = true;
        deleteWorkspaceError = null;
        try
        {
            var deleted = await WorkspaceApiService.DeleteAsync(workspace.Id);
            if (!deleted)
            {
                deleteWorkspaceError = "The workspace was not deleted. Existing projects, boards, or members may block deletion; none were removed.";
                return;
            }

            workspacePendingDeletion = null;
            if (selectedWorkspace?.Id == workspace.Id)
            {
                CloseWorkspaceDetails();
            }

            var targetPage = workspacePage?.Items.Count == 1 && currentWorkspacePage > 1
                ? currentWorkspacePage - 1
                : currentWorkspacePage;
            await LoadWorkspacesAsync(targetPage);
        }
        catch (HttpRequestException)
        {
            deleteWorkspaceError = "The workspace service could not be reached. The workspace was not deleted.";
        }
        catch (JsonException)
        {
            deleteWorkspaceError = "The workspace service returned an invalid response. Refresh the list to confirm the result.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static bool Matches(string value, string? search) =>
        string.IsNullOrWhiteSpace(search) ||
        value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string GetFullName(string firstName, string lastName)
    {
        var fullName = $"{firstName} {lastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? "Unnamed account" : fullName;
    }

    public void Dispose()
    {
        workspaceSearchDebounce?.Cancel();
        workspaceSearchDebounce?.Dispose();
        candidateSearchDebounce?.Cancel();
        candidateSearchDebounce?.Dispose();
    }

    }

    private async Task SaveWorkspaceAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        workspaceFormError = null;
        try
        {
            if (isEditingWorkspace)
            {
                if (!editingWorkspaceId.HasValue)
                {
                    workspaceFormError = "Select a workspace to edit.";
                    return;
                }

                var updated = await WorkspaceApiService.UpdateAsync(
                    editingWorkspaceId.Value,
                    new UpdateWorkspaceRequest
                    {
                        Name = workspaceForm.Name,
                        Description = workspaceForm.Description
                    });

                if (updated is null)
                {
                    workspaceFormError = "The workspace was not updated. Check your access and retry.";
                    return;
                }

                selectedWorkspace = updated;
                showWorkspaceForm = false;
                editingWorkspaceId = null;
                await LoadWorkspacesAsync(currentWorkspacePage);
                await LoadWorkspaceDetailsAsync(updated);
            }
            else
            {
                var created = await WorkspaceApiService.CreateAsync(workspaceForm);
                if (created is null)
                {
                    workspaceFormError = "The workspace was not created. Check your access and retry.";
                    return;
                }

                showWorkspaceForm = false;
                await LoadWorkspacesAsync(1);
                await OpenWorkspaceDetailsAsync(created);
            }
        }
        catch (HttpRequestException)
        {
            workspaceFormError = "The workspace service could not be reached.";
        }
        catch (JsonException)
        {
            workspaceFormError = "The workspace service returned an invalid response.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OpenWorkspaceDetailsAsync(WorkspaceResponse workspace)
    {
        selectedWorkspace = workspace;
        await LoadWorkspaceDetailsAsync(workspace);
    }

    private async Task LoadWorkspaceDetailsAsync(WorkspaceResponse workspace)
    {
        selectedWorkspace = workspace;
        allMembers = null;
        membersError = null;
        memberOperationError = null;
        projects = null;
        projectsError = null;
        directBoards = null;
        boardsError = null;
        candidates = null;
        candidateError = null;
        candidateSearchDebounce?.Cancel();
        candidateSearch = null;
        candidatePage = 1;
        memberSearch = null;
        memberListPage = 1;
        pendingRemovalUserId = null;

        await Task.WhenAll(
            LoadMembersAsync(),
            LoadProjectsAsync(workspace.Id),
            LoadDirectBoardsAsync(workspace.Id),
            LoadCandidatesAsync(1));
    }

    private void CloseWorkspaceDetails()
    {
        selectedWorkspace = null;
        allMembers = null;
        candidates = null;
        projects = null;
        directBoards = null;
        pendingRemovalUserId = null;
        candidateSearchDebounce?.Cancel();
        candidateRequestVersion++;
    }

    private async Task LoadMembersAsync()
    {
        if (selectedWorkspace is null)
        {
            return;
        }

        var workspaceId = selectedWorkspace.Id;
        isLoadingMembers = true;
        membersError = null;
        try
        {
            var firstPage = await WorkspaceApiService.GetMembersAsync(
                workspaceId,
                new PagedSearchRequest { Page = 1, PageSize = RelatedResourcePageSize });
            if (firstPage is null)
            {
                if (selectedWorkspace?.Id == workspaceId)
                {
                    allMembers = null;
                    membersError = "Workspace members could not be loaded. Confirm your access and retry.";
                }
                return;
            }

            var members = firstPage.Items.ToList();
            for (var page = 2; page <= firstPage.TotalPages; page++)
            {
                var response = await WorkspaceApiService.GetMembersAsync(
                    workspaceId,
                    new PagedSearchRequest { Page = page, PageSize = RelatedResourcePageSize });
                if (response is null)
                {
                    if (selectedWorkspace?.Id == workspaceId)
                    {
                        allMembers = null;
                        membersError = "Workspace memberships could not be fully loaded. Results are withheld to avoid partial membership details.";
                    }
                    return;
                }

                members.AddRange(response.Items);
            }

            if (selectedWorkspace?.Id == workspaceId)
            {
                allMembers = members;
            }
        }
        catch (HttpRequestException)
        {
            if (selectedWorkspace?.Id == workspaceId)
            {
                allMembers = null;
                membersError = "The workspace member service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (selectedWorkspace?.Id == workspaceId)
            {
                allMembers = null;
                membersError = "The workspace member service returned an invalid response.";
            }
        }
        finally
        {
            if (selectedWorkspace?.Id == workspaceId)
            {
                isLoadingMembers = false;
            }
        }
    }


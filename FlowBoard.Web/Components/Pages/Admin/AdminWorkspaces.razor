    private Task HandleCandidateSearchChanged(string? value)
    {
        candidateSearch = value?.Trim();

        var workspaceId = selectedWorkspace?.Id;

        return candidateSearchDebounce.ExecuteAsync(async () =>
        {
            if (workspaceId is null ||
                selectedWorkspace?.Id != workspaceId.Value)
            {
                return;
            }

            await LoadCandidatesAsync(1);
        });
    }


   private async Task LoadCandidatesAsync(int page)
    {
        if (selectedWorkspace is null)
            return;

        var workspaceId = selectedWorkspace.Id;
        var version = ++candidateRequestVersion;

        candidateList.CurrentPage = page;
        candidateList.IsLoading = true;
        candidateList.Error = null;

        try
        {
            var response = await UserDirectoryApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = candidateList.PageSize,
                    Search = string.IsNullOrWhiteSpace(candidateSearch)
                        ? null
                        : candidateSearch
                });

            if (version != candidateRequestVersion ||
                selectedWorkspace?.Id != workspaceId)
            {
                return;
            }

            if (response is null)
            {
                candidateList.Data = null;
                candidateList.Error =
                    "The account directory could not be loaded. Confirm your Admin access and retry.";
                return;
            }

            candidateList.Data = response;
        }
        catch (HttpRequestException)
        {
            if (version == candidateRequestVersion &&
                selectedWorkspace?.Id == workspaceId)
            {
                candidateList.Data = null;
                candidateList.Error =
                    "The account directory could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == candidateRequestVersion &&
                selectedWorkspace?.Id == workspaceId)
            {
                candidateList.Data = null;
                candidateList.Error =
                    "The account directory returned an invalid response.";
            }
        }
        finally
        {
            if (version == candidateRequestVersion &&
                selectedWorkspace?.Id == workspaceId)
            {
                candidateList.IsLoading = false;
            }
        }
    }
  private async Task AddMemberAsync(UserDirectoryResponse candidate)
{
    if (selectedWorkspace is null || memberOperation.IsSubmitting)
        return;

    var workspace = selectedWorkspace;

    memberOperation.Error = null;

    if (workspace.OwnerId == candidate.UserId)
    {
        ToastService.Warning(
            "The workspace owner is not managed as a workspace member.");
        return;
    }

    if (allMembers?.Any(member => member.UserId == candidate.UserId) == true)
    {
        ToastService.Warning(
            "This account is already a workspace member.");
        return;
    }

    memberOperation.IsSubmitting = true;

    try
    {
        var added = await WorkspaceApiService.AddMemberAsync(
            workspace.Id,
            new AddWorkspaceMemberRequest
            {
                UserId = candidate.UserId
            });

        if (added is null)
        {
            memberOperation.Error =
                "Membership was not added. Confirm the account is eligible and retry.";
            return;
        }

        await LoadMembersAsync();
    }
    catch (HttpRequestException)
    {
        memberOperation.Error =
            "The workspace service could not be reached. Membership was not confirmed.";
    }
    catch (JsonException)
    {
        memberOperation.Error =
            "The workspace service returned an invalid response. Refresh membership to confirm the result.";
    }
    finally
    {
        memberOperation.IsSubmitting = false;
    }
}

    private Task HandleMemberSearchChanged(string? value)
    {
        memberSearch = value?.Trim();
        memberListPage = 1;
        return Task.CompletedTask;
    }

    private void PreviousMemberPage()
    {
        if (memberListPage > 1)
        {
            memberListPage--;
        }
    }

    private void NextMemberPage()
    {
        if (memberListPage < memberPageCount)
        {
            memberListPage++;
        }
    }

    private void RequestMemberRemoval(Guid userId)
    {
        pendingRemovalUserId = userId;
    }

    private void CancelMemberRemoval()
    {
        if (!memberOperation.IsSubmitting)
        {
            pendingRemovalUserId = null;
        }
    }

    private async Task RemoveMemberAsync(WorkspaceMemberResponse member)
{
    if (selectedWorkspace is null || memberOperation.IsSubmitting)
        return;

    var workspace = selectedWorkspace;

    memberOperation.IsSubmitting = true;
    memberOperation.Error = null;
    blockingBoardMemberships = null;

    try
    {
        var result = await WorkspaceApiService.RemoveMemberAsync(
            workspace.Id,
            member.UserId);

        if (!result.Removed)
        {
            blockingBoardMemberships =
                result.ConflictDetails?.BlockingBoardMemberships;

            memberOperation.Error = blockingBoardMemberships is { Count: > 0 }
                ? $"Remove {GetFullName(member.User.FirstName, member.User.LastName)} from the following boards before removing them from this workspace, then retry:"
                : result.Message ??
                  "Membership was not removed. Resolve any remaining workspace dependencies, then retry.";

            return;
        }

        pendingRemovalUserId = null;

        await LoadMembersAsync();
    }
    catch (HttpRequestException)
    {
        memberOperation.Error =
            "The workspace service could not be reached. Membership was not confirmed as removed.";
    }
    finally
    {
        memberOperation.IsSubmitting = false;
    }
}

private void RequestWorkspaceDeletion(WorkspaceResponse workspace)
{
    workspacePendingDeletion = workspace;
    deleteWorkspaceOperation.Error = null;
}

private void CancelWorkspaceDeletion()
{
    if (!deleteWorkspaceOperation.IsSubmitting)
    {
        workspacePendingDeletion = null;
        deleteWorkspaceOperation.Error = null;
    }
}

   private async Task DeleteWorkspaceAsync()
{
    if (workspacePendingDeletion is null ||
        deleteWorkspaceOperation.IsSubmitting)
    {
        return;
    }

    var workspace = workspacePendingDeletion;

    deleteWorkspaceOperation.IsSubmitting = true;
    deleteWorkspaceOperation.Error = null;

    try
    {
        var deleted = await WorkspaceApiService.DeleteAsync(workspace.Id);

        if (!deleted)
        {
            deleteWorkspaceOperation.Error =
                "The workspace was not deleted. Existing projects, boards, or members may block deletion; none were removed.";
            return;
        }

        workspacePendingDeletion = null;

        if (selectedWorkspace?.Id == workspace.Id)
        {
            CloseWorkspaceDetails();
        }

        var targetPage =
            workspaceList.Data?.Items.Count == 1 &&
            workspaceList.CurrentPage > 1
                ? workspaceList.CurrentPage - 1
                : workspaceList.CurrentPage;

        await LoadWorkspacesAsync(targetPage);
    }
    catch (HttpRequestException)
    {
        deleteWorkspaceOperation.Error =
            "The workspace service could not be reached. The workspace was not deleted.";
    }
    catch (JsonException)
    {
        deleteWorkspaceOperation.Error =
            "The workspace service returned an invalid response. Refresh the list to confirm the result.";
    }
    finally
    {
        deleteWorkspaceOperation.IsSubmitting = false;
    }
}

    private static bool Matches(string value, string? search) =>
        string.IsNullOrWhiteSpace(search) ||
        value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string GetFullName(string firstName, string lastName)
    {
        var fullName = $"{firstName} {lastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? "Unnamed account" : fullName;
    }

public void Dispose()
{
    workspaceSearchDebounce.Dispose();
    candidateSearchDebounce.Dispose();
}

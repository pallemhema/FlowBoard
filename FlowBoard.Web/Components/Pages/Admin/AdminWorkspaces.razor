@page "/admin/workspaces"
@attribute [Authorize(Policy = AuthorizationPolicies.AdminOnly)]
@implements IDisposable

@inject IWorkspaceApiService WorkspaceApiService
@inject IUserDirectoryApiService UserDirectoryApiService
@inject IProjectApiService ProjectApiService
@inject IBoardApiService BoardApiService
@inject ToastService ToastService

<PageTitle>Workspace Management | FlowBoard</PageTitle>

<div class="page-shell admin-workspaces-page">
    <PageHeader Title="Workspace Management"
                Eyebrow="Administration"
                Description="Create and manage workspaces, their members, and associated resources.">
        <Actions>
            <button type="button" class="btn btn-primary" @onclick="OpenCreateForm">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Create workspace
            </button>
        </Actions>
    </PageHeader>

    @if (showWorkspaceForm)
    {
        <section class="workspace-form-panel" aria-labelledby="workspace-form-title">
            <div class="workspace-panel-heading">
                <div>
                    <p class="section-label mb-1">Workspace settings</p>
                    <h2 id="workspace-form-title">@(isEditingWorkspace ? "Edit workspace" : "Create a workspace")</h2>
                </div>
                <button type="button"
                        class="btn-close"
                        aria-label="Close workspace form"
                        disabled="@workspaceFormOperation.IsSubmitting"
                        @onclick="CloseWorkspaceForm"></button>
            </div>

            <EditForm Model="@workspaceForm" OnValidSubmit="SaveWorkspaceAsync" FormName="admin-workspace-form">
                <DataAnnotationsValidator />
                <div class="workspace-form-grid">
                    <div class="mb-3">
                        <label class="form-label" for="workspace-name">Workspace name</label>
                        <InputText id="workspace-name"
                                   class="form-control"
                                   @bind-Value="workspaceForm.Name"
                                   placeholder="e.g. Product Operations" />
                        <ValidationMessage For="@(() => workspaceForm.Name)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="workspace-description">Description <span class="text-muted fw-normal">(optional)</span></label>
                        <InputTextArea id="workspace-description"
                                       class="form-control workspace-description-input"
                                       @bind-Value="workspaceForm.Description"
                                       placeholder="What is this workspace for?" />
                        <ValidationMessage For="@(() => workspaceForm.Description)" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(workspaceFormOperation.Error))
                {
                    <div class="workspace-error compact" role="alert">@workspaceFormOperation.Error</div>
                }

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@workspaceFormOperation.IsSubmitting"
                            @onclick="CloseWorkspaceForm">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@workspaceFormOperation.IsSubmitting">
                        @(workspaceFormOperation.IsSubmitting ? "Saving..." : isEditingWorkspace ? "Save changes" : "Create workspace")
                    </button>
                </div>
            </EditForm>
        </section>
    }

<DataListPanel Title="Workspaces"
               TitleId="workspace-list-title"
               Description="Organization workspaces visible to administrators."
               CountText="@(workspaceList.Data is null ? null : $"{workspaceList.Data.TotalCount:N0} workspaces")"
               CssClass="workspace-list-panel">

    <Toolbar>
        <DataListToolBar SearchValue="@workspaceSearch"
                         SearchValueChanged="HandleWorkspaceSearchChanged"
                         SearchPlaceholder="Search by workspace name or description">
            <Actions>
                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@string.IsNullOrWhiteSpace(workspaceSearch)"
                        @onclick="ClearWorkspaceSearch">
                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i>
                    Clear search
                </button>
            </Actions>
        </DataListToolBar>
    </Toolbar>

    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(workspaceList.Error))
        {
            <div class="workspace-error" role="alert">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <span>@workspaceList.Error</span>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary ms-auto"
                        @onclick="() => LoadWorkspacesAsync(workspaceList.CurrentPage)">
                    Retry
                </button>
            </div>
        }
        else if (workspaceList.IsLoading )
        {
            <div class="workspace-loading" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm text-primary"
                      aria-hidden="true"></span>
                <span>Loading workspaces...</span>
            </div>
        }
        else if (workspaceList.Data is not null && workspaceList.Data.Items.Count == 0)
        {
            <EmptyState Title="@(string.IsNullOrWhiteSpace(workspaceSearch)
                                      ? "No workspaces yet"
                                      : "No matching workspaces")"
                        Message="@(string.IsNullOrWhiteSpace(workspaceSearch)
                                      ? "Create a workspace to organize projects and boards."
                                      : "Try another search or clear the current filter.")">
                @if (string.IsNullOrWhiteSpace(workspaceSearch))
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="OpenCreateForm">
                        Create your first workspace
                    </button>
                }
            </EmptyState>
        }
        else if (workspaceList.Data is not null)
        {
            <DataTable TItem="WorkspaceResponse"
                       Items="@workspaceList.Data.Items"
                       Columns="@WorkspaceColumns"
                       ItemKeySelector="workspace => workspace.Id"
                       CssClass="table align-middle">

                <MobileTemplate Context="workspace">
                    <article class="workspace-mobile-card">
                        <div class="workspace-mobile-heading">
                            <span class="workspace-avatar" aria-hidden="true">
                                <i class="bi bi-grid"></i>
                            </span>

                            <div class="workspace-name-copy">
                                <strong>@workspace.Name</strong>
                                <small>
                                    @(string.IsNullOrWhiteSpace(workspace.Description)
                                        ? "No description"
                                        : workspace.Description)
                                </small>
                            </div>
                        </div>

                        <dl class="workspace-mobile-meta">
                            <div>
                                <dt>Owner</dt>
                                <dd>
                                    <WorkspaceOwner OwnerName="@workspace.OwnerName"
                                                    OwnerEmail="@workspace.OwnerEmail"
                                                    SizeRem="1.75" />
                                </dd>
                            </div>
                            <div>
                                <dt>Created</dt>
                                <dd>@workspace.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</dd>
                            </div>
                            <div>
                                <dt>Updated</dt>
                                <dd>
                                    @(workspace.ModifiedAt?.ToLocalTime().ToString("MMM d, yyyy") ?? "—")
                                </dd>
                            </div>
                        </dl>

                        <div class="workspace-mobile-actions">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenWorkspaceDetailsAsync(workspace)">
                                Details
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => OpenEditForm(workspace)">
                                Edit
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="() => RequestWorkspaceDeletion(workspace)">
                                Delete
                            </button>
                        </div>
                    </article>
                </MobileTemplate>
            </DataTable>

            <Pagination CurrentPage="@workspaceList.Data.Page"
                        TotalPages="@workspaceList.Data.TotalPages"
                        TotalCount="@workspaceList.Data.TotalCount"
                        PageSize="@workspaceList.Data.PageSize"
                        PageChanged="LoadWorkspacesAsync" />
        }
    </ChildContent>
</DataListPanel>
    @if (selectedWorkspace is not null)
    {
        <section class="workspace-details-panel" aria-labelledby="workspace-details-title">
            <div class="workspace-details-header">
                <div class="workspace-details-identity">
                    <span class="workspace-avatar workspace-avatar-large" aria-hidden="true"><i class="bi bi-grid"></i></span>
                    <div>
                        <p class="section-label mb-1">Workspace details</p>
                        <h2 id="workspace-details-title">@selectedWorkspace.Name</h2>
                        <p>@(string.IsNullOrWhiteSpace(selectedWorkspace.Description) ? "No description provided." : selectedWorkspace.Description)</p>
                    </div>
                </div>
                <button type="button"
                        class="btn-close"
                        aria-label="Close workspace details"
                        @onclick="CloseWorkspaceDetails"></button>
            </div>

            <dl class="workspace-facts">
                <div>
                    <dt>Owner</dt>
                    <dd>
                        <WorkspaceOwner OwnerName="@selectedWorkspace.OwnerName"
                                        OwnerEmail="@selectedWorkspace.OwnerEmail"
                                        SizeRem="1.75" />
                    </dd>
                </div>
                <div><dt>Created</dt><dd>@selectedWorkspace.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</dd></div>
                @if (selectedWorkspace.ModifiedAt.HasValue)
                {
                    <div><dt>Updated</dt><dd>@selectedWorkspace.ModifiedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</dd></div>
                }
            </dl>

            <div class="workspace-resource-grid">
                <section class="workspace-resource-section" aria-labelledby="workspace-projects-title">
                    <div class="workspace-subsection-heading">
                        <div>
                            <h3 id="workspace-projects-title">Projects</h3>
                            <p>Projects belonging to this workspace.</p>
                        </div>
                        @if (projects is not null)
                        {
                            <span class="workspace-resource-count">@projects.Count.ToString("N0")</span>
                        }
                    </div>
                    @if (projectsLoad.IsLoading)
                    {
                        <div class="workspace-inline-loading" role="status"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Loading projects...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(projectsLoad.Error))
                    {
                        <div class="workspace-error compact" role="alert">
                            <span>@projectsLoad.Error</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => LoadProjectsAsync(selectedWorkspace.Id)">Retry</button>
                        </div>
                    }
                    else if (projects is { Count: 0 })
                    {
                        <EmptyState Title="No projects" Message="No projects are associated with this workspace." />
                    }
                    else if (projects is not null)
                    {
                        <div class="workspace-resource-list">
                            @foreach (var project in projects)
                            {
                                <article class="workspace-resource-row" @key="project.ProjectId">
                                    <span class="workspace-resource-icon project-resource-icon" aria-hidden="true"><i class="bi bi-kanban"></i></span>
                                    <span class="workspace-resource-copy">
                                        <strong>@project.Name</strong>
                                        <small>@project.Status</small>
                                    </span>
                                    <span class="workspace-resource-date">@project.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                </article>
                            }
                        </div>
                    }
                </section>

                <section class="workspace-resource-section" aria-labelledby="workspace-boards-title">
                    <div class="workspace-subsection-heading">
                        <div>
                            <h3 id="workspace-boards-title">Workspace boards</h3>
                            <p>General or Learning boards directly under this workspace.</p>
                        </div>
                        @if (directBoards is not null)
                        {
                            <span class="workspace-resource-count">@directBoards.Count.ToString("N0")</span>
                        }
                    </div>
                    @if (boardsLoad.IsLoading)
                    {
                        <div class="workspace-inline-loading" role="status"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Loading boards...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(boardsLoad.Error))
                    {
                        <div class="workspace-error compact" role="alert">
                            <span>@boardsLoad.Error</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => LoadDirectBoardsAsync(selectedWorkspace.Id)">Retry</button>
                        </div>
                    }
                    else if (directBoards is { Count: 0 })
                    {
                        <EmptyState Title="No direct boards" Message="No boards are attached directly to this workspace." />
                    }
                    else if (directBoards is not null)
                    {
                        <div class="workspace-resource-list">
                            @foreach (var board in directBoards)
                            {
                                <article class="workspace-resource-row" @key="board.Id">
                                    <span class="workspace-resource-icon board-resource-icon" aria-hidden="true"><i class="bi bi-columns-gap"></i></span>
                                    <span class="workspace-resource-copy">
                                        <strong>@board.Name</strong>
                                        <small>@board.Purpose</small>
                                    </span>
                                    <span class="workspace-resource-date">@board.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                </article>
                            }
                        </div>
                    }
                </section>
            </div>

            <section class="workspace-members-section" aria-labelledby="workspace-members-title">
                <div class="workspace-subsection-heading">
                    <div>
                        <h3 id="workspace-members-title">Workspace members</h3>
                        <p>Membership here does not grant project or board membership.</p>
                    </div>
                    @if (allMembers is not null)
                    {
                        <span class="workspace-resource-count">@allMembers.Count.ToString("N0")</span>
                    }
                </div>

                <div class="workspace-members-grid">
                    <div class="workspace-member-management">
                        <label class="form-label">Find an account to add</label>
                        <SearchBox Value="@candidateSearch"
                                   ValueChanged="HandleCandidateSearchChanged"
                                   Placeholder="Search by name or email" />
                        @if (!string.IsNullOrWhiteSpace(memberOperation.Error))
                        {
                            <div class="workspace-error compact" role="alert">
                                <span>@memberOperation.Error</span>
                                @if (blockingBoardMemberships is { Count: > 0 })
                                {
                                    <ul class="mb-0 mt-2">
                                        @foreach (var board in blockingBoardMemberships)
                                        {
                                            <li><strong>@board.BoardName</strong> (Board role: @board.Role)</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        @if (candidateList.IsLoading)
                        {
                            <div class="workspace-inline-loading" role="status"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Searching accounts...</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(candidateList.Error))
                        {
                            <div class="workspace-error compact" role="alert">
                                <span>@candidateList.Error</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => LoadCandidatesAsync(candidateList.CurrentPage)">Retry</button>
                            </div>
                        }
                        else if (candidateList.Data is { Items.Count: 0 })
                        {
                            <p class="workspace-empty-hint">No accounts match this search.</p>
                        }
                        else if (candidateList.Data is not null)
                        {
                            <div class="workspace-candidate-list">
                                @foreach (var candidate in candidateList.Data.Items)
                                {
                                    var isOwner = selectedWorkspace.OwnerId == candidate.UserId;
                                    var isMember = allMembers?.Any(member => member.UserId == candidate.UserId) == true;
                                    <div class="workspace-person-row" @key="candidate.UserId">
                                        <UserAvatar FirstName="@candidate.FirstName" LastName="@candidate.LastName" />
                                        <span class="workspace-person-copy">
                                            <strong>@GetFullName(candidate.FirstName, candidate.LastName)</strong>
                                            <small>@candidate.Email</small>
                                        </span>
                                        @if (isOwner)
                                        {
                                            <span class="workspace-owner-badge">Owner</span>
                                        }
                                        else if (isMember)
                                        {
                                            <span class="workspace-member-badge">Member</span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    disabled="@memberOperation.IsSubmitting"
                                                    @onclick="() => AddMemberAsync(candidate)">
                                                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <Pagination CurrentPage="@candidateList.Data.Page"
                                        TotalPages="@candidateList.Data.TotalPages"
                                        TotalCount="@candidateList.Data.TotalCount"
                                        PageSize="@candidateList.Data.PageSize"
                                        PageChanged="LoadCandidatesAsync" />
                        }
                    </div>

                    <div class="workspace-current-members">
                        <div class="workspace-member-filter">
                            <label class="form-label" for="workspace-member-filter">Current members</label>
                            <SearchBox Value="@memberSearch"
                                       ValueChanged="HandleMemberSearchChanged"
                                       Placeholder="Filter workspace members" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(membersLoad.Error))
                        {
                            <div class="workspace-error compact" role="alert">
                                <span>@membersLoad.Error</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => LoadMembersAsync()">Retry</button>
                            </div>
                        }
                        else if ( membersLoad.IsLoading)
                        {
                            <div class="workspace-inline-loading" role="status"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Loading members...</div>
                        }
                        else if (filteredMembers.Count == 0)
                        {
                            <EmptyState Title="@(allMembers?.Count == 0 ? "No workspace members" : "No matching members")"
                                        Message="@(allMembers?.Count == 0 ? "Add an account to create the first workspace membership." : "Try another name or email address.")" />
                        }
                        else
                        {
                            <div class="workspace-current-member-list">
                                @foreach (var member in pagedMembers)
                                {
                                    <div class="workspace-person-row" @key="member.UserId">
                                        <UserAvatar FirstName="@member.User.FirstName" LastName="@member.User.LastName" />
                                        <span class="workspace-person-copy">
                                            <strong>@GetFullName(member.User.FirstName, member.User.LastName)</strong>
                                            <small>@member.User.Email</small>
                                        </span>
                                        <span class="workspace-joined-date">@member.JoinedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                        @if (pendingRemovalUserId == member.UserId)
                                        {
                                            <span class="workspace-remove-confirm">
                                                <span>Remove?</span>
                                                <button type="button" class="btn btn-sm btn-danger" disabled="@memberOperation.IsSubmitting" @onclick="() => RemoveMemberAsync(member)">Confirm</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@memberOperation.IsSubmitting" @onclick="CancelMemberRemoval">Cancel</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    aria-label="@($"Remove {member.User.FirstName} {member.User.LastName} from workspace")"
                                                    disabled="@(selectedWorkspace.OwnerId == member.UserId || memberOperation.IsSubmitting)"
                                                    @onclick="() => RequestMemberRemoval(member.UserId)">
                                                Remove
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="workspace-local-pagination">
                                <span>Showing @memberRangeStart-@memberRangeEnd of @filteredMembers.Count</span>
                                @if (filteredMembers.Count > MemberPageSize)
                                {
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Workspace member pages">
                                        <button type="button" class="btn btn-outline-secondary" disabled="@(memberListPage <= 1)" aria-label="Previous member page" @onclick="PreviousMemberPage">Previous</button>
                                        <button type="button" class="btn btn-outline-secondary" disabled="@(memberListPage >= memberPageCount)" aria-label="Next member page" @onclick="NextMemberPage">Next</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        </section>
    }

    <ConfirmationDialog IsOpen="@(workspacePendingDeletion is not null)"
                        Title="@(workspacePendingDeletion is null ? string.Empty : $"Delete {workspacePendingDeletion.Name}?")"
                        ConfirmText="Delete workspace"
                        ConfirmingText="Deleting..."
                        IsBusy="@deleteWorkspaceOperation.IsSubmitting"
                        OnCancel="CancelWorkspaceDeletion"
                        OnConfirm="DeleteWorkspaceAsync">
        @if (!string.IsNullOrWhiteSpace(deleteWorkspaceOperation.Error))
        {
            <div class="workspace-error compact" role="alert">@deleteWorkspaceOperation.Error</div>
        }
    </ConfirmationDialog>
</div>

@code {
    private const int WorkspacePageSize = PageSizeDefaults.Default;
    private const int RelatedResourcePageSize = PageSizeDefaults.Resource;
    private const int MemberPageSize = PageSizeDefaults.Default;
    private const int CandidatePageSize = PageSizeDefaults.Default;

   
    // Workspace list
    private PagedListState<WorkspaceResponse> workspaceList = new()
    {
        PageSize = WorkspacePageSize,
        IsLoading = true
    };

    // Selected workspace
    private WorkspaceResponse? selectedWorkspace;
    private WorkspaceResponse? workspacePendingDeletion;
    private Guid? editingWorkspaceId;

    // Workspace form
    private CreateWorkspaceRequest workspaceForm = new();
    private bool showWorkspaceForm;
    private bool isEditingWorkspace;

    // Candidate list
    private PagedListState<UserDirectoryResponse> candidateList = new()
    {
        PageSize = CandidatePageSize
    };

    // Workspace members and related resources
    private List<WorkspaceMemberResponse>? allMembers;
    private List<ProjectResponse>? projects;
    private List<BoardResponse>? directBoards;

    private IReadOnlyList<WorkspaceBoardMembershipDetails>? blockingBoardMemberships;

    // Search
    private string? workspaceSearch;
    private string? candidateSearch;
    private string? memberSearch;

    // Local pagination
    private int memberListPage = 1;

    // Member actions
    private Guid? pendingRemovalUserId;

    // Async operations
    private AsyncOperationState workspaceFormOperation = new();
    private AsyncOperationState membersLoad = new();
    private AsyncOperationState memberOperation = new();
    private AsyncOperationState projectsLoad = new();
    private AsyncOperationState boardsLoad = new();
    private AsyncOperationState deleteWorkspaceOperation = new();

    // Request versioning
    private long workspaceRequestVersion;
    private long candidateRequestVersion;

    // Debouncing
    private readonly DebouncedAction workspaceSearchDebounce = new();
    private readonly DebouncedAction candidateSearchDebounce = new();
    private IReadOnlyList<DataTableColumn<WorkspaceResponse>> WorkspaceColumns =>
[
    new()
    {
        Header = "Workspace",
        Template = workspace => @<div class="workspace-name-cell">
            <span class="workspace-avatar" aria-hidden="true">
                <i class="bi bi-grid"></i>
            </span>
            <span class="workspace-name-copy">
                <strong>@workspace.Name</strong>
                <small>
                    @(string.IsNullOrWhiteSpace(workspace.Description)
                        ? "No description"
                        : workspace.Description)
                </small>
            </span>
        </div>
    },
    new()
    {
        Header = "Owner",
        Template = workspace => @<WorkspaceOwner
            OwnerName="@workspace.OwnerName"
            OwnerEmail="@workspace.OwnerEmail"
            SizeRem="1.75" />
    },
    new()
    {
        Header = "Created",
        Template = workspace => @<span class="workspace-date-cell">
            @workspace.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
        </span>
    },
    new()
    {
        Header = "Updated",
        Template = workspace => @<span class="workspace-date-cell">
            @(workspace.ModifiedAt?.ToLocalTime().ToString("MMM d, yyyy") ?? "—")
        </span>
    },
    new()
    {
        Header = "Actions",
        HeaderClass = "text-end",
        CellClass = "text-end",
        Template = workspace => @<div class="workspace-actions-cell">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    @onclick="() => OpenWorkspaceDetailsAsync(workspace)">
                <i class="bi bi-eye me-1" aria-hidden="true"></i>
                Details
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    aria-label="@($"Edit {workspace.Name}")"
                    @onclick="() => OpenEditForm(workspace)">
                <i class="bi bi-pencil" aria-hidden="true"></i>
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    aria-label="@($"Delete {workspace.Name}")"
                    @onclick="() => RequestWorkspaceDeletion(workspace)">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </div>
    }
];

    private List<WorkspaceMemberResponse> filteredMembers => (allMembers ?? [])
        .Where(member => Matches(
            $"{member.User.FirstName} {member.User.LastName} {member.User.Email}",
            memberSearch))
        .ToList();

    private List<WorkspaceMemberResponse> pagedMembers => filteredMembers
        .Skip((memberListPage - 1) * MemberPageSize)
        .Take(MemberPageSize)
        .ToList();

    private int memberPageCount => Math.Max(
        1,
        (int)Math.Ceiling(filteredMembers.Count / (double)MemberPageSize));
    private int memberRangeStart => filteredMembers.Count == 0
        ? 0
        : (memberListPage - 1) * MemberPageSize + 1;
    private int memberRangeEnd => Math.Min(
        memberListPage * MemberPageSize,
        filteredMembers.Count);

    protected override Task OnInitializedAsync() => LoadWorkspacesAsync(1);

    private async Task LoadWorkspacesAsync(int page)
    {
        var version = ++workspaceRequestVersion;
         workspaceList.CurrentPage = page;
        workspaceList.IsLoading = true;
        workspaceList.Error = null;
        workspaceList.IsLoading  = true;
        workspaceList.Error = null;
        try
        {
            var response = await WorkspaceApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = WorkspacePageSize,
                    Search = string.IsNullOrWhiteSpace(workspaceSearch) ? null : workspaceSearch
                });

            if (version != workspaceRequestVersion)
            {
                return;
            }

            if (response is null)
            {
                workspaceList.Data = null;
                workspaceList.Error = "Workspaces could not be loaded. Confirm your Admin access and retry.";
                return;
            }

            workspaceList.Data = response;
            if (selectedWorkspace is not null)
            {
                selectedWorkspace = response.Items.FirstOrDefault(
                    item => item.Id == selectedWorkspace.Id) ?? selectedWorkspace;
            }
        }
        catch (HttpRequestException)
        {
            if (version == workspaceRequestVersion)
            {
                workspaceList.Data = null;
                workspaceList.Error = "The workspace service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == workspaceRequestVersion)
            {
                workspaceList.Data = null;
                workspaceList.Error = "The workspace service returned an invalid response.";
            }
        }
        finally
        {
            if (version == workspaceRequestVersion)
            {
                workspaceList.IsLoading  = false;
            }
        }
    }

    
        private Task HandleWorkspaceSearchChanged(string? value)
    {
        workspaceSearch = value?.Trim();

        return workspaceSearchDebounce.ExecuteAsync(

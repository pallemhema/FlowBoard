@page "/admin/teams"
@attribute [Authorize(Policy = AuthorizationPolicies.AdminOnly)]
@implements IDisposable

@using System.Text.Json

@inject ITeamApiService TeamApiService
@inject IUserDirectoryApiService UserDirectoryApiService
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Team Management | FlowBoard</PageTitle>

<div class="page-shell admin-teams-page">
    <PageHeader Title="Team Management"
                Eyebrow="Administration"
                Description="Create and manage teams and their employee memberships.">
        <Actions>
            <button type="button" class="btn btn-primary" @onclick="OpenCreateForm">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Create team
            </button>
        </Actions>
    </PageHeader>

    @if (showCreateForm)
    {
        <section class="team-form-panel" aria-labelledby="create-team-title">
            <div class="team-form-heading">
                <div>
                    <p class="section-label mb-1">New team</p>
                    <h2 id="create-team-title">Create a team</h2>
                </div>
                <button type="button" class="btn-close" aria-label="Close create team form" @onclick="CloseCreateForm"></button>
            </div>

            <EditForm Model="@createRequest" OnValidSubmit="CreateTeamAsync" FormName="create-team">
                <DataAnnotationsValidator />
                <div class="team-form-grid">
                    <div class="mb-3">
                        <label class="form-label" for="create-team-name">Team name</label>
                        <InputText id="create-team-name"
                                   class="form-control"
                                   @bind-Value="createRequest.Name"
                                   placeholder="e.g. Product Design" />
                        <ValidationMessage For="@(() => createRequest.Name)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="create-team-description">Description <span class="text-muted fw-normal">(optional)</span></label>
                        <InputTextArea id="create-team-description"
                                       class="form-control team-description-input"
                                       @bind-Value="createRequest.Description"
                                       placeholder="What does this team focus on?" />
                        <ValidationMessage For="@(() => createRequest.Description)" />
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" disabled="@isSubmitting" @onclick="CloseCreateForm">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @(isSubmitting ? "Creating…" : "Create team")
                    </button>
                </div>
            </EditForm>
        </section>
    }
<DataListPanel Title="Teams"
               TitleId="teams-list-title"
               Description="Manage team details and employee membership."
               CountText="@(teamList.Data is null ? null : $"{teamList.Data.TotalCount:N0} teams")"
               CssClass="teams-panel">

    <Toolbar>
        <DataListToolBar SearchValue="@teamSearch"
                         SearchValueChanged="HandleTeamSearchChanged"
                         SearchPlaceholder="Search teams by name">
            <Actions>
                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@string.IsNullOrWhiteSpace(teamSearch)"
                        @onclick="ClearTeamSearch">
                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i>
                    Clear search
                </button>
            </Actions>
        </DataListToolBar>
    </Toolbar>

    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(teamList.Error))
        {
            <div class="team-error" role="alert">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <span>@teamList.Error</span>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary ms-auto"
                        @onclick="() => LoadTeamsAsync(teamList.CurrentPage)">
                    Retry
                </button>
            </div>
        }
        else if (teamList.IsLoading)
        {
            <div class="teams-loading" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm text-primary"
                      aria-hidden="true"></span>
                <span>Loading teams…</span>
            </div>
        }
        else if (teamList.Data is not null && teamList.Data.Items.Count == 0)
        {
            <EmptyState Title="@(string.IsNullOrWhiteSpace(teamSearch) ? "No teams yet" : "No matching teams")"
                        Message="@(string.IsNullOrWhiteSpace(teamSearch) ? "Create a team to organize employees." : "Try another team name or clear the search.")">
                @if (string.IsNullOrWhiteSpace(teamSearch))
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="OpenCreateForm">
                        Create your first team
                    </button>
                }
            </EmptyState>
        }
        else if (teamList.Data is not null)
        {
            <DataTable TItem="TeamResponse"
                       Items="@teamList.Data.Items"
                       Columns="@TeamColumns"
                       ItemKeySelector="team => team.TeamId"
                       CssClass="table align-middle">

                <MobileTemplate Context="team">
                    <article class="team-mobile-card">
                        <div class="team-mobile-heading">
                            <span class="team-avatar" aria-hidden="true">
                                <i class="bi bi-diagram-3"></i>
                            </span>

                            <div class="team-mobile-title">
                                <strong>@team.Name</strong>
                                <span>
                                    @team.MemberCount member@(team.MemberCount == 1 ? "" : "s")
                                    · @team.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                                </span>
                            </div>
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(team.Description)
                                ? "No description provided."
                                : team.Description)
                        </p>

                        <div class="team-mobile-actions">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => OpenTeamAsync(team.TeamId)">
                                View details
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="() => RequestTeamDeletion(team)">
                                Delete
                            </button>
                        </div>
                    </article>
                </MobileTemplate>
            </DataTable>

            <Pagination CurrentPage="@teamList.Data.Page"
                        TotalPages="@teamList.Data.TotalPages"
                        TotalCount="@teamList.Data.TotalCount"
                        PageSize="@teamList.Data.PageSize"
                        PageChanged="LoadTeamsAsync" />
        }
    </ChildContent>
</DataListPanel>

    @if (selectedTeamId.HasValue)
    {
        <div class="team-detail-backdrop" @onclick="CloseTeamDetails">
            <section class="team-detail-panel" role="dialog" aria-modal="true" aria-labelledby="team-detail-title" @onclick:stopPropagation>
                <div class="team-detail-header">
                    <div>
                        <p class="section-label mb-1">Team details</p>
                        <h2 id="team-detail-title">@(selectedTeam?.Name ?? "Loading team…")</h2>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close team details" @onclick="CloseTeamDetails"></button>
                </div>

                @if (teamDetailsLoad.IsLoading)
                {
                    <div class="teams-loading" role="status">
                        <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                        <span>Loading team information…</span>
                    </div>
                }
                else if (selectedTeam is null)
                {
                    <div class="team-error" role="alert">Team details could not be loaded. It may have been deleted or is no longer available.</div>
                }
                else
                {
                    @if (isEditingTeam)
                    {
                        <EditForm Model="@updateRequest" OnValidSubmit="UpdateTeamAsync" FormName="update-team">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label class="form-label" for="edit-team-name">Team name</label>
                                <InputText id="edit-team-name" class="form-control" @bind-Value="updateRequest.Name" />
                                <ValidationMessage For="@(() => updateRequest.Name)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="edit-team-description">Description</label>
                                <InputTextArea id="edit-team-description" class="form-control team-description-input" @bind-Value="updateRequest.Description" />
                                <ValidationMessage For="@(() => updateRequest.Description)" />
                            </div>
                            <div class="d-flex justify-content-end gap-2 mb-4">
                                <button type="button" class="btn btn-outline-secondary" disabled="@isSubmitting" @onclick="CancelTeamEdit">Cancel</button>
                                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">@(isSubmitting ? "Saving…" : "Save changes")</button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <div class="team-detail-summary">
                            <div>
                                <span class="detail-metric-label">Description</span>
                                <p>@(string.IsNullOrWhiteSpace(selectedTeam.Description) ? "No description provided." : selectedTeam.Description)</p>
                            </div>
                            <div class="team-detail-meta">
                                <span><i class="bi bi-people me-2" aria-hidden="true"></i>@selectedTeam.MemberCount members</span>
                                <span><i class="bi bi-calendar3 me-2" aria-hidden="true"></i>Created @selectedTeam.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm align-self-start" @onclick="BeginTeamEdit">
                                <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit team
                            </button>
                        </div>
                    }

                    <section class="team-members-section" aria-labelledby="team-members-title">
                        <div class="team-members-heading">
                            <div>
                                <h3 id="team-members-title">Team members</h3>
                                <p>Team membership does not grant workspace, project, or board access.</p>
                            </div>
                        </div>

                        <div class="team-member-add">
                            <label class="form-label" for="member-directory-search">Add an employee</label>
                            <div class="team-member-search">
                                <SearchBox Value="@memberSearch"
                                           ValueChanged="HandleMemberSearchChanged"
                                           Placeholder="Find by name or email" />
                            </div>

                            @if (memberCandidates.IsLoading)
                            {
                                <div class="candidate-loading" role="status">
                                    <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Searching directory…
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(memberCandidates.Error))
                            {
                                <div class="team-error compact" role="alert">@memberCandidates.Error</div>
                            }
                            else if (memberCandidates.Data is not null && memberCandidates.Data.Items.Count == 0)
                            {
                                <p class="candidate-empty">No eligible Employees match this search.</p>
                            }
                            else if (memberCandidates.Data is not null)
                            {
                                @if (!memberIdsLoaded)
                                {
                                    <div class="team-error compact" role="alert">
                                        <span>@(memberIdsLoad.Error ?? "Membership status could not be verified. Adding employees is disabled.")</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="LoadAllMemberIdsAsync">Retry</button>
                                    </div>
                                }
                                <div class="candidate-list">
                                    @foreach (UserDirectoryResponse candidate in memberCandidates.Data.Items)
                                    {
                                        var alreadyMember = memberIdsLoaded && teamMemberIds.Contains(candidate.UserId);
                                        <div class="candidate-row" @key="candidate.UserId">
                                            <UserAvatar FirstName="@candidate.FirstName" LastName="@candidate.LastName" />
                                            <span class="candidate-copy">
                                                <strong>@GetFullName(candidate.FirstName, candidate.LastName)</strong>
                                                <small>@candidate.Email</small>
                                            </span>
                                            @if (alreadyMember)
                                            {
                                                <span class="candidate-added">Added</span>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        disabled="@(!memberIdsLoaded || isSubmitting)"
                                                        @onclick="() => AddMemberAsync(candidate)">
                                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                <Pagination CurrentPage="@memberCandidates.Data.Page"
                                            TotalPages="@memberCandidates.Data.TotalPages"
                                            TotalCount="@memberCandidates.Data.TotalCount"
                                            PageSize="@memberCandidates.Data.PageSize"
                                            PageChanged="LoadCandidatesAsync" />
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(teamDetailsLoad.Error))
                        {
                            <div class="team-error compact" role="alert">@teamDetailsLoad.Error</div>
                        }
                        else if (teamMembers.IsLoading)
                        {
                            <div class="candidate-loading" role="status">
                                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Loading members…
                            </div>
                        }
                        else if (teamMembers.Data is not null && teamMembers.Data.Items.Count == 0)
                        {
                            <EmptyState Title="No team members"
                                        Message="Search the directory above to add Employee accounts to this team." />
                        }
                        else if (teamMembers.Data is not null)
                        {
                            <div class="members-list">
                                @foreach (var member in teamMembers.Data.Items)
                                {
                                    <div class="member-row" @key="member.UserId">
                                        <UserAvatar FirstName="@member.User.FirstName" LastName="@member.User.LastName" />
                                        <span class="member-copy">
                                            <strong>@GetFullName(member.User.FirstName, member.User.LastName)</strong>
                                            <small>@member.User.Email</small>
                                        </span>
                                        @if (removeMemberId == member.UserId)
                                        {
                                            <div class="member-remove-confirm">
                                                <span>Remove?</span>
                                                <button type="button" class="btn btn-sm btn-danger" disabled="@isSubmitting" @onclick="() => RemoveMemberAsync(member)">Confirm</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelMemberRemoval">Cancel</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    aria-label="@($"Remove {member.User.FirstName} {member.User.LastName}")"
                                                    @onclick="() => RequestMemberRemoval(member.UserId)">
                                                Remove
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <Pagination CurrentPage="@teamMembers.Data.Page"
                                        TotalPages="@teamMembers.Data.TotalPages"
                                        TotalCount="@teamMembers.Data.TotalCount"
                                        PageSize="@teamMembers.Data.PageSize"
                                        PageChanged="LoadMembersAsync" />
                        }
                    </section>
                }
            </section>
        </div>
    }

    <ConfirmationDialog IsOpen="@(teamPendingDeletion is not null)"
                        Title="@(teamPendingDeletion is null ? string.Empty : $"Delete {teamPendingDeletion.Name}?")"
                        ConfirmText="Delete team"
                        ConfirmingText="Deleting…"
                        IsBusy="@isSubmitting"
                        OnCancel="CancelTeamDeletion"
                        OnConfirm="DeleteTeamAsync">
        <p>This action cannot be undone. Teams with members cannot be deleted; remove members first. No memberships will be removed automatically.</p>
    </ConfirmationDialog>
</div>

@code {
    // Page sizes
    private const int TeamPageSize = PageSizeDefaults.Default;
    private const int MemberPageSize = PageSizeDefaults.Default;
    private const int CandidatePageSize = PageSizeDefaults.Default;
    private const int DirectoryFetchPageSize = PageSizeDefaults.Resource;

    [SupplyParameterFromQuery(Name = "teamId")]
    public Guid? TeamId { get; set; }


    // Team list state
    private PagedListState<TeamResponse> teamList = new()
    {
        PageSize = TeamPageSize,
        IsLoading = true
    };

    // Selected team
    private TeamResponse? selectedTeam;
    private TeamResponse? teamPendingDeletion;

    // Team members state
    private PagedListState<TeamMemberResponse> teamMembers = new()
    {
        PageSize = MemberPageSize
    };

    // Member candidates state
    private PagedListState<UserDirectoryResponse> memberCandidates = new()
    {
        PageSize = CandidatePageSize
    };

    // Complete membership verification
    private readonly HashSet<Guid> teamMemberIds = [];
    private bool memberIdsLoaded;

    // Candidate cache
    private readonly List<UserDirectoryResponse> eligibleCandidates = [];
    private string? loadedCandidateSearch;
    private bool employeeCandidateCacheLoaded;

    // Forms
    private CreateTeamRequest createRequest = new();
    private UpdateTeamRequest updateRequest = new();

    // Async operations
    private AsyncOperationState createTeamOperation = new();
    private AsyncOperationState teamDetailsLoad = new();
    private AsyncOperationState memberIdsLoad = new();
    private AsyncOperationState memberOperation = new();
    private AsyncOperationState teamUpdateOperation = new();
    private AsyncOperationState deleteTeamOperation = new();

    // Search
    private string? teamSearch;
    private string? memberSearch;

    // UI state
    private bool isEditingTeam;
    private bool showCreateForm;
    private Guid? removeMemberId;

    // Request versioning
    private long teamRequestVersion;
    private long memberRequestVersion;
    private long candidateRequestVersion;
    private long memberIdsRequestVersion;

    // Cancellation and debounce
    private CancellationTokenSource? activeTeamRequest;
    private readonly DebouncedAction teamSearchDebounce = new();

    private readonly DebouncedAction memberSearchDebounce = new();


    // Route and lifecycle
    private Guid? loadedDetailTeamId;
    private bool disposed;

    // Combined submission state
    private bool isSubmitting =>
        createTeamOperation.IsSubmitting ||
        memberOperation.IsSubmitting ||
        teamUpdateOperation.IsSubmitting ||
        deleteTeamOperation.IsSubmitting;




    private IReadOnlyList<DataTableColumn<TeamResponse>> TeamColumns =>
    [
        new()
        {
            Header = "Team",
            Template = team => @<div class="team-name-cell">
                <span class="team-avatar" aria-hidden="true">
                    <i class="bi bi-diagram-3"></i>
                </span>
                <strong>@team.Name</strong>
            </div>
        },
        new()
        {
            Header = "Description",
            Template = team => @<span class="team-description-cell">
                @(string.IsNullOrWhiteSpace(team.Description)
                    ? "—"
                    : team.Description)
            </span>
        },
        new()
        {
            Header = "Members",
            Template = team => @<span class="member-count-badge">
                <i class="bi bi-people me-1" aria-hidden="true"></i>
                @team.MemberCount
            </span>
        },
        new()
        {
            Header = "Created",
            Template = team => @<span class="team-date-cell">
                @team.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
            </span>
        },
        new()
        {
            Header = "Actions",
            Template = team => @<div class="team-actions-cell">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="() => OpenTeamAsync(team.TeamId)">
                    <i class="bi bi-eye me-1" aria-hidden="true"></i>
                    Details
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        aria-label="@($"Delete {team.Name}")"
                        @onclick="() => RequestTeamDeletion(team)">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
            </div>
        }
    ];

    protected override async Task OnInitializedAsync()
    {
        loadedDetailTeamId = TeamId;
        await LoadTeamsAsync(1);
        if (TeamId.HasValue)
        {
            await LoadTeamDetailsAsync(TeamId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TeamId != loadedDetailTeamId)
        {
            loadedDetailTeamId = TeamId;
            if (TeamId.HasValue)
            {
                await LoadTeamDetailsAsync(TeamId.Value);
            }
            else
            {
                ResetTeamDetails();
            }
        }
    }

    private void OpenCreateForm()
    {
        showCreateForm = true;
        createRequest = new CreateTeamRequest();
    }

    private void CloseCreateForm()
    {
        if (isSubmitting)
        {
            return;
        }

        showCreateForm = false;
        createRequest = new CreateTeamRequest();
    }

    private async Task CreateTeamAsync()
    {
        if (createTeamOperation.IsSubmitting)
        {
            return;
        }

        createTeamOperation.IsSubmitting = true;
        createTeamOperation.Error = null;

        try
        {
            var created = await TeamApiService.CreateAsync(createRequest);

            if (created is null)
            {
                return;
            }

            ToastService.Success($"Team “{created.Name}” created.");

            showCreateForm = false;
            createRequest = new CreateTeamRequest();
            teamSearch = null;

            await LoadTeamsAsync(1);
            await NavigateToTeamAsync(created.TeamId);
        }
        catch (HttpRequestException)
        {
            createTeamOperation.Error =
                "The team service could not be reached. Try again.";

            ToastService.Error(createTeamOperation.Error);
        }
        catch (JsonException)
        {
            createTeamOperation.Error =
                "The team service returned an invalid response.";

            ToastService.Error(createTeamOperation.Error);
        }
        finally
        {
            createTeamOperation.IsSubmitting = false;
        }
    }

    private async Task LoadTeamsAsync(int page)
    {
        activeTeamRequest?.Cancel();
        activeTeamRequest?.Dispose();

        activeTeamRequest = new CancellationTokenSource();

        var cancellationToken = activeTeamRequest.Token;
        var version = ++teamRequestVersion;

        teamList.CurrentPage = page;
        teamList.IsLoading = true;
        teamList.Error = null;

        try
        {
            var response = await TeamApiService.GetAllAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = TeamPageSize,
                    Search = string.IsNullOrWhiteSpace(teamSearch)
                        ? null
                        : teamSearch
                },
                cancellationToken);

            if (version != teamRequestVersion ||
                cancellationToken.IsCancellationRequested)
            {
                return;
            }

            if (response is null)
            {
                teamList.Data = null;
                teamList.Error =
                    "Teams could not be loaded. The request may have been rejected or the service may be unavailable.";
                return;
            }

            teamList.Data = response;
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            // A newer request replaced this one.
        }
        catch (HttpRequestException)
        {
            if (version == teamRequestVersion)
            {
                teamList.Data = null;
                teamList.Error =
                    "The team service could not be reached. Check your connection and retry.";
            }
        }
        catch (JsonException)
        {
            if (version == teamRequestVersion)
            {
                teamList.Data = null;
                teamList.Error =
                    "The team service returned an invalid response.";
            }
        }
        finally
        {
            if (version == teamRequestVersion && !disposed)
            {
                teamList.IsLoading = false;
            }
        }
    }
   private Task HandleTeamSearchChanged(string? value)
    {
        teamSearch = value?.Trim();

        return teamSearchDebounce.ExecuteAsync(
            () => LoadTeamsAsync(1));
    }


    private async Task ClearTeamSearch()
    {
        if (string.IsNullOrWhiteSpace(teamSearch))
        {
            return;
        }

        teamSearch = null;
        teamSearchDebounce?.Cancel();
        await LoadTeamsAsync(1);
    }

    private async Task OpenTeamAsync(Guid teamId)
    {
        await NavigateToTeamAsync(teamId);
    }

    private Task NavigateToTeamAsync(Guid teamId)
    {
        Navigation.NavigateTo($"/admin/teams?teamId={teamId}");
        return Task.CompletedTask;
    }

    private async Task LoadTeamDetailsAsync(Guid teamId)
    {
        // Invalidate requests belonging to the previously selected team.
        ++memberRequestVersion;
        ++candidateRequestVersion;
        ++memberIdsRequestVersion;

        teamDetailsLoad.IsLoading = true;
        teamDetailsLoad.Error = null;

        selectedTeam = null;

        teamMembers.Data = null;
        memberCandidates.Data = null;

        teamMemberIds.Clear();
        memberIdsLoaded = false;
        memberIdsLoad.Error = null;

        eligibleCandidates.Clear();
        loadedCandidateSearch = null;
        employeeCandidateCacheLoaded = false;

        teamMembers.CurrentPage = 1;
        memberCandidates.CurrentPage = 1;

        try
        {
            selectedTeam = await TeamApiService.GetByIdAsync(teamId);

            if (selectedTeam is null)
            {
                teamDetailsLoad.Error = "Team details could not be loaded.";
                ToastService.Error("Team details could not be loaded.");
                return;
            }

            await LoadMembersAsync(1);
            await LoadAllMemberIdsAsync();
            await LoadCandidatesAsync(1);
        }
        catch (HttpRequestException)
        {
            teamDetailsLoad.Error =
                "The team service could not be reached.";
        }
        catch (JsonException)
        {
            teamDetailsLoad.Error =
                "The team service returned an invalid response.";
        }
        finally
        {
            if (!disposed)
            {
                teamDetailsLoad.IsLoading = false;
            }
        }
    }
    private void CloseTeamDetails()
    {
        Navigation.NavigateTo("/admin/teams");
        loadedDetailTeamId = null;
        ResetTeamDetails();
    }

    private void ResetTeamDetails()
    {
        selectedTeam = null;
        teamMembers.Data = null;
        memberCandidates.Data = null;
        teamMemberIds.Clear();
        memberIdsLoaded = false;
        memberIdsRequestVersion++;
        eligibleCandidates.Clear();
        employeeCandidateCacheLoaded = false;
        isEditingTeam = false;
        teamDetailsLoad.IsLoading = false;
    }

    private async Task LoadMembersAsync(int page)
    {
        var teamId = selectedTeam?.TeamId ?? TeamId;

        if (!teamId.HasValue)
        {
            return;
        }

        var requestedTeamId = teamId.Value;
        var version = ++memberRequestVersion;

        teamMembers.CurrentPage = page;
        teamMembers.IsLoading = true;
        teamMembers.Error = null;

        try
        {
            var response = await TeamApiService.GetMembersAsync(
                requestedTeamId,
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = MemberPageSize
                });

            if (version != memberRequestVersion ||
                requestedTeamId != (selectedTeam?.TeamId ?? TeamId))
            {
                return;
            }

            if (response is null)
            {
                teamMembers.Data = null;
                teamMembers.Error =
                    "Team members could not be loaded. Check your access and retry.";
                return;
            }

            teamMembers.Data = response;
        }
        catch (HttpRequestException)
        {
            if (version == memberRequestVersion)
            {
                teamMembers.Error =
                    "The team member service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == memberRequestVersion)
            {
                teamMembers.Error =
                    "The team member service returned an invalid response.";
            }
        }
        finally
        {
            if (version == memberRequestVersion && !disposed)
            {
                teamMembers.IsLoading = false;
            }
        }
    }
    private Task HandleMemberSearchChanged(string? value)
        {
            memberSearch = value?.Trim();

            return memberSearchDebounce.ExecuteAsync(
                () => LoadCandidatesAsync(1));
        }

   
   private async Task LoadCandidatesAsync(int page)
{
    var teamId = selectedTeam?.TeamId ?? TeamId;

    if (!teamId.HasValue)
    {
        return;
    }

    var requestedTeamId = teamId.Value;
    var version = ++candidateRequestVersion;

    memberCandidates.CurrentPage = page;
    memberCandidates.IsLoading = true;
    memberCandidates.Error = null;

    try
    {
        var search = string.IsNullOrWhiteSpace(memberSearch)
            ? null
            : memberSearch.Trim();

        if (!employeeCandidateCacheLoaded ||
            !string.Equals(
                loadedCandidateSearch,
                search,
                StringComparison.Ordinal))
        {
            var firstPage = await UserDirectoryApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = 1,
                    PageSize = DirectoryFetchPageSize,
                    Search = search
                });

            if (version != candidateRequestVersion ||
                requestedTeamId != (selectedTeam?.TeamId ?? TeamId))
            {
                return;
            }

            if (firstPage is null)
            {
                memberCandidates.Data = null;
                employeeCandidateCacheLoaded = false;
                memberCandidates.Error =
                    "The account directory could not be loaded. Check your Admin access and retry.";
                return;
            }

            var directoryUsers = firstPage.Items.ToList();

            for (var directoryPage = 2;
                 directoryPage <= firstPage.TotalPages;
                 directoryPage++)
            {
                var response = await UserDirectoryApiService.GetAsync(
                    new PagedSearchRequest
                    {
                        Page = directoryPage,
                        PageSize = DirectoryFetchPageSize,
                        Search = search
                    });

                if (version != candidateRequestVersion ||
                    requestedTeamId != (selectedTeam?.TeamId ?? TeamId))
                {
                    return;
                }

                if (response is null)
                {
                    memberCandidates.Data = null;
                    employeeCandidateCacheLoaded = false;
                    memberCandidates.Error =
                        "The complete account directory could not be loaded. No candidates are shown until all roles can be verified.";
                    return;
                }

                directoryUsers.AddRange(response.Items);
            }

            if (directoryUsers.Count != firstPage.TotalCount)
            {
                memberCandidates.Data = null;
                employeeCandidateCacheLoaded = false;
                memberCandidates.Error =
                    "The account directory returned incomplete results. No candidates are shown until eligibility can be verified.";
                return;
            }

            eligibleCandidates.Clear();

            eligibleCandidates.AddRange(directoryUsers
                .Where(user =>
                    user.Role == "Employee" ||
                    user.Role == "Manager")
                .OrderBy(user => user.FirstName)
                .ThenBy(user => user.LastName)
                .ThenBy(user => user.Email));

            loadedCandidateSearch = search;
            employeeCandidateCacheLoaded = true;
        }

        var totalPages = Math.Max(
            1,
            (int)Math.Ceiling(
                eligibleCandidates.Count / (double)CandidatePageSize));

        var currentPage = Math.Clamp(page, 1, totalPages);

        memberCandidates.CurrentPage = currentPage;

        memberCandidates.Data = new PagedResponse<UserDirectoryResponse>
        {
            Items = eligibleCandidates
                .Skip((currentPage - 1) * CandidatePageSize)
                .Take(CandidatePageSize)
                .ToArray(),
            Page = currentPage,
            PageSize = CandidatePageSize,
            TotalCount = eligibleCandidates.Count,
            TotalPages = totalPages
        };
    }
    catch (HttpRequestException)
    {
        if (version == candidateRequestVersion)
        {
            memberCandidates.Error =
                "The account directory could not be reached.";
        }
    }
    catch (JsonException)
    {
        if (version == candidateRequestVersion)
        {
            memberCandidates.Error =
                "The account directory returned an invalid response.";
        }
    }
    finally
    {
        if (version == candidateRequestVersion && !disposed)
        {
            memberCandidates.IsLoading = false;
        }
    }
}

    private async Task LoadAllMemberIdsAsync()
    {
        var teamId = selectedTeam?.TeamId ?? TeamId;

        if (!teamId.HasValue)
        {
            return;
        }

        var requestedTeamId = teamId.Value;
        var version = ++memberIdsRequestVersion;

        memberIdsLoaded = false;
        memberIdsLoad.IsLoading = true;
        memberIdsLoad.Error = null;

        try
        {
            var firstPage = await TeamApiService.GetMembersAsync(
                requestedTeamId,
                new PagedSearchRequest
                {
                    Page = 1,
                    PageSize = DirectoryFetchPageSize
                });

            if (version != memberIdsRequestVersion ||
                requestedTeamId != (selectedTeam?.TeamId ?? TeamId))
            {
                return;
            }

            if (firstPage is null)
            {
                memberIdsLoad.Error =
                    "The complete team membership list could not be loaded.";
                return;
            }

            var userIds = firstPage.Items
                .Select(member => member.UserId)
                .ToHashSet();

            for (var page = 2; page <= firstPage.TotalPages; page++)
            {
                var response = await TeamApiService.GetMembersAsync(
                    requestedTeamId,
                    new PagedSearchRequest
                    {
                        Page = page,
                        PageSize = DirectoryFetchPageSize
                    });

                if (version != memberIdsRequestVersion ||
                    requestedTeamId != (selectedTeam?.TeamId ?? TeamId))
                {
                    return;
                }

                if (response is null)
                {
                    memberIdsLoad.Error =
                        "The complete team membership list could not be loaded.";
                    return;
                }

                userIds.UnionWith(
                    response.Items.Select(member => member.UserId));
            }

            if (userIds.Count != firstPage.TotalCount)
            {
                memberIdsLoad.Error =
                    "The team membership list returned incomplete results.";
                return;
            }

            teamMemberIds.Clear();
            teamMemberIds.UnionWith(userIds);

            memberIdsLoaded = true;
        }
        catch (HttpRequestException)
        {
            if (version == memberIdsRequestVersion)
            {
                memberIdsLoad.Error =
                    "The team membership service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == memberIdsRequestVersion)
            {
                memberIdsLoad.Error =
                    "The team membership service returned an invalid response.";
            }
        }
        finally
        {
            if (version == memberIdsRequestVersion && !disposed)
            {
                memberIdsLoad.IsLoading = false;
            }
        }
    }
    private async Task AddMemberAsync(UserDirectoryResponse candidate)
    {
        var teamId = selectedTeam?.TeamId ?? TeamId;

        if (!teamId.HasValue || memberOperation.IsSubmitting)
        {
            return;
        }

        if (!memberIdsLoaded)
        {
            ToastService.Warning(
                "Team membership could not be verified. Retry before adding an employee.");
            return;
        }

        if (teamMemberIds.Contains(candidate.UserId))
        {
            ToastService.Warning("This account is already a team member.");
            return;
        }

        memberOperation.IsSubmitting = true;
        memberOperation.Error = null;

        try
        {
            var added = await TeamApiService.AddMemberAsync(
                teamId.Value,
                new AddTeamMemberRequest
                {
                    UserId = candidate.UserId
                });

            if (added is null)
            {
                return;
            }

            ToastService.Success(
                $"{GetFullName(candidate.FirstName, candidate.LastName)} added to the team.");

            await RefreshTeamAfterMembershipChangeAsync();
        }
        catch (HttpRequestException)
        {
            memberOperation.Error =
                "The team service could not be reached. Try again.";
            ToastService.Error(memberOperation.Error);
        }
        catch (JsonException)
        {
            memberOperation.Error =
                "The team service returned an invalid response.";
            ToastService.Error(memberOperation.Error);
        }
        finally
        {
            memberOperation.IsSubmitting = false;
        }
    }

    private void RequestMemberRemoval(Guid userId)
    {
        removeMemberId = userId;
    }

    private void CancelMemberRemoval()
    {
        removeMemberId = null;
    }

    private async Task RemoveMemberAsync(TeamMemberResponse member)
    {
        var teamId = selectedTeam?.TeamId ?? TeamId;

        if (!teamId.HasValue || memberOperation.IsSubmitting)
        {
            return;
        }

        memberOperation.IsSubmitting = true;
        memberOperation.Error = null;

        try
        {
            var removed = await TeamApiService.RemoveMemberAsync(
                teamId.Value,
                member.UserId);

            if (!removed)
            {
                return;
            }

            ToastService.Success(
                $"{GetFullName(member.User.FirstName, member.User.LastName)} removed from the team.");

            removeMemberId = null;

            await RefreshTeamAfterMembershipChangeAsync();
        }
        catch (HttpRequestException)
        {
            memberOperation.Error =
                "The team service could not be reached. Try again.";
            ToastService.Error(memberOperation.Error);
        }
        catch (JsonException)
        {
            memberOperation.Error =
                "The team service returned an invalid response.";
            ToastService.Error(memberOperation.Error);
        }
        finally
        {
            memberOperation.IsSubmitting = false;
        }
    }

    private async Task RefreshTeamAfterMembershipChangeAsync()
    {
        var teamId = selectedTeam?.TeamId ?? TeamId;

        if (!teamId.HasValue)
        {
            return;
        }

        var requestedTeamId = teamId.Value;

        // If the last member on a page was removed, move to the previous page.
        var currentPage = teamMembers.CurrentPage;

        var page = teamMembers.Data?.Items.Count == 1 && currentPage > 1
            ? currentPage - 1
            : currentPage;

        await LoadMembersAsync(page);
        await LoadAllMemberIdsAsync();

        // Refresh the selected team's member count and other details.
        var refreshedTeam = await TeamApiService.GetByIdAsync(requestedTeamId);

        if (refreshedTeam is not null &&
            requestedTeamId == (selectedTeam?.TeamId ?? TeamId))
        {
            selectedTeam = refreshedTeam;
        }

        // Refresh the main team list.
        await LoadTeamsAsync(teamList.CurrentPage);
    }

    private void BeginTeamEdit()
    {
        if (selectedTeam is null)
        {
            return;
        }

        updateRequest = new UpdateTeamRequest
        {
            Name = selectedTeam.Name,
            Description = selectedTeam.Description
        };
        isEditingTeam = true;
    }

    private void CancelTeamEdit()
    {
        if (isSubmitting)
        {
            return;
        }

        isEditingTeam = false;
    }

    private async Task UpdateTeamAsync()
    {
        var teamId = selectedTeam?.TeamId ?? TeamId;

        if (!teamId.HasValue || teamUpdateOperation.IsSubmitting)
        {
            return;
        }

        teamUpdateOperation.IsSubmitting = true;
        teamUpdateOperation.Error = null;

        try
        {
            var updated = await TeamApiService.UpdateAsync(
                teamId.Value,
                updateRequest);

            if (updated is null)
            {
                return;
            }

            selectedTeam = updated;
            isEditingTeam = false;

            ToastService.Success("Team details updated.");

            await LoadTeamsAsync(teamList.CurrentPage);
        }
        catch (HttpRequestException)
        {
            teamUpdateOperation.Error =
                "The team service could not be reached. Try again.";

            ToastService.Error(teamUpdateOperation.Error);
        }
        catch (JsonException)
        {
            teamUpdateOperation.Error =
                "The team service returned an invalid response.";

            ToastService.Error(teamUpdateOperation.Error);
        }
        finally
        {
            teamUpdateOperation.IsSubmitting = false;
        }
    }

    private void RequestTeamDeletion(TeamResponse team)
    {
        teamPendingDeletion = team;
    }

    private void CancelTeamDeletion()
    {
        if (!isSubmitting)
        {
            teamPendingDeletion = null;
        }
    }

    private async Task DeleteTeamAsync()
    {
        if (teamPendingDeletion is null ||
            deleteTeamOperation.IsSubmitting)
        {
            return;
        }

        var team = teamPendingDeletion;

        deleteTeamOperation.IsSubmitting = true;
        deleteTeamOperation.Error = null;

        try
        {
            var deleted = await TeamApiService.DeleteAsync(team.TeamId);

            if (!deleted)
            {
                return;
            }

            teamPendingDeletion = null;

            ToastService.Success($"Team “{team.Name}” deleted.");

            if (selectedTeamId == team.TeamId)
            {
                CloseTeamDetails();
            }

            // Move back one page if the deleted team was the only item.
            var currentPage = teamList.CurrentPage;

            var targetPage =
                teamList.Data?.Items.Count == 1 && currentPage > 1
                    ? currentPage - 1
                    : currentPage;

            await LoadTeamsAsync(targetPage);
        }
        catch (HttpRequestException)
        {
            deleteTeamOperation.Error =
                "The team service could not be reached. The team was not deleted.";

            ToastService.Error(deleteTeamOperation.Error);
        }
        catch (JsonException)
        {
            deleteTeamOperation.Error =
                "The team service returned an invalid response. The team may not have been deleted.";

            ToastService.Error(deleteTeamOperation.Error);
        }
        finally
        {
            deleteTeamOperation.IsSubmitting = false;
        }
    }

    private Guid? selectedTeamId => selectedTeam?.TeamId ?? TeamId;

    private static string GetFullName(string firstName, string lastName)
    {
        var fullName = $"{firstName} {lastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? "Unnamed account" : fullName;
    }

    public void Dispose()
    {
        disposed = true;
        activeTeamRequest?.Cancel();
        activeTeamRequest?.Dispose();
        teamSearchDebounce?.Dispose();
        memberSearchDebounce?.Dispose();
    }

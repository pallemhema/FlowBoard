private async Task AddProjectMemberAsync(
    UserDirectoryResponse candidate)
{
    if (selectedProject is null || isSubmitting)
    {
        return;
    }

    memberOperation.Error = null;

    if (projectMembers.Data?.Items.Any(
            member => member.UserId == candidate.UserId) == true)
    {
        ToastService.Warning(
            "This account is already a project member.");
        return;
    }

    memberOperation.IsSubmitting = true;

    try
    {
        var added = await ProjectApiService.AddMemberAsync(
            selectedProject.ProjectId,
            new AddProjectMemberRequest
            {
                UserId = candidate.UserId
            });

        if (added is null)
        {
            memberOperation.Error =
                "Membership was not added. The backend accepts only eligible Employee accounts.";
            return;
        }

        await LoadProjectMembersAsync(
            projectDetailsVersion,
            selectedProject.ProjectId,
            1);
    }
    catch (HttpRequestException)
    {
        memberOperation.Error =
            "The project service could not be reached. Membership was not confirmed.";
    }
    catch (JsonException)
    {
        memberOperation.Error =
            "The project service returned an invalid response. Refresh membership to confirm the result.";
    }
    finally
    {
        memberOperation.IsSubmitting = false;
    }
}


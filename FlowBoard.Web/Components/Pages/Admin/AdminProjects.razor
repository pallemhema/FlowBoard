private void RequestMemberRemoval(Guid userId)
{
    pendingRemovalUserId = userId;
}

private void CancelMemberRemoval()
{
    if (!isSubmitting)
    {
        pendingRemovalUserId = null;
    }
}

private async Task RemoveProjectMemberAsync(
    ProjectMemberResponse member)
{
    if (selectedProject is null || isSubmitting)
    {
        return;
    }

    memberOperation.IsSubmitting = true;
    memberOperation.Error = null;

    try
    {
        var removed = await ProjectApiService.RemoveMemberAsync(
            selectedProject.ProjectId,
            member.UserId);

        if (!removed)
        {
            memberOperation.Error =
                "Membership was not removed. Associated board memberships or task dependencies may need to be resolved first.";
            return;
        }

        pendingRemovalUserId = null;

        var targetPage =
            projectMembers.Data?.Items.Count == 1 &&
            projectMembers.CurrentPage > 1
                ? projectMembers.CurrentPage - 1
                : projectMembers.CurrentPage;

        await LoadProjectMembersAsync(
            projectDetailsVersion,
            selectedProject.ProjectId,
            targetPage);
    }
    catch (HttpRequestException)
    {
        memberOperation.Error =
            "The project service could not be reached. Membership was not confirmed as removed.";
    }
    catch (JsonException)
    {
        memberOperation.Error =
            "The project service returned an invalid response. Refresh membership to confirm the result.";
    }
    finally
    {
        memberOperation.IsSubmitting = false;
    }
}


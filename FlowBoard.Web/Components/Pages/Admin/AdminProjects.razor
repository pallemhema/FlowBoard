{
    projectDetailsVersion++;
    projectMembersRequestVersion++;

    selectedProject = null;

    projectMembers.Data = null;
    projectMembers.Error = null;
    projectMembers.CurrentPage = 1;
    projectMembers.IsLoading = false;

    projectBoards = null;
    projectBoardsLoad.Error = null;
    projectBoardsLoad.IsLoading = false;

    memberCandidates.Data = null;
    memberCandidates.Error = null;
    memberCandidates.CurrentPage = 1;
    memberCandidates.IsLoading = false;

    pendingRemovalUserId = null;

    memberCandidateSearchDebounce?.Cancel();
    memberCandidateVersion++;
}


// ---------------------------------------------------------
// Workspace loading
// ---------------------------------------------------------

private async Task LoadWorkspacesAsync()
{
    workspaceLoad.IsLoading = true;
    workspaceLoad.Error = null;

    try
    {
        var firstPage = await WorkspaceApiService.GetAsync(
            new PagedSearchRequest
            {
                Page = 1,
                PageSize = WorkspacePageSize
            });

        if (firstPage is null)
        {
            workspaceLoad.Error = "Workspace options could not be loaded.";
            return;
        }

        var result = firstPage.Items.ToList();

        for (var page = 2; page <= firstPage.TotalPages; page++)
        {
            var response = await WorkspaceApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = WorkspacePageSize
                });

            if (response is null)
            {
                workspaceLoad.Error =
                    "The workspace list could not be loaded completely.";
                return;
            }

            result.AddRange(response.Items);
        }

        workspaces = result
            .OrderBy(workspace => workspace.Name)
            .ToList();
    }
    catch (HttpRequestException)
    {
        workspaceLoad.Error =
            "The workspace service could not be reached.";
    }
    catch (JsonException)
    {
        workspaceLoad.Error =
            "The workspace service returned an invalid response.";
    }
    finally
    {
        workspaceLoad.IsLoading = false;
    }
}

// ---------------------------------------------------------
// Project list
// ---------------------------------------------------------

private async Task LoadProjectsAsync(int page)
{
    var version = ++projectRequestVersion;

    projectList.CurrentPage = page;
    projectList.IsLoading = true;
    projectList.Error = null;

    try
    {
        var request = new ProjectQueryRequest
        {
            Page = page,
            PageSize = projectList.PageSize,
            Search = string.IsNullOrWhiteSpace(projectSearch)
                ? null
                : projectSearch,
            WorkspaceId = Guid.TryParse(workspaceFilter, out var workspaceId)
                ? workspaceId
                : null,
            Status = Enum.TryParse<ProjectStatus>(
                statusFilter,
                out var status)
                ? status
                : null
        };

        var response = await ProjectApiService.GetAsync(request);

        if (version != projectRequestVersion)
        {
            return;
        }

        if (response is null)
        {
            projectList.Data = null;
            projectList.Error =
                "Projects could not be loaded. Confirm your Admin access and retry.";
            return;
        }

        projectList.Data = response;

        if (selectedProject is not null)
        {
            selectedProject = response.Items.FirstOrDefault(
                project => project.ProjectId == selectedProject.ProjectId)
                ?? selectedProject;
        }
    }
    catch (HttpRequestException)
    {
        if (version == projectRequestVersion)
        {
            projectList.Data = null;
            projectList.Error =
                "The project service could not be reached.";
        }
    }
    catch (JsonException)
    {
        if (version == projectRequestVersion)
        {
            projectList.Data = null;
            projectList.Error =
                "The project service returned an invalid response.";
        }
    }
    finally
    {
        if (version == projectRequestVersion)
        {
            projectList.IsLoading = false;
        }
    }
}

private async Task HandleProjectSearchChanged(string? value)
{
    projectSearch = value?.Trim();
    await DebounceProjectFiltersAsync();
}

private Task HandleWorkspaceFilterChanged() =>

private async Task LoadProjectMembersAsync(
    long detailsVersion,
    Guid projectId,
    int page)
{
    var requestVersion = ++projectMembersRequestVersion;

    projectMembers.CurrentPage = page;
    projectMembers.IsLoading = true;
    projectMembers.Error = null;

    try
    {
        var response = await ProjectApiService.GetMembersAsync(
            projectId,
            new PagedSearchRequest
            {
                Page = page,
                PageSize = projectMembers.PageSize,
                Search = string.IsNullOrWhiteSpace(memberSearch)
                    ? null
                    : memberSearch
            });

        if (detailsVersion != projectDetailsVersion ||
            requestVersion != projectMembersRequestVersion)
        {
            return;
        }

        if (response is null)
        {
            projectMembers.Data = null;
            projectMembers.Error =
                "Project members could not be loaded. Confirm your access and retry.";
            return;
        }

        projectMembers.Data = response;
    }
    catch (HttpRequestException)
    {
        if (detailsVersion == projectDetailsVersion &&
            requestVersion == projectMembersRequestVersion)
        {
            projectMembers.Data = null;
            projectMembers.Error =
                "The project member service could not be reached.";
        }
    }
    catch (JsonException)
    {
        if (detailsVersion == projectDetailsVersion &&
            requestVersion == projectMembersRequestVersion)
        {
            projectMembers.Data = null;
            projectMembers.Error =
                "The project member service returned an invalid response.";
        }
    }
    finally
    {
        if (detailsVersion == projectDetailsVersion &&
            requestVersion == projectMembersRequestVersion)
        {
            projectMembers.IsLoading = false;
        }
    }
}


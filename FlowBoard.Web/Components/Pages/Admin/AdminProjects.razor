@page "/admin/projects"
@attribute [Authorize(Policy = AuthorizationPolicies.AdminOnly)]
@implements IDisposable

@using System.Text.Json
@using FlowBoard.Shared.DTOs.Auth
@using FlowBoard.Shared.DTOs.Boards
@using FlowBoard.Shared.DTOs.Common
@using FlowBoard.Shared.DTOs.Projects
@using FlowBoard.Shared.DTOs.Workspaces
@using FlowBoard.Shared.Enums
@using FlowBoard.Web.Services.Api

@inject IProjectApiService ProjectApiService
@inject IWorkspaceApiService WorkspaceApiService
@inject IUserDirectoryApiService UserDirectoryApiService
@inject IBoardApiService BoardApiService
@inject ToastService ToastService

<PageTitle>Project Management | FlowBoard</PageTitle>

<div class="page-shell admin-projects-page">
    <PageHeader Title="Project Management"
                Eyebrow="Administration"
                Description="Create and manage projects across your workspaces.">
        <Actions>
            <button type="button" class="btn btn-primary" @onclick="OpenCreateForm">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Create project
            </button>
        </Actions>
    </PageHeader>

    @if (showProjectForm)
    {
        <section class="project-form-panel" aria-labelledby="project-form-title">
            <div class="project-panel-heading">
                <div>
                    <p class="section-label mb-1">Project settings</p>
                    <h2 id="project-form-title">@(isEditingProject ? "Edit project" : "Create a project")</h2>
                </div>
                <button type="button"
                        class="btn-close"
                        aria-label="Close project form"
                        disabled="@isSubmitting"
                        @onclick="CloseProjectForm"></button>
            </div>

            <EditForm Model="@(isEditingProject ? (object)updateRequest : createRequest)" OnValidSubmit="SaveProjectAsync" FormName="admin-project-form">
                <DataAnnotationsValidator />
                <div class="project-form-grid">
                    <div class="mb-3">
                        <label class="form-label" for="project-name">Project name</label>
                        @if (isEditingProject)
                        {
                            <InputText id="project-name" class="form-control" @bind-Value="updateRequest.Name" placeholder="e.g. Customer Portal Refresh" />
                            <ValidationMessage For="@(() => updateRequest.Name)" />
                        }
                        else
                        {
                            <InputText id="project-name" class="form-control" @bind-Value="createRequest.Name" placeholder="e.g. Customer Portal Refresh" />
                            <ValidationMessage For="@(() => createRequest.Name)" />
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="project-workspace">Workspace</label>
                        @if (isEditingProject)
                        {
                            <input id="project-workspace" class="form-control" value="@editingProject?.WorkspaceName" disabled />
                            <div class="form-text">The existing API does not support moving a project to another workspace.</div>
                        }
                        else
                        {
                            <InputSelect id="project-workspace" class="form-select" @bind-Value="createRequest.WorkspaceId">
                                <option value="@Guid.Empty">Select a workspace</option>
                                @foreach (var workspace in workspaces)
                                {
                                    <option value="@workspace.Id">@workspace.Name</option>
                                }
                            </InputSelect>
                            @if (!string.IsNullOrWhiteSpace(workspaceSelectionError))
                            {
                                <div class="text-danger small mt-1" role="alert">@workspaceSelectionError</div>
                            }
                        }
                    </div>

                    <div class="mb-3 project-form-wide">
                        <label class="form-label" for="project-description">Description <span class="text-muted fw-normal">(optional)</span></label>
                        @if (isEditingProject)
                        {
                            <InputTextArea id="project-description" class="form-control project-description-input" @bind-Value="updateRequest.Description" placeholder="Describe the project goals and scope." />
                            <ValidationMessage For="@(() => updateRequest.Description)" />
                        }
                        else
                        {
                            <InputTextArea id="project-description" class="form-control project-description-input" @bind-Value="createRequest.Description" placeholder="Describe the project goals and scope." />
                            <ValidationMessage For="@(() => createRequest.Description)" />
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="project-start-date">Start date</label>
                        @if (isEditingProject)
                        {
                            <InputDate id="project-start-date" class="form-control" @bind-Value="updateRequest.StartDate" />
                            <ValidationMessage For="@(() => updateRequest.StartDate)" />
                        }
                        else
                        {
                            <InputDate id="project-start-date" class="form-control" @bind-Value="createRequest.StartDate" />
                            <ValidationMessage For="@(() => createRequest.StartDate)" />
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="project-end-date">End date</label>
                        @if (isEditingProject)
                        {
                            <InputDate id="project-end-date" class="form-control" @bind-Value="updateRequest.EndDate" />
                            <ValidationMessage For="@(() => updateRequest.EndDate)" />
                        }
                        else
                        {
                            <InputDate id="project-end-date" class="form-control" @bind-Value="createRequest.EndDate" />
                            <ValidationMessage For="@(() => createRequest.EndDate)" />
                        }
                    </div>

                    <div class="mb-3 project-form-wide">
                        <label class="form-label" for="project-manager-search">
                            Project Manager
                            @if (!isEditingProject)
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>
                        @if (isEditingProject && editingProject is not null)
                        {
                            <div class="current-manager">
                                <UserAvatar FirstName="@editingProject.Manager.FirstName" LastName="@editingProject.Manager.LastName" />
                                <span class="project-person-copy">
                                    <strong>@GetFullName(editingProject.Manager.FirstName, editingProject.Manager.LastName)</strong>
                                    <small>@editingProject.Manager.Email · current manager</small>
                                </span>
                            </div>
                        }

                        <SearchBox Value="@managerSearch"
                                   ValueChanged="HandleManagerSearchChanged"
                                   Placeholder="Search manager accounts by name or email" />
                        <p class="project-form-help">The directory does not include roles. The backend requires a Manager who has access to the selected workspace.</p>

                        @if (!string.IsNullOrWhiteSpace(managerSelectionError))
                        {
                            <div class="project-form-error" role="alert">@managerSelectionError</div>
                        }
                        @if (isLoadingManagerCandidates)
                        {
                            <div class="project-inline-loading" role="status"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Searching accounts...</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(managerCandidateError))
                        {
                            <div class="project-error compact" role="alert">
                                <span>@managerCandidateError</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => LoadManagerCandidatesAsync(1)">Retry</button>
                            </div>
                        }
                        else if (managerCandidates is { Items.Count: 0 })
                        {
                            <p class="project-empty-hint">No accounts match this search.</p>
                        }
                        else if (managerCandidates is not null)
                        {
                            <div class="manager-candidate-list">
                                @foreach (var candidate in managerCandidates.Items)
                                {
                                    <button type="button"
                                            class="project-person-row manager-candidate @(selectedManager?.UserId == candidate.UserId ? "project-person-selected" : null)"
                                            @onclick="() => SelectManager(candidate)">
                                        <UserAvatar FirstName="@candidate.FirstName" LastName="@candidate.LastName" />
                                        <span class="project-person-copy">
                                            <strong>@GetFullName(candidate.FirstName, candidate.LastName)</strong>
                                            <small>@candidate.Email</small>
                                        </span>
                                        @if (selectedManager?.UserId == candidate.UserId)
                                        {
                                            <i class="bi bi-check2" aria-label="Selected"></i>
                                        }
                                    </button>
                                }
                            </div>
                            <Pagination CurrentPage="@managerCandidates.Page"
                                        TotalPages="@managerCandidates.TotalPages"
                                        TotalCount="@managerCandidates.TotalCount"
                                        PageChanged="LoadManagerCandidatesAsync" />
                        }
                        @if (selectedManager is not null)
                        {
                            <div class="selected-manager-note">
                                Selected: <strong>@GetFullName(selectedManager.FirstName, selectedManager.LastName)</strong>
                                <button type="button" class="btn btn-link btn-sm p-0 ms-2" @onclick="ClearSelectedManager">Clear</button>
                            </div>
                        }
                    </div>

                    @if (isEditingProject)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="project-status">Status</label>
                            <InputSelect id="project-status" class="form-select" @bind-Value="updateRequest.Status">
                                @foreach (var status in Enum.GetValues<ProjectStatus>())
                                {
                                    <option value="@status">@GetStatusLabel(status)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3 project-form-help project-status-help">
                            Project status can be changed through the existing update API.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 project-form-wide">
                            <p class="project-form-help mb-0">New projects are created with Active status by the existing API. Status can be changed after creation.</p>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(projectFormError))
                {
                    <div class="project-error compact" role="alert">@projectFormError</div>
                }

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary" disabled="@isSubmitting" @onclick="CloseProjectForm">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @(isSubmitting ? "Saving..." : isEditingProject ? "Save changes" : "Create project")
                    </button>
                </div>
            </EditForm>
        </section>
    }

    <section class="project-list-panel" aria-labelledby="project-list-title">
        <div class="project-panel-heading">
            <div>
                <h2 id="project-list-title">Projects</h2>
                <p>Review projects and their workspace, manager, and current status.</p>
            </div>
            @if (projectPage is not null)
            {
                <span class="project-total-count">@projectPage.TotalCount.ToString("N0") projects</span>
            }
        </div>

        <div class="project-filter-grid">
            <div class="project-search">
                <SearchBox Value="@projectSearch"
                           ValueChanged="HandleProjectSearchChanged"
                           Placeholder="Search projects by name or description" />
            </div>
            <div>
                <label class="visually-hidden" for="workspace-filter">Filter by workspace</label>
                <select id="workspace-filter" class="form-select" value="@workspaceFilter" @onchange="HandleWorkspaceFilterChanged">
                    <option value="">All workspaces</option>
                    @foreach (var workspace in workspaces)
                    {
                        <option value="@workspace.Id">@workspace.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="visually-hidden" for="status-filter">Filter by status</label>
                <select id="status-filter" class="form-select" value="@statusFilter" @onchange="HandleStatusFilterChanged">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<ProjectStatus>())
                    {
                        <option value="@status">@GetStatusLabel(status)</option>
                    }
                </select>
            </div>
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@(!HasActiveFilters)"
                    @onclick="ClearFilters">
                <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Clear filters
            </button>
        </div>

        @if (isLoadingWorkspaces)
        {
            <div class="workspace-options-loading" role="status">
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                <span>Loading workspace options...</span>
            </div>
        }
        @if (workspaceLoadError is not null)
        {
            <div class="project-error compact" role="alert">@workspaceLoadError Workspace filtering and project creation may be limited.</div>
        }

        @if (!string.IsNullOrWhiteSpace(projectListError))
        {
            <div class="project-error" role="alert">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <span>@projectListError</span>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => LoadProjectsAsync(currentProjectPage)">Retry</button>
            </div>
        }
        else if (isLoadingProjects)
        {
            <div class="project-loading" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                <span>Loading projects...</span>
            </div>
        }
        else if (projectPage is not null && projectPage.Items.Count == 0)
        {
            <EmptyState Title="@(HasActiveFilters ? "No matching projects" : "No projects yet")"
                        Message="@(HasActiveFilters ? "Try changing or clearing the selected filters." : "Create a project to begin organizing work across your workspaces.")">
                @if (!HasActiveFilters)
                {
                    <button type="button" class="btn btn-primary" @onclick="OpenCreateForm">Create your first project</button>
                }
            </EmptyState>
        }
        else if (projectPage is not null)
        {
            <div class="project-table-wrap">
                <table class="table project-table">
                    <thead>
                        <tr>
                            <th scope="col">Project</th>
                            <th scope="col">Workspace</th>
                            <th scope="col">Manager</th>
                            <th scope="col">Status</th>
                            <th scope="col">Updated</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in projectPage.Items)
                        {
                            <tr @key="project.ProjectId">
                                <td>
                                    <div class="project-name-cell">
                                        <span class="project-avatar" aria-hidden="true"><i class="bi bi-kanban"></i></span>
                                        <span class="project-name-copy">
                                            <strong>@project.Name</strong>
                                            <small>@(string.IsNullOrWhiteSpace(project.Description) ? "No description" : project.Description)</small>
                                        </span>
                                    </div>
                                </td>
                                <td>@project.WorkspaceName</td>
                                <td>
                                    <span class="project-manager-cell">
                                        <UserAvatar FirstName="@project.Manager.FirstName" LastName="@project.Manager.LastName" SizeRem="1.6" />
                                        <span>@GetFullName(project.Manager.FirstName, project.Manager.LastName)</span>
                                    </span>
                                </td>
                                <td><span class="project-status-badge @GetStatusClass(project.Status)">@GetStatusLabel(project.Status)</span></td>
                                <td class="project-date-cell">@GetProjectDate(project)</td>
                                <td class="project-actions-cell">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenProjectDetailsAsync(project)">
                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>Details
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="@($"Edit {project.Name}")" @onclick="() => OpenEditForm(project)">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" aria-label="@($"Delete {project.Name}")" @onclick="() => RequestProjectDeletion(project)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="project-mobile-list">
                @foreach (var project in projectPage.Items)
                {
                    <article class="project-mobile-card" @key="project.ProjectId">
                        <div class="project-mobile-heading">
                            <span class="project-avatar" aria-hidden="true"><i class="bi bi-kanban"></i></span>
                            <span class="project-name-copy">
                                <strong>@project.Name</strong>
                                <small>@project.WorkspaceName</small>
                            </span>
                            <span class="project-status-badge @GetStatusClass(project.Status)">@GetStatusLabel(project.Status)</span>
                        </div>
                        <p class="project-mobile-description">@(string.IsNullOrWhiteSpace(project.Description) ? "No description" : project.Description)</p>
                        <div class="project-mobile-meta">
                            <span>Manager: @GetFullName(project.Manager.FirstName, project.Manager.LastName)</span>
                            <span>Updated: @GetProjectDate(project)</span>
                        </div>
                        <div class="project-mobile-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenProjectDetailsAsync(project)">Details</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditForm(project)">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RequestProjectDeletion(project)">Delete</button>
                        </div>
                    </article>
                }
            </div>

            <Pagination CurrentPage="@projectPage.Page"
                        TotalPages="@projectPage.TotalPages"
                        TotalCount="@projectPage.TotalCount"
                        PageChanged="LoadProjectsAsync" />
        }
    </section>

    @if (selectedProject is not null)
    {
        <section class="project-details-panel" aria-labelledby="project-details-title">
            <div class="project-details-header">
                <div class="project-details-identity">
                    <span class="project-avatar project-avatar-large" aria-hidden="true"><i class="bi bi-kanban"></i></span>
                    <div>
                        <p class="section-label mb-1">Project details</p>
                        <h2 id="project-details-title">@selectedProject.Name</h2>
                        <p>@(string.IsNullOrWhiteSpace(selectedProject.Description) ? "No description provided." : selectedProject.Description)</p>
                    </div>
                </div>
                <div class="project-detail-actions">
                    <span class="project-status-badge @GetStatusClass(selectedProject.Status)">@GetStatusLabel(selectedProject.Status)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditForm(selectedProject)">Edit</button>
                    <button type="button" class="btn-close" aria-label="Close project details" @onclick="CloseProjectDetails"></button>
                </div>
            </div>

            <div class="project-facts">
                <div><span>Workspace</span><strong>@selectedProject.WorkspaceName</strong></div>
                <div>
                    <span>Project Manager</span>
                    <strong>@GetFullName(selectedProject.Manager.FirstName, selectedProject.Manager.LastName)</strong>
                    <small>@selectedProject.Manager.Email</small>
                </div>
                <div><span>Schedule</span><strong>@selectedProject.StartDate.ToLocalTime().ToString("MMM d, yyyy") – @selectedProject.EndDate.ToLocalTime().ToString("MMM d, yyyy")</strong></div>
                <div><span>Created</span><strong>@selectedProject.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</strong></div>
                @if (selectedProject.ModifiedAt.HasValue)
                {
                    <div><span>Updated</span><strong>@selectedProject.ModifiedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</strong></div>
                }
            </div>

            <p class="project-domain-note">Project membership does not automatically grant board membership. The board list below includes only boards whose ProjectId matches this project.</p>

            <div class="project-detail-grid">
                <section class="project-detail-section" aria-labelledby="project-members-title">
                    <div class="project-subsection-heading">
                        <div>
                            <h3 id="project-members-title">Project members</h3>
                            <p>Eligible Employee accounts only, validated by the API.</p>
                        </div>
                        @if (projectMembersPage is not null)
                        {
                            <span class="project-detail-count">@projectMembersPage.TotalCount.ToString("N0")</span>
                        }
                    </div>

                    <label class="form-label" for="member-directory-search">Find an account to add</label>
                    <SearchBox Value="@memberCandidateSearch"
                               ValueChanged="HandleMemberCandidateSearchChanged"
                               Placeholder="Search by name or email" />
                    <p class="project-form-help">The directory has no role field; the API accepts only Employee accounts and rejects duplicate membership.</p>
                    @if (!string.IsNullOrWhiteSpace(memberOperationError))
                    {
                        <div class="project-error compact" role="alert">@memberOperationError</div>
                    }
                    @if (isLoadingMemberCandidates)
                    {
                        <div class="project-inline-loading" role="status"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Searching accounts...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(memberCandidateError))
                    {
                        <div class="project-error compact" role="alert">
                            <span>@memberCandidateError</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => LoadMemberCandidatesAsync(1)">Retry</button>
                        </div>
                    }
                    else if (memberCandidates is { Items.Count: 0 })
                    {
                        <p class="project-empty-hint">No accounts match this search.</p>
                    }
                    else if (memberCandidates is not null)
                    {
                        <div class="project-member-candidate-list">
                            @foreach (var candidate in memberCandidates.Items)
                            {
                                var isManager = selectedProject.ManagerId == candidate.UserId;
                                var isMember = projectMembersPage?.Items.Any(member => member.UserId == candidate.UserId) == true;
                                <div class="project-person-row" @key="candidate.UserId">
                                    <UserAvatar FirstName="@candidate.FirstName" LastName="@candidate.LastName" />
                                    <span class="project-person-copy">
                                        <strong>@GetFullName(candidate.FirstName, candidate.LastName)</strong>
                                        <small>@candidate.Email</small>
                                    </span>
                                    @if (isManager)
                                    {
                                        <span class="project-person-badge">Manager</span>
                                    }
                                    else if (isMember)
                                    {
                                        <span class="project-person-badge member-badge">Member</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@isSubmitting" @onclick="() => AddProjectMemberAsync(candidate)">
                                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <Pagination CurrentPage="@memberCandidates.Page"
                                    TotalPages="@memberCandidates.TotalPages"
                                    TotalCount="@memberCandidates.TotalCount"
                                    PageChanged="LoadMemberCandidatesAsync" />
                    }

                    <div class="project-member-list-heading">
                        <label class="form-label" for="project-member-search">Current members</label>
                        <SearchBox Value="@memberSearch"
                                   ValueChanged="HandleMemberSearchChanged"
                                   Placeholder="Filter members by name or email" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(projectMembersError))
                    {
                        <div class="project-error compact" role="alert">
                            <span>@projectMembersError</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="RetryProjectMembersAsync">Retry</button>
                        </div>
                    }
                    else if (isLoadingProjectMembers)
                    {
                        <div class="project-inline-loading" role="status"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Loading project members...</div>
                    }
                    else if (projectMembersPage is not null && projectMembersPage.Items.Count == 0)
                    {
                        <EmptyState Title="@(projectMembersPage.TotalCount == 0 ? "No project members" : "No matching members")"
                                    Message="@(projectMembersPage.TotalCount == 0 ? "Add Employee accounts to this project as needed." : "Try another name or email address.")" />
                    }
                    else if (projectMembersPage is not null)
                    {
                        <div class="project-current-member-list">
                            @foreach (var member in projectMembersPage.Items)
                            {
                                <div class="project-person-row" @key="member.UserId">
                                    <UserAvatar FirstName="@member.User.FirstName" LastName="@member.User.LastName" />
                                    <span class="project-person-copy">
                                        <strong>@GetFullName(member.User.FirstName, member.User.LastName)</strong>
                                        <small>@member.User.Email</small>
                                    </span>
                                    <span class="project-joined-date">@member.JoinedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                    @if (pendingRemovalUserId == member.UserId)
                                    {
                                        <span class="project-remove-confirm">
                                            <span>Remove?</span>
                                            <button type="button" class="btn btn-sm btn-danger" disabled="@isSubmitting" @onclick="() => RemoveProjectMemberAsync(member)">Confirm</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@isSubmitting" @onclick="CancelMemberRemoval">Cancel</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" aria-label="@($"Remove {member.User.FirstName} {member.User.LastName} from project")" @onclick="() => RequestMemberRemoval(member.UserId)">Remove</button>
                                    }
                                </div>
                            }
                        </div>
                        <Pagination CurrentPage="@projectMembersPage.Page"
                                    TotalPages="@projectMembersPage.TotalPages"
                                    TotalCount="@projectMembersPage.TotalCount"
                                    PageChanged="LoadProjectMemberPageAsync" />
                    }
                </section>

                <section class="project-detail-section" aria-labelledby="project-boards-title">
                    <div class="project-subsection-heading">
                        <div>
                            <h3 id="project-boards-title">Project boards</h3>
                            <p>Boards attached to this project only; no board actions are available here.</p>
                        </div>
                        @if (projectBoards is not null)
                        {
                            <span class="project-detail-count">@projectBoards.Count.ToString("N0")</span>
                        }
                    </div>
                    @if (isLoadingProjectBoards)
                    {
                        <div class="project-inline-loading" role="status"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>Loading project boards...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(projectBoardsError))
                    {
                        <div class="project-error compact" role="alert">
                            <span>@projectBoardsError</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="RetryProjectBoardsAsync">Retry</button>
                        </div>
                    }
                    else if (projectBoards is { Count: 0 })
                    {
                        <EmptyState Title="No project boards" Message="No boards are associated with this project." />
                    }
                    else if (projectBoards is not null)
                    {
                        <div class="project-board-list">
                            @foreach (var board in projectBoards)
                            {
                                <article class="project-board-row" @key="board.Id">
                                    <span class="project-board-icon" aria-hidden="true"><i class="bi bi-columns-gap"></i></span>
                                    <span class="project-person-copy">
                                        <strong>@board.Name</strong>
                                        <small>@board.Purpose · Created @board.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</small>
                                    </span>
                                </article>
                            }
                        </div>
                    }
                </section>
            </div>
        </section>
    }

    <ConfirmationDialog IsOpen="@(projectPendingDeletion is not null)"
                        Title="@(projectPendingDeletion is null ? string.Empty : $"Delete {projectPendingDeletion.Name}?")"
                        ConfirmText="Delete project"
                        ConfirmingText="Deleting..."
                        IsBusy="@isSubmitting"
                        OnCancel="CancelProjectDeletion"
                        OnConfirm="DeleteProjectAsync">
        <p>Projects with associated boards or members cannot be deleted. This will not remove boards, cards, members, or other dependent resources.</p>
        @if (!string.IsNullOrWhiteSpace(deleteProjectError))
        {
            <div class="project-error compact" role="alert">@deleteProjectError</div>
        }
    </ConfirmationDialog>
</div>

@code {
    private const int ProjectPageSize = 10;
    private const int ProjectMemberPageSize = 10;
    private const int ResourcePageSize = 100;
    private const int WorkspacePageSize = 100;
    private const int DirectoryPageSize = 10;

    private PagedResponse<ProjectResponse>? projectPage;
    private List<WorkspaceResponse> workspaces = [];
    private ProjectResponse? selectedProject;
    private ProjectResponse? editingProject;
    private ProjectResponse? projectPendingDeletion;
    private CreateProjectRequest createRequest = NewCreateRequest();
    private UpdateProjectRequest updateRequest = NewUpdateRequest();
    private PagedResponse<UserDirectoryResponse>? managerCandidates;
    private PagedResponse<UserDirectoryResponse>? memberCandidates;
    private UserDirectoryResponse? selectedManager;
    private PagedResponse<ProjectMemberResponse>? projectMembersPage;
    private List<BoardResponse>? projectBoards;
    private string? projectSearch;
    private string? workspaceFilter;
    private string? statusFilter;
    private string? managerSearch;
    private string? memberCandidateSearch;
    private string? memberSearch;
    private string? projectListError;
    private string? workspaceLoadError;
    private string? projectFormError;
    private string? workspaceSelectionError;
    private string? managerSelectionError;
    private string? managerCandidateError;
    private string? memberCandidateError;
    private string? memberOperationError;
    private string? projectMembersError;
    private string? projectBoardsError;
    private string? deleteProjectError;
    private int currentProjectPage = 1;
    private int managerCandidatePage = 1;
    private int memberCandidatePage = 1;
    private int memberListPage = 1;
    private Guid? pendingRemovalUserId;
    private bool isLoadingProjects = true;
    private bool isLoadingWorkspaces;
    private bool isLoadingManagerCandidates;
    private bool isLoadingMemberCandidates;
    private bool isLoadingProjectMembers;
    private bool isLoadingProjectBoards;
    private bool isSubmitting;
    private bool showProjectForm;
    private bool isEditingProject;
    private long projectRequestVersion;
    private long managerCandidateVersion;
    private long memberCandidateVersion;
    private long projectDetailsVersion;
    private long projectMembersRequestVersion;
    private CancellationTokenSource? projectSearchDebounce;
    private CancellationTokenSource? managerSearchDebounce;
    private CancellationTokenSource? memberCandidateSearchDebounce;
    private CancellationTokenSource? memberSearchDebounce;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(projectSearch) ||
        !string.IsNullOrWhiteSpace(workspaceFilter) ||
        !string.IsNullOrWhiteSpace(statusFilter);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadWorkspacesAsync(), LoadProjectsAsync(1));
    }

    private async Task LoadWorkspacesAsync()
    {
        isLoadingWorkspaces = true;
        workspaceLoadError = null;
        try
        {
            var firstPage = await WorkspaceApiService.GetAsync(
                new PagedSearchRequest { Page = 1, PageSize = WorkspacePageSize });
            if (firstPage is null)
            {
                workspaceLoadError = "Workspace options could not be loaded.";
                return;
            }

            var result = firstPage.Items.ToList();
            for (var page = 2; page <= firstPage.TotalPages; page++)
            {
                var response = await WorkspaceApiService.GetAsync(
                    new PagedSearchRequest { Page = page, PageSize = WorkspacePageSize });
                if (response is null)
                {
                    workspaceLoadError = "The workspace list could not be loaded completely.";
                    return;
                }

                result.AddRange(response.Items);
            }

            workspaces = result.OrderBy(workspace => workspace.Name).ToList();
        }
        catch (HttpRequestException)
        {
            workspaceLoadError = "The workspace service could not be reached.";
        }
        catch (JsonException)
        {
            workspaceLoadError = "The workspace service returned an invalid response.";
        }
        finally
        {
            isLoadingWorkspaces = false;
        }
    }

    private async Task LoadProjectsAsync(int page)
    {
        var version = ++projectRequestVersion;
        currentProjectPage = page;
        isLoadingProjects = true;
        projectListError = null;
        try
        {
            var request = new ProjectQueryRequest
            {
                Page = page,
                PageSize = ProjectPageSize,
                Search = string.IsNullOrWhiteSpace(projectSearch) ? null : projectSearch,
                WorkspaceId = Guid.TryParse(workspaceFilter, out var workspaceId) ? workspaceId : null,
                Status = Enum.TryParse<ProjectStatus>(statusFilter, out var status) ? status : null
            };
            var response = await ProjectApiService.GetAsync(request);
            if (version != projectRequestVersion)
            {
                return;
            }

            if (response is null)
            {
                projectPage = null;
                projectListError = "Projects could not be loaded. Confirm your Admin access and retry.";
                return;
            }

            projectPage = response;
            if (selectedProject is not null)
            {
                selectedProject = response.Items.FirstOrDefault(
                    project => project.ProjectId == selectedProject.ProjectId) ?? selectedProject;
            }
        }
        catch (HttpRequestException)
        {
            if (version == projectRequestVersion)
            {
                projectPage = null;
                projectListError = "The project service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == projectRequestVersion)
            {
                projectPage = null;
                projectListError = "The project service returned an invalid response.";
            }
        }
        finally
        {
            if (version == projectRequestVersion)
            {
                isLoadingProjects = false;
            }
        }
    }

    private async Task HandleProjectSearchChanged(string? value)
    {
        projectSearch = value?.Trim();
        await DebounceProjectFiltersAsync();
    }

    private async Task HandleWorkspaceFilterChanged(ChangeEventArgs args)
    {
        workspaceFilter = args.Value?.ToString();
        await LoadProjectsAsync(1);
    }

    private async Task HandleStatusFilterChanged(ChangeEventArgs args)
    {
        statusFilter = args.Value?.ToString();
        await LoadProjectsAsync(1);
    }

    private async Task DebounceProjectFiltersAsync()
    {
        projectSearchDebounce?.Cancel();
        projectSearchDebounce?.Dispose();
        projectSearchDebounce = new CancellationTokenSource();
        var token = projectSearchDebounce.Token;
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), token);
            if (!token.IsCancellationRequested)
            {
                await LoadProjectsAsync(1);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private async Task ClearFilters()
    {
        projectSearch = null;
        workspaceFilter = null;
        statusFilter = null;
        projectSearchDebounce?.Cancel();
        await LoadProjectsAsync(1);
    }

    private void OpenCreateForm()
    {
        isEditingProject = false;
        editingProject = null;
        ResetManagerCandidates();
        managerSearch = null;
        projectFormError = null;
        workspaceSelectionError = null;
        managerSelectionError = null;
        createRequest = NewCreateRequest();
        showProjectForm = true;
    }

    private void OpenEditForm(ProjectResponse project)
    {
        isEditingProject = true;
        editingProject = project;
        ResetManagerCandidates();
        managerSelectionError = null;
        projectFormError = null;
        managerSearch = null;
        updateRequest = new UpdateProjectRequest
        {
            Name = project.Name,
            Description = project.Description,
            Status = project.Status,
            StartDate = project.StartDate,
            EndDate = project.EndDate
        };
        showProjectForm = true;
    }

    private void CloseProjectForm()
    {
        if (isSubmitting)
        {
            return;
        }

        showProjectForm = false;
        projectFormError = null;
        workspaceSelectionError = null;
        managerSelectionError = null;
        editingProject = null;
    }

    private async Task SaveProjectAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        projectFormError = null;
        workspaceSelectionError = null;
        managerSelectionError = null;

        if (!isEditingProject && createRequest.WorkspaceId == Guid.Empty)
        {
            workspaceSelectionError = "Select a workspace.";
            return;
        }

        var managerId = selectedManager?.UserId;
        if (!isEditingProject && !managerId.HasValue)
        {
            managerSelectionError = "Select a Project Manager.";
            return;
        }

        isSubmitting = true;
        try
        {
            if (isEditingProject)
            {
                if (editingProject is null)
                {
                    projectFormError = "Select a project to edit.";
                    return;
                }

                var updated = await ProjectApiService.UpdateAsync(
                    editingProject.ProjectId,
                    new UpdateProjectRequest
                    {
                        Name = updateRequest.Name,
                        Description = updateRequest.Description,
                        ManagerId = managerId,
                        Status = updateRequest.Status,
                        StartDate = updateRequest.StartDate,
                        EndDate = updateRequest.EndDate
                    });
                if (updated is null)
                {
                    projectFormError = "The project was not updated. Check the API message and retry.";
                    return;
                }

                showProjectForm = false;
                selectedProject = updated;
                ToastService.Success($"Project \"{updated.Name}\" updated.");
                await LoadProjectsAsync(currentProjectPage);
                await LoadProjectDetailsAsync(updated);
            }
            else
            {
                var created = await ProjectApiService.CreateAsync(
                    new CreateProjectRequest
                    {
                        Name = createRequest.Name,
                        Description = createRequest.Description,
                        WorkspaceId = createRequest.WorkspaceId,
                        ManagerId = managerId,
                        StartDate = createRequest.StartDate,
                        EndDate = createRequest.EndDate
                    });
                if (created is null)
                {
                    projectFormError = "The project was not created. Confirm the selected Manager has access to the workspace.";
                    return;
                }

                showProjectForm = false;
                ToastService.Success($"Project \"{created.Name}\" created.");
                await LoadProjectsAsync(1);
                await OpenProjectDetailsAsync(created);
            }
        }
        catch (HttpRequestException)
        {
            projectFormError = "The project service could not be reached.";
        }
        catch (JsonException)
        {
            projectFormError = "The project service returned an invalid response.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OpenProjectDetailsAsync(ProjectResponse project)
    {
        ProjectResponse? fullProject;
        try
        {
            fullProject = await ProjectApiService.GetByIdAsync(project.ProjectId);
        }
        catch (HttpRequestException)
        {
            ToastService.Error("The project service could not be reached.");
            return;
        }
        catch (JsonException)
        {
            ToastService.Error("The project service returned an invalid response.");
            return;
        }

        if (fullProject is null)
        {
            ToastService.Error("Project details could not be loaded.");
            return;
        }

        await LoadProjectDetailsAsync(fullProject);
    }

    private async Task LoadProjectDetailsAsync(ProjectResponse project)
    {
        memberCandidateVersion++;
        memberCandidateSearchDebounce?.Cancel();
        selectedProject = project;
        projectMembersPage = null;
        projectBoards = null;
        projectMembersError = null;
        projectBoardsError = null;
        memberOperationError = null;
        memberCandidates = null;
        memberCandidateError = null;
        memberCandidateSearch = null;
        memberCandidatePage = 1;
        memberSearch = null;
        memberListPage = 1;
        pendingRemovalUserId = null;
        memberCandidateSearchDebounce?.Cancel();
        var version = ++projectDetailsVersion;
        await Task.WhenAll(
            LoadProjectMembersAsync(version, project.ProjectId, 1),
            LoadProjectBoardsAsync(version, project));
    }

    private Task RetryProjectMembersAsync() =>
        selectedProject is null
            ? Task.CompletedTask
            : LoadProjectMembersAsync(projectDetailsVersion, selectedProject.ProjectId, memberListPage);

    private Task LoadProjectMemberPageAsync(int page) =>
        selectedProject is null
            ? Task.CompletedTask
            : LoadProjectMembersAsync(projectDetailsVersion, selectedProject.ProjectId, page);

    private Task RetryProjectBoardsAsync() =>
        selectedProject is null
            ? Task.CompletedTask
            : LoadProjectBoardsAsync(projectDetailsVersion, selectedProject);

    private void CloseProjectDetails()
    {
        projectDetailsVersion++;
        selectedProject = null;
        projectMembersPage = null;
        projectBoards = null;
        memberCandidates = null;
        pendingRemovalUserId = null;
        memberCandidateSearchDebounce?.Cancel();
        memberCandidateVersion++;
    }

    private void ResetManagerCandidates()
    {
        managerCandidateVersion++;
        managerSearchDebounce?.Cancel();
        managerSearchDebounce?.Dispose();
        managerSearchDebounce = null;
        selectedManager = null;
        managerCandidates = null;
        managerCandidateError = null;
        isLoadingManagerCandidates = false;
    }

    private async Task LoadProjectMembersAsync(
        long detailsVersion,
        Guid projectId,
        int page)
    {
        var requestVersion = ++projectMembersRequestVersion;
        memberListPage = page;
        isLoadingProjectMembers = true;
        projectMembersError = null;
        try
        {
            var response = await ProjectApiService.GetMembersAsync(
                projectId,
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = ProjectMemberPageSize,
                    Search = string.IsNullOrWhiteSpace(memberSearch) ? null : memberSearch
                });
            if (detailsVersion != projectDetailsVersion ||
                requestVersion != projectMembersRequestVersion)
            {
                return;
            }

            if (response is null)
            {
                projectMembersPage = null;
                projectMembersError = "Project members could not be loaded. Confirm your access and retry.";
                return;
            }

            if (detailsVersion == projectDetailsVersion &&
                requestVersion == projectMembersRequestVersion)
            {
                projectMembersPage = response;
            }
        }
        catch (HttpRequestException)
        {
            if (detailsVersion == projectDetailsVersion &&
                requestVersion == projectMembersRequestVersion)
            {
                projectMembersPage = null;
                projectMembersError = "The project member service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (detailsVersion == projectDetailsVersion &&
                requestVersion == projectMembersRequestVersion)
            {
                projectMembersPage = null;
                projectMembersError = "The project member service returned an invalid response.";
            }
        }
        finally
        {
            if (detailsVersion == projectDetailsVersion &&
                requestVersion == projectMembersRequestVersion)
            {
                isLoadingProjectMembers = false;
            }
        }
    }

    private async Task LoadProjectBoardsAsync(long detailsVersion, ProjectResponse project)
    {
        isLoadingProjectBoards = true;
        projectBoardsError = null;
        try
        {
            var firstPage = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    WorkspaceId = project.WorkspaceId,
                    Page = 1,
                    PageSize = ResourcePageSize
                });
            if (detailsVersion != projectDetailsVersion)
            {
                return;
            }

            if (firstPage is null)
            {
                projectBoards = null;
                projectBoardsError = "Project boards could not be loaded.";
                return;
            }

            var boards = firstPage.Items.ToList();
            for (var page = 2; page <= firstPage.TotalPages; page++)
            {
                var response = await BoardApiService.GetAsync(
                    new BoardQueryRequest
                    {
                        WorkspaceId = project.WorkspaceId,
                        Page = page,
                        PageSize = ResourcePageSize
                    });
                if (detailsVersion != projectDetailsVersion)
                {
                    return;
                }

                if (response is null)
                {
                    projectBoards = null;
                    projectBoardsError = "Workspace boards could not be fully loaded. Partial results are withheld.";
                    return;
                }

                boards.AddRange(response.Items);
            }

            if (detailsVersion == projectDetailsVersion)
            {
                projectBoards = boards
                    .Where(board =>
                        board.ProjectId == project.ProjectId &&
                        board.WorkspaceId == project.WorkspaceId)
                    .OrderBy(board => board.Name)
                    .ToList();
            }
        }
        catch (HttpRequestException)
        {
            if (detailsVersion == projectDetailsVersion)
            {
                projectBoards = null;
                projectBoardsError = "The board service could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (detailsVersion == projectDetailsVersion)
            {
                projectBoards = null;
                projectBoardsError = "The board service returned an invalid response.";
            }
        }
        finally
        {
            if (detailsVersion == projectDetailsVersion)
            {
                isLoadingProjectBoards = false;
            }
        }
    }

    private async Task HandleManagerSearchChanged(string? value)
    {
        managerSearch = value?.Trim();
        managerSearchDebounce?.Cancel();
        managerSearchDebounce?.Dispose();
        managerSearchDebounce = new CancellationTokenSource();
        var token = managerSearchDebounce.Token;
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), token);
            if (!token.IsCancellationRequested)
            {
                await LoadManagerCandidatesAsync(1);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private async Task LoadManagerCandidatesAsync(int page)
    {
        var version = ++managerCandidateVersion;
        managerCandidatePage = page;
        isLoadingManagerCandidates = true;
        managerCandidateError = null;
        try
        {
            var response = await UserDirectoryApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = DirectoryPageSize,
                    Search = string.IsNullOrWhiteSpace(managerSearch) ? null : managerSearch
                });
            if (version != managerCandidateVersion)
            {
                return;
            }

            if (response is null)
            {
                managerCandidates = null;
                managerCandidateError = "The account directory could not be loaded.";
                return;
            }

            managerCandidates = response;
        }
        catch (HttpRequestException)
        {
            if (version == managerCandidateVersion)
            {
                managerCandidates = null;
                managerCandidateError = "The account directory could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == managerCandidateVersion)
            {
                managerCandidates = null;
                managerCandidateError = "The account directory returned an invalid response.";
            }
        }
        finally
        {
            if (version == managerCandidateVersion)
            {
                isLoadingManagerCandidates = false;
            }
        }
    }

    private void SelectManager(UserDirectoryResponse manager)
    {
        selectedManager = manager;
        managerSelectionError = null;
    }

    private void ClearSelectedManager()
    {
        selectedManager = null;
    }

    private async Task HandleMemberCandidateSearchChanged(string? value)
    {
        memberCandidateSearch = value?.Trim();
        memberCandidateSearchDebounce?.Cancel();
        memberCandidateSearchDebounce?.Dispose();
        memberCandidateSearchDebounce = new CancellationTokenSource();
        var token = memberCandidateSearchDebounce.Token;
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), token);
            if (!token.IsCancellationRequested)
            {
                await LoadMemberCandidatesAsync(1);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private async Task LoadMemberCandidatesAsync(int page)
    {
        var version = ++memberCandidateVersion;
        memberCandidatePage = page;
        isLoadingMemberCandidates = true;
        memberCandidateError = null;
        try
        {
            var response = await UserDirectoryApiService.GetAsync(
                new PagedSearchRequest
                {
                    Page = page,
                    PageSize = DirectoryPageSize,
                    Search = string.IsNullOrWhiteSpace(memberCandidateSearch) ? null : memberCandidateSearch
                });
            if (version != memberCandidateVersion)
            {
                return;
            }

            if (response is null)
            {
                memberCandidates = null;
                memberCandidateError = "The account directory could not be loaded.";
                return;
            }

            memberCandidates = response;
        }
        catch (HttpRequestException)
        {
            if (version == memberCandidateVersion)
            {
                memberCandidates = null;
                memberCandidateError = "The account directory could not be reached.";
            }
        }
        catch (JsonException)
        {
            if (version == memberCandidateVersion)
            {
                memberCandidates = null;
                memberCandidateError = "The account directory returned an invalid response.";
            }
        }
        finally
        {
            if (version == memberCandidateVersion)
            {
                isLoadingMemberCandidates = false;
            }
        }
    }

    private async Task AddProjectMemberAsync(UserDirectoryResponse candidate)
    {
        if (selectedProject is null || isSubmitting)
        {
            return;
        }

        memberOperationError = null;
        if (projectMembersPage?.Items.Any(member => member.UserId == candidate.UserId) == true)
        {
            ToastService.Warning("This account is already a project member.");
            return;
        }

        isSubmitting = true;
        try
        {
            var added = await ProjectApiService.AddMemberAsync(
                selectedProject.ProjectId,
                new AddProjectMemberRequest { UserId = candidate.UserId });
            if (added is null)
            {
                memberOperationError = "Membership was not added. The backend accepts only eligible Employee accounts.";
                return;
            }

            await LoadProjectMembersAsync(projectDetailsVersion, selectedProject.ProjectId, 1);
        }
        catch (HttpRequestException)
        {
            memberOperationError = "The project service could not be reached. Membership was not confirmed.";
        }
        catch (JsonException)
        {
            memberOperationError = "The project service returned an invalid response. Refresh membership to confirm the result.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleMemberSearchChanged(string? value)
    {
        memberSearch = value?.Trim();
        memberSearchDebounce?.Cancel();
        memberSearchDebounce?.Dispose();
        memberSearchDebounce = new CancellationTokenSource();
        var token = memberSearchDebounce.Token;
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), token);
            if (!token.IsCancellationRequested && selectedProject is not null)
            {
                await LoadProjectMembersAsync(
                    projectDetailsVersion,
                    selectedProject.ProjectId,
                    1);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private void RequestMemberRemoval(Guid userId)
    {
        pendingRemovalUserId = userId;
    }

    private void CancelMemberRemoval()
    {
        if (!isSubmitting)
        {
            pendingRemovalUserId = null;
        }
    }

    private async Task RemoveProjectMemberAsync(ProjectMemberResponse member)
    {
        if (selectedProject is null || isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        memberOperationError = null;
        try
        {
            var removed = await ProjectApiService.RemoveMemberAsync(
                selectedProject.ProjectId,
                member.UserId);
            if (!removed)
            {
                memberOperationError = "Membership was not removed. Associated board memberships or task dependencies may need to be resolved first.";
                return;
            }

            pendingRemovalUserId = null;
            var page = projectMembersPage?.Items.Count == 1 && memberListPage > 1
                ? memberListPage - 1
                : memberListPage;
            await LoadProjectMembersAsync(projectDetailsVersion, selectedProject.ProjectId, page);
        }
        catch (HttpRequestException)
        {
            memberOperationError = "The project service could not be reached. Membership was not confirmed as removed.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void RequestProjectDeletion(ProjectResponse project)
    {
        projectPendingDeletion = project;
        deleteProjectError = null;
    }

    private void CancelProjectDeletion()
    {
        if (!isSubmitting)
        {
            projectPendingDeletion = null;
            deleteProjectError = null;
        }
    }

    private async Task DeleteProjectAsync()
    {
        if (projectPendingDeletion is null || isSubmitting)
        {
            return;
        }

        var project = projectPendingDeletion;
        isSubmitting = true;
        deleteProjectError = null;
        try
        {
            var deleted = await ProjectApiService.DeleteAsync(project.ProjectId);
            if (!deleted)
            {
                deleteProjectError = "The project was not deleted. Associated boards or members may block deletion; none were removed.";
                return;
            }

            projectPendingDeletion = null;
            if (selectedProject?.ProjectId == project.ProjectId)
            {
                CloseProjectDetails();
            }

            ToastService.Success($"Project \"{project.Name}\" deleted.");
            var targetPage = projectPage?.Items.Count == 1 && currentProjectPage > 1
                ? currentProjectPage - 1
                : currentProjectPage;
            await LoadProjectsAsync(targetPage);
        }
        catch (HttpRequestException)
        {
            deleteProjectError = "The project service could not be reached. The project was not deleted.";
        }
        catch (JsonException)
        {
            deleteProjectError = "The project service returned an invalid response. Refresh the list to confirm the result.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static CreateProjectRequest NewCreateRequest() => new()
    {
        StartDate = DateTime.Today,
        EndDate = DateTime.Today.AddDays(30)
    };

    private static UpdateProjectRequest NewUpdateRequest() => new()
    {
        StartDate = DateTime.Today,
        EndDate = DateTime.Today.AddDays(30)
    };

    private static string GetFullName(string firstName, string lastName)
    {
        var fullName = $"{firstName} {lastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? "Unnamed account" : fullName;
    }

    private static string GetProjectDate(ProjectResponse project) =>
        (project.ModifiedAt ?? project.CreatedAt).ToLocalTime().ToString("MMM d, yyyy");

    private static string GetStatusLabel(ProjectStatus status) => status switch
    {
        ProjectStatus.Active => "Active",
        ProjectStatus.Completed => "Completed",
        ProjectStatus.OnHold => "On hold",
        _ => status.ToString()
    };

    private static string GetStatusClass(ProjectStatus status) => status switch
    {
        ProjectStatus.Active => "status-active",
        ProjectStatus.Completed => "status-completed",
        ProjectStatus.OnHold => "status-on-hold",
        _ => "status-unknown"
    };

    public void Dispose()
    {
        projectSearchDebounce?.Cancel();
        projectSearchDebounce?.Dispose();
        managerSearchDebounce?.Cancel();
        managerSearchDebounce?.Dispose();
        memberCandidateSearchDebounce?.Cancel();
        memberCandidateSearchDebounce?.Dispose();
        memberSearchDebounce?.Cancel();
        memberSearchDebounce?.Dispose();
    }
}

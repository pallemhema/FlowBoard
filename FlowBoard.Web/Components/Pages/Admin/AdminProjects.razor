private async Task LoadProjectBoardsAsync(
    long detailsVersion,
    ProjectResponse project)
{
    projectBoardsLoad.IsLoading = true;
    projectBoardsLoad.Error = null;

    try
    {
        var firstPage = await BoardApiService.GetAsync(
            new BoardQueryRequest
            {
                WorkspaceId = project.WorkspaceId,
                Page = 1,
                PageSize = ResourcePageSize
            });

        if (detailsVersion != projectDetailsVersion)
        {
            return;
        }

        if (firstPage is null)
        {
            projectBoards = null;
            projectBoardsLoad.Error =
                "Project boards could not be loaded.";
            return;
        }

        var boards = firstPage.Items.ToList();

        for (var page = 2; page <= firstPage.TotalPages; page++)
        {
            var response = await BoardApiService.GetAsync(
                new BoardQueryRequest
                {
                    WorkspaceId = project.WorkspaceId,
                    Page = page,
                    PageSize = ResourcePageSize
                });

            if (detailsVersion != projectDetailsVersion)
            {
                return;
            }

            if (response is null)
            {
                projectBoards = null;
                projectBoardsLoad.Error =
                    "Workspace boards could not be fully loaded. Partial results are withheld.";
                return;
            }

            boards.AddRange(response.Items);
        }

        if (detailsVersion == projectDetailsVersion)
        {
            projectBoards = boards
                .Where(board =>
                    board.ProjectId == project.ProjectId &&
                    board.WorkspaceId == project.WorkspaceId)
                .OrderBy(board => board.Name)
                .ToList();
        }
    }
    catch (HttpRequestException)
    {
        if (detailsVersion == projectDetailsVersion)
        {
            projectBoards = null;
            projectBoardsLoad.Error =
                "The board service could not be reached.";
        }
    }
    catch (JsonException)
    {
        if (detailsVersion == projectDetailsVersion)
        {
            projectBoards = null;
            projectBoardsLoad.Error =
                "The board service returned an invalid response.";
        }
    }
    finally
    {
        if (detailsVersion == projectDetailsVersion)
        {
            projectBoardsLoad.IsLoading = false;
        }
    }
}


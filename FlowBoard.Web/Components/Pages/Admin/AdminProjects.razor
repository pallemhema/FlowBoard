private async Task DeleteProjectAsync()
{
    if (projectPendingDeletion is null || isSubmitting)
    {
        return;
    }

    var project = projectPendingDeletion;

    deleteProjectOperation.IsSubmitting = true;
    deleteProjectOperation.Error = null;

    try
    {
        var deleted =
            await ProjectApiService.DeleteAsync(project.ProjectId);

        if (!deleted)
        {
            deleteProjectOperation.Error =
                "The project was not deleted. Associated boards or members may block deletion; none were removed.";
            return;
        }

        projectPendingDeletion = null;

        if (selectedProject?.ProjectId == project.ProjectId)
        {
            CloseProjectDetails();
        }

        ToastService.Success(
            $"Project \"{project.Name}\" deleted.");

        var targetPage =
            projectList.Data?.Items.Count == 1 &&
            projectList.CurrentPage > 1
                ? projectList.CurrentPage - 1
                : projectList.CurrentPage;

        await LoadProjectsAsync(targetPage);
    }
    catch (HttpRequestException)
    {
        deleteProjectOperation.Error =
            "The project service could not be reached. The project was not deleted.";
    }
    catch (JsonException)
    {
        deleteProjectOperation.Error =
            "The project service returned an invalid response. Refresh the list to confirm the result.";
    }
    finally
    {
        deleteProjectOperation.IsSubmitting = false;
    }
}

// ---------------------------------------------------------
// Request models and display helpers
// ---------------------------------------------------------

private static CreateProjectRequest NewCreateRequest() => new()
{
    StartDate = DateOnly.FromDateTime(DateTime.Today),
    EndDate = DateOnly.FromDateTime(DateTime.Today).AddDays(30)
};

private static UpdateProjectRequest NewUpdateRequest() => new()
{
    StartDate = DateOnly.FromDateTime(DateTime.Today),
    EndDate = DateOnly.FromDateTime(DateTime.Today).AddDays(30)
};

private static string GetFullName(
    string firstName,
    string lastName)
{
    var fullName = $"{firstName} {lastName}".Trim();

    return string.IsNullOrWhiteSpace(fullName)
        ? "Unnamed account"
        : fullName;
}

private static string GetProjectDate(ProjectResponse project) =>
    (project.ModifiedAt ?? project.CreatedAt)
        .ToLocalTime()
        .ToString("MMM d, yyyy");

private static string GetStatusLabel(ProjectStatus status) =>
    status switch
    {
        ProjectStatus.Active => "Active",
        ProjectStatus.Completed => "Completed",
        ProjectStatus.OnHold => "On hold",
        _ => status.ToString()
    };

private static string GetStatusClass(ProjectStatus status) =>
    status switch
    {
        ProjectStatus.Active => "status-active",
        ProjectStatus.Completed => "status-completed",
        ProjectStatus.OnHold => "status-on-hold",
        _ => "status-unknown"
    };

// ---------------------------------------------------------
// Component disposal
// ---------------------------------------------------------

public void Dispose()
{
    projectSearchDebounce?.Cancel();
    projectSearchDebounce?.Dispose();

    managerSearchDebounce?.Dispose();

    memberCandidateSearchDebounce?.Dispose();

    memberSearchDebounce?.Dispose();
}

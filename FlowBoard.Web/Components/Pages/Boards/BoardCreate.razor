@page "/workspaces/{WorkspaceId:guid}/boards/create"
@attribute [Authorize(Policy = AuthorizationPolicies.AuthenticatedUser)]

@inject IBoardApiService BoardApiService
@inject IWorkspaceApiService WorkspaceApiService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Create Board</PageTitle>

<div class="page-shell">

    <Breadcrumbs>
        <li class="breadcrumb-item">
            <NavLink href="/workspaces">Workspaces</NavLink>
        </li>
        <li class="breadcrumb-item">
            <NavLink href="@($"/workspaces/{WorkspaceId}")">
                Workspace
            </NavLink>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            Create Board
        </li>
    </Breadcrumbs>

    <header class="page-header">
        <div>
            <p class="section-label mb-2">Workspace</p>
            <h1 class="page-title">Create board</h1>
            <p class="page-subtitle">
                Give this board a name and a purpose.
            </p>
        </div>
    </header>

    @if (isLoadingPage)
    {
        <div class="text-center py-5">
            Loading workspace boards...
        </div>
    }
    else if (!canCreateBoards)
    {
        <EmptyState
            Title="Board management unavailable"
            Message="Only active Administrators and Managers with access to this workspace can create boards." />
    }
    else
    {
        <div class="form-surface">
            <BoardForm Model="@model"
                       OnSubmit="@CreateAsync"
                       OnCancel="@Cancel"
                       IsLoading="@isSaving"
                       SubmitText="Create board"
                       LoadingText="Creating..."
                       ErrorMessage="@errorMessage"
                       ShowPurpose="true"
                       Projects="@projects"
                       FormName="create-workspace-board" />
        </div>
    }

</div>

@code {
    [Parameter]
    public Guid WorkspaceId { get; set; }

    private BoardFormModel model = new();

    private List<BoardProjectOptionResponse> projects = [];

    private bool isLoadingPage = true;
    private bool isSaving;
    private bool canCreateBoards;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider
                .GetAuthenticationStateAsync()).User;

            if (!user.IsInRole("Admin") &&
                !user.IsInRole("Manager"))
            {
                return;
            }

            var workspace =
                await WorkspaceApiService.GetByIdAsync(WorkspaceId);

            if (workspace is null)
            {
                return;
            }

            model.WorkspaceId = WorkspaceId;

            var options =
                await BoardApiService.GetWorkspaceProjectsAsync(WorkspaceId);

            if (options is null)
            {
                return;
            }

            projects = options.ToList();

            canCreateBoards = true;
        }
        finally
        {
            isLoadingPage = false;
        }
    }

    private async Task CreateAsync()
    {
        if (model.Purpose == BoardPurpose.Project &&
            !model.ProjectId.HasValue)
        {
            errorMessage = "Select a project in this workspace.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var request = new CreateBoardRequest
            {
                Name = model.Name,
                Description = model.Description,
                WorkspaceId = WorkspaceId,
                ProjectId = model.Purpose == BoardPurpose.Project
                    ? model.ProjectId
                    : null,
                Purpose = model.Purpose
            };

            var board = await BoardApiService.CreateAsync(request);

            if (board is null)
            {
                errorMessage = "Unable to create the board.";
                return;
            }

            Navigation.NavigateTo(
                $"/workspaces/{WorkspaceId}/boards/{board.Id}");
        }
        catch
        {
            errorMessage =
                "Unable to create the board. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/workspaces/{WorkspaceId}");
    }
}
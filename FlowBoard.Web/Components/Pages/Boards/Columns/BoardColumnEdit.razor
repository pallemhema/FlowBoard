@page "/workspaces/{WorkspaceId:guid}/boards/{BoardId:guid}/columns/{ColumnId:guid}/edit"
@attribute [Authorize(Policy = AuthorizationPolicies.AuthenticatedUser)]

@inject IBoardColumnApiService BoardColumnApiService
@inject IBoardApiService BoardApiService
@inject NavigationManager Navigation

<PageTitle>Edit Column</PageTitle>

<div class="page-shell">

    <Breadcrumbs>
        <li class="breadcrumb-item"><NavLink href="/workspaces">Workspaces</NavLink></li>
        <li class="breadcrumb-item"><NavLink href="@($"/workspaces/{WorkspaceId}")">Workspace</NavLink></li>
        <li class="breadcrumb-item"><NavLink href="@($"/workspaces/{WorkspaceId}/boards/{BoardId}")">Board</NavLink></li>
        <li class="breadcrumb-item active" aria-current="page">Edit Column</li>
    </Breadcrumbs>

    <header class="page-header">
        <div>
            <p class="section-label mb-2">Board settings</p>
            <h1 class="page-title">Edit column</h1>
        </div>
    </header>

    @if (isLoading)
    {
        <p>Loading column...</p>
    }
    else if (!canManageBoard)
    {
        <EmptyState
            Title="Board management unavailable"
            Message="Only authorized board managers can update columns. Approval requests are not currently available." />
    }
    else if (model is null)
    {
        <EmptyState
            Title="Unable to load column"
            Message="@(errorMessage ?? "The column could not be found.")" />
    }
    else
    {
        <div class="form-surface">
            <BoardColumnForm
                Model="@model"
                OnSubmit="UpdateAsync"
                OnCancel="Cancel"
                IsSubmitting="@isSubmitting"
                ErrorMessage="@errorMessage"
                SubmitText="Save changes" />
        </div>
    }

</div>

@code {

    [Parameter]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public Guid BoardId { get; set; }

    [Parameter]
    public Guid ColumnId { get; set; }

    private BoardColumnFormModel? model;

    private bool isLoading = true;

    private bool isSubmitting;

    private bool canManageBoard;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var board = await BoardApiService.GetByIdAsync(BoardId);
            if (board is null || board.WorkspaceId != WorkspaceId)
            {
                errorMessage = "The board could not be found in this workspace.";
                return;
            }

            canManageBoard = board.CanManageBoard;
            if (!canManageBoard)
            {
                return;
            }

            var column =
                await BoardColumnApiService.GetAsync(
                    BoardId,
                    ColumnId);

            if (column is not null)
            {
                model = new BoardColumnFormModel
                {
                    Name = column.Name
                };
            }
            else
            {
                errorMessage = "The column could not be found.";
            }
        }
        catch
        {
            errorMessage = "Unable to load the column. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateAsync(
        BoardColumnFormModel form)
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var request = new UpdateBoardColumnRequest
            {
                Name = form.Name
            };

            var success =
                await BoardColumnApiService.UpdateAsync(
                    BoardId,
                    ColumnId,
                    request);

            if (!success)
            {
                errorMessage = "Unable to update the column. Please try again.";
                return;
            }

            Navigation.NavigateTo(
                $"/workspaces/{WorkspaceId}/boards/{BoardId}");
        }
            catch
            {
                errorMessage = "Unable to update the column. Please try again.";
            }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(
            $"/workspaces/{WorkspaceId}/boards/{BoardId}");
    }
}
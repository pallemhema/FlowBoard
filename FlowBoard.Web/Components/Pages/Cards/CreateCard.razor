
@page "/workspaces/{WorkspaceId:guid}/boards/{BoardId:guid}/columns/{ColumnId:guid}/cards/create"
@page "/workspaces/{WorkspaceId:guid}/boards/{BoardId:guid}/columns/{ColumnId:guid}/cards/{CardId:guid}/edit"

@using FlowBoard.Shared.DTOs.BoardMembers
@using FlowBoard.Shared.DTOs.Cards
@using FlowBoard.Shared.DTOs.Common
@using FlowBoard.Shared.Enums

@inject ICardApiService CardApiService
@inject IBoardMemberApiService BoardMemberApiService
@inject NavigationManager Navigation

<PageTitle>@(IsEditing ? "Edit Card" : "Create Card")</PageTitle>

<div class="page-shell">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <header class="mb-4">
        <Breadcrumbs>
            <li class="breadcrumb-item"><NavLink href="/workspaces">Workspaces</NavLink></li>
            <li class="breadcrumb-item"><NavLink href="@($"/workspaces/{WorkspaceId}")">Workspace</NavLink></li>
            <li class="breadcrumb-item"><NavLink href="@($"/workspaces/{WorkspaceId}/boards/{BoardId}")">Board</NavLink></li>
            <li class="breadcrumb-item"><NavLink href="@($"/workspaces/{WorkspaceId}/boards/{BoardId}/columns/{ColumnId}")">Column</NavLink></li>
            @if (IsEditing)
            {
                <li class="breadcrumb-item"><NavLink href="@($"/workspaces/{WorkspaceId}/boards/{BoardId}/columns/{ColumnId}/cards/{CardId}")">Card</NavLink></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            }
            else
            {
                <li class="breadcrumb-item active" aria-current="page">Create Card</li>
            }
        </Breadcrumbs>

        <p class="section-label mt-4 mb-2">Column</p>
        <h1 class="page-title">
            @(IsEditing ? "Edit Card" : "Create Card")
        </h1>

        <p class="page-subtitle">
            @(IsEditing ? "Update this card." : "Create a new card in this column.")
        </p>

    </header>


    <!-- ============================================================
         CREATE CARD FORM
         ============================================================ -->

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2 text-muted py-4" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading card...
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        else
        {
        <div class="form-surface">

            <EditForm Model="@request"
                      OnValidSubmit="@SaveCardAsync">
                      <DataAnnotationsValidator />

                <ValidationSummary />


                <!-- ====================================================
                     TITLE
                     ==================================================== -->

                <div class="mb-3">

                    <label class="form-label">
                        Title
                    </label>

                    <InputText class="form-control"
                               @bind-Value="request.Title" />
                    <ValidationMessage For="@(() => request.Title)" />

                </div>


                <!-- ====================================================
                     DESCRIPTION
                     ==================================================== -->

                <div class="mb-3">

                    <label class="form-label">
                        Description
                    </label>

                    <InputTextArea class="form-control"
                                   rows="4"
                                   @bind-Value="request.Description" />

                    <ValidationMessage For="@(() => request.Description)" />

                </div>


                <!-- ====================================================
                     PRIORITY
                     ==================================================== -->

                <div class="mb-3">

                    <label class="form-label">
                        Priority
                    </label>

                    <InputSelect class="form-select"
                                 @bind-Value="request.Priority">

                        @foreach (var priority in Enum.GetValues<CardPriority>())
                        {
                            <option value="@priority">
                                @priority
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => request.Priority)" />

                </div>


                <!-- ====================================================
                     ASSIGNED USER
                     ==================================================== -->

                <div class="mb-3">

                    <label class="form-label">
                        Assigned To
                    </label>

                    @if (isLoadingMembers)
                    {
                        <div class="text-muted">
                            Loading members...
                        </div>
                    }
                    else
                    {
                        <InputSelect class="form-select"
                                     @bind-Value="request.AssignedUserId">

                            <option value="">
                                Unassigned
                            </option>

                            @foreach (var member in members)
                            {
                                <option value="@member.UserId">
                                    @($"{member.FirstName} {member.LastName}")
                                </option>
                            }

                        </InputSelect>
                    }

                    <ValidationMessage For="@(() => request.AssignedUserId)" />

                </div>


                <!-- ====================================================
                     DUE DATE
                     ==================================================== -->

                <div class="mb-3">

                    <label class="form-label">
                        Due Date
                    </label>

                    <InputDate class="form-control"
                               @bind-Value="request.DueDate" />

                    <ValidationMessage For="@(() => request.DueDate)" />

                </div>


                <!-- ====================================================
                     ACTIONS
                     ==================================================== -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2">
                            </span>

                            <span>
                                @(IsEditing ? "Saving..." : "Creating...")
                            </span>
                        }
                        else
                        {
                            <span>@(IsEditing ? "Save Changes" : "Create Card")</span>
                        }

                    </button>


                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@isSaving"
                            @onclick="BackToContext">

                        Cancel

                    </button>

                </div>

            </EditForm>

        </div>
        }
    }

</div>


@code {

    // ============================================================
    // ROUTE PARAMETERS
    // ============================================================

    [Parameter]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public Guid BoardId { get; set; }

    [Parameter]
    public Guid ColumnId { get; set; }

    [Parameter]
    public Guid? CardId { get; set; }


    // ============================================================
    // MEMBERS
    // ============================================================

    private List<BoardMemberResponse> members = [];

    private bool isLoadingMembers;


    // ============================================================
    // FORM STATE
    // ============================================================

    private CreateCardRequest request = new()
    {
        Priority = CardPriority.Medium,
        Position = 0
    };


    private bool isSaving;

    private bool isLoading;

    private string? errorMessage;

    private bool IsEditing => CardId.HasValue;


    // ============================================================
    // INITIALIZATION
    // ============================================================

    protected override async Task OnParametersSetAsync()
    {
        request = new CreateCardRequest
        {
            Priority = CardPriority.Medium,
            Position = 0
        };
        errorMessage = null;

        await LoadMembersAsync();

        if (IsEditing)
        {
            await LoadCardAsync();
        }
    }


    // ============================================================
    // LOAD BOARD MEMBERS
    // ============================================================

    private async Task LoadMembersAsync()
    {
        isLoadingMembers = true;

        try
        {
            var searchRequest = new PagedSearchRequest
            {
                Page = 1,
                PageSize = 100
            };

            var result =
                await BoardMemberApiService.GetAsync(
                    BoardId,
                    searchRequest);

            members =
                result?.Items?.ToList()
                ?? [];
        }
        finally
        {
            isLoadingMembers = false;
        }
    }


    // ============================================================
    // CREATE CARD
    // ============================================================

    private async Task LoadCardAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var card = await CardApiService.GetByIdAsync(CardId!.Value);
            if (card is null || card.BoardColumnId != ColumnId)
            {
                errorMessage = "The card could not be found in this column.";
                return;
            }

            request = new CreateCardRequest
            {
                Title = card.Title,
                Description = card.Description,
                Priority = card.Priority,
                DueDate = card.DueDate,
                AssignedUserId = card.AssignedUserId,
                Position = card.Position
            };
        }
        catch
        {
            errorMessage = "Unable to load this card. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveCardAsync()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            if (IsEditing)
            {
                var updated = await CardApiService.UpdateAsync(
                    CardId!.Value,
                    new UpdateCardRequest
                    {
                        Title = request.Title,
                        Description = request.Description,
                        Priority = request.Priority,
                        DueDate = request.DueDate,
                        AssignedUserId = request.AssignedUserId
                    });

                if (!updated)
                {
                    errorMessage = "Unable to update the card. Please try again.";
                    return;
                }
            }
            else
            {
                var card = await CardApiService.CreateAsync(ColumnId, request);
                if (card is null)
                {
                    errorMessage = "Unable to create the card. Please try again.";
                    return;
                }
            }

            BackToContext();
        }
        catch
        {
            errorMessage = IsEditing
                ? "Unable to update the card. Please try again."
                : "Unable to create the card. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }


    // ============================================================
    // NAVIGATION
    // ============================================================

    private void BackToContext()
    {
        if (IsEditing)
        {
            Navigation.NavigateTo(
                $"/workspaces/{WorkspaceId}" +
                $"/boards/{BoardId}" +
                $"/columns/{ColumnId}" +
                $"/cards/{CardId}");

            return;
        }

        Navigation.NavigateTo(
            $"/workspaces/{WorkspaceId}" +
            $"/boards/{BoardId}" +
            $"/columns/{ColumnId}");
    }
}

@using FlowBoard.Shared.DTOs.Cards

<article class="entity-card h-100 p-3 p-lg-4 position-relative">

    <div class="d-flex justify-content-between align-items-start gap-2">

            <div>

                <button class="card-title-link h6 fw-semibold mb-2"
                        type="button"
                        @onclick="Open">
                    @Card.Title
                </button>

                @if (!string.IsNullOrWhiteSpace(Card.Description))
                {
                    <p class="entity-card-description small mb-2">
                        @Card.Description
                    </p>
                }

            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary">@Card.Priority</span>
                @if (!confirmingDelete)
                {
                    <button class="btn btn-sm btn-light border-0"
                            type="button"
                            aria-label="Card actions"
                            aria-expanded="@actionsOpen"
                            @onclick="ToggleActions">
                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                    </button>
                }
            </div>

    </div>

    @if (actionsOpen && !confirmingDelete)
    {
        <div class="entity-action-menu">
            <button type="button" class="dropdown-item" @onclick="Edit">
                <i class="bi bi-pencil me-2" aria-hidden="true"></i>Edit card
            </button>
            <button type="button" class="dropdown-item text-danger" @onclick="RequestDelete">
                <i class="bi bi-trash me-2" aria-hidden="true"></i>Delete card
            </button>
        </div>
    }

    <div class="small text-muted mt-3">
        @if (Card.AssignedUserId.HasValue)
        {
            <span><i class="bi bi-person me-1" aria-hidden="true"></i>@Card.AssignedUserName</span>
        }
        else
        {
            <span><i class="bi bi-person me-1" aria-hidden="true"></i>Unassigned</span>
        }

        @if (Card.DueDate.HasValue)
        {
            <span class="ms-3"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@Card.DueDate.Value.ToString("dd MMM yyyy")</span>
        }
    </div>

    @if (confirmingDelete)
    {
        <div class="mt-3 pt-3 border-top" role="group" aria-label="Confirm card deletion">
            <p class="small mb-2">Delete this card?</p>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-danger" type="button" @onclick="ConfirmDelete">Delete</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelDelete">Cancel</button>
            </div>
        </div>
    }
</article>


@code {

    // ============================================================
    // PARAMETERS
    // ============================================================

    [Parameter, EditorRequired]
    public CardResponse Card { get; set; } = null!;

    [Parameter]
    public EventCallback<CardResponse> OnOpen { get; set; }

    [Parameter]
    public EventCallback<CardResponse> OnEdit { get; set; }

    [Parameter]
    public EventCallback<CardResponse> OnDelete { get; set; }

    private bool confirmingDelete;
    private bool actionsOpen;


    // ============================================================
    // OPEN
    // ============================================================

    private async Task Open()
    {
        actionsOpen = false;
        await OnOpen.InvokeAsync(Card);
    }


    // ============================================================
    // EDIT
    // ============================================================

    private async Task Edit()
    {
        actionsOpen = false;
        await OnEdit.InvokeAsync(Card);
    }


    // ============================================================
    // DELETE
    // ============================================================

    private void RequestDelete()
    {
        confirmingDelete = true;
        actionsOpen = false;
    }

    private void ToggleActions()
    {
        actionsOpen = !actionsOpen;
    }

    private void CancelDelete()
    {
        confirmingDelete = false;
    }

    private async Task ConfirmDelete()
    {
        await OnDelete.InvokeAsync(Card);
        confirmingDelete = false;
    }
}

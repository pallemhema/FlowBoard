@page "/workspaces/{WorkspaceId:guid}/boards/{BoardId:guid}/columns/{ColumnId:guid}/cards/{CardId:guid}"

@using FlowBoard.Shared.DTOs.CardComments

@inject ICardApiService CardApiService
@inject ICardCommentApiService CardCommentApiService
@inject NavigationManager Navigation

<PageTitle>
    @(card is null ? "Card" : card.Title)
</PageTitle>

<div class="page-shell">

    <Breadcrumbs>
        <li class="breadcrumb-item">
            <NavLink href="/workspaces">Workspaces</NavLink>
        </li>
        <li class="breadcrumb-item">
            <NavLink href="@($"/workspaces/{WorkspaceId}")">Workspace</NavLink>
        </li>
        <li class="breadcrumb-item">
            <NavLink href="@($"/workspaces/{WorkspaceId}/boards/{BoardId}")">Board</NavLink>
        </li>
        <li class="breadcrumb-item">
            <NavLink href="@($"/workspaces/{WorkspaceId}/boards/{BoardId}/columns/{ColumnId}")">Column</NavLink>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            @(card?.Title ?? "Card")
        </li>
    </Breadcrumbs>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    Loading...
                </span>
            </div>

            <p class="text-muted mt-3 mb-0">
                Loading card...
            </p>
        </div>
    }
    else if (card is null)
    {
        <EmptyState
            Title="@(cardError is null ? "Card not found" : "Unable to load card")"
            Message="@(cardError ?? "The card you're looking for could not be found.")" />

    }
    else
    {
        <!-- CARD HEADER -->

        <header class="page-header">

            <div>
                <p class="section-label mb-2">Card</p>
                <h1 class="page-title">
                    @card.Title
                </h1>

                @if (!string.IsNullOrWhiteSpace(card.Description))
                {
                    <p class="page-subtitle">
                        @card.Description
                    </p>
                }

            </div>

            @if (!isConfirmingCardDelete)
            {
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary"
                            @onclick="EditCard">
                        <i class="bi bi-pencil me-2" aria-hidden="true"></i>Edit
                    </button>
                    <button class="btn btn-outline-danger"
                            @onclick="RequestCardDelete">
                        <i class="bi bi-trash me-2" aria-hidden="true"></i>Delete
                    </button>
                </div>
            }

        </header>

        @if (!string.IsNullOrWhiteSpace(cardError))
        {
            <div class="alert alert-danger" role="alert">@cardError</div>
        }

        @if (isConfirmingCardDelete)
        {
            <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="group" aria-label="Confirm card deletion">
                <span>Delete this card?</span>
                <button class="btn btn-danger btn-sm" type="button" @onclick="DeleteCard" disabled="@isDeletingCard">
                    @(isDeletingCard ? "Deleting..." : "Delete card")
                </button>
                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CancelCardDelete" disabled="@isDeletingCard">
                    Cancel
                </button>
            </div>
        }


        <!-- CARD INFORMATION -->

        <section class="detail-panel mb-5" aria-label="Card information">
            <div class="row g-2">
                <div class="col-sm-4">
                    <div class="detail-metric">
                        <span class="detail-metric-label">Priority</span>
                        <span class="badge bg-secondary">@card.Priority</span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="detail-metric">
                        <span class="detail-metric-label">Assigned to</span>
                        <span>@(card.AssignedUserName ?? "Unassigned")</span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="detail-metric">
                        <span class="detail-metric-label">Due date</span>
                        <span>@(card.DueDate?.ToString("dd MMM yyyy") ?? "No due date")</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- COMMENTS -->

        <section class="comment-thread" aria-labelledby="comments-heading">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 id="comments-heading" class="section-heading mb-0">
                        Comments
                    </h2>
                    @if (comments.Count > 0)
                    {
                        <span class="text-muted small">@comments.Count</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(commentError))
                {
                    <div class="alert alert-danger" role="alert">
                        @commentError
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(commentNotice))
                {
                    <div class="alert alert-success" role="status">
                        @commentNotice
                    </div>
                }

                @if (isLoadingComments)
                {
                    <div class="d-flex align-items-center gap-2 text-muted py-3" role="status">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        Loading comments...
                    </div>
                }
                else if (comments.Count == 0 && string.IsNullOrWhiteSpace(commentError))
                {
                    <p class="text-muted py-2 mb-3">No comments on this card yet.</p>
                }
                else
                {
                    <div class="mb-4">
                        @foreach (var comment in comments)
                        {
                            <article class="comment-item">
                                @if (editingCommentId == comment.Id)
                                {
                                    <EditForm Model="editComment" OnValidSubmit="SaveCommentAsync">
                                        <DataAnnotationsValidator />
                                        <label class="form-label" for="edit-comment">Edit comment</label>
                                        <InputTextArea id="edit-comment"
                                                       class="form-control"
                                                       rows="3"
                                                       maxlength="2000"
                                                       @bind-Value="editComment.Content" />
                                        <ValidationMessage For="() => editComment.Content" />
                                        <div class="d-flex gap-2 mt-2">
                                            <button class="btn btn-primary btn-sm" type="submit" disabled="@isSavingComment">
                                                @(isSavingComment ? "Saving..." : "Save")
                                            </button>
                                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CancelEditComment" disabled="@isSavingComment">
                                                Cancel
                                            </button>
                                        </div>
                                    </EditForm>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div class="d-flex align-items-start gap-3 min-w-0">
                                            <span class="comment-avatar" aria-hidden="true">
                                                @(string.IsNullOrWhiteSpace(comment.UserName) ? "?" : comment.UserName[..1].ToUpperInvariant())
                                            </span>
                                            <div class="min-w-0">
                                            <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                                                <strong>@comment.UserName</strong>
                                                <time class="text-muted small" datetime="@comment.CreatedAt.ToString("O")">
                                                    @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                                </time>
                                                @if (comment.ModifiedAt.HasValue)
                                                {
                                                    <span class="text-muted small">Edited</span>
                                                }
                                            </div>
                                            <p class="mb-0 comment-content">@comment.Content</p>
                                            </div>
                                        </div>
                                        @if (commentToDeleteId != comment.Id)
                                        {
                                        <div class="d-flex flex-shrink-0 gap-2">
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    type="button"
                                                    aria-label="Edit comment by @comment.UserName"
                                                    @onclick="() => BeginEditComment(comment)">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                                <span class="visually-hidden">Edit</span>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    type="button"
                                                    aria-label="Delete comment by @comment.UserName"
                                                    @onclick="() => RequestDeleteComment(comment.Id)">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                                <span class="visually-hidden">Delete</span>
                                            </button>
                                        </div>
                                        }
                                    </div>

                                    @if (commentToDeleteId == comment.Id)
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3" role="group" aria-label="Confirm comment deletion">
                                            <span class="small">Delete this comment?</span>
                                            <button class="btn btn-danger btn-sm" type="button" @onclick="() => DeleteCommentAsync(comment.Id)" disabled="@isSavingComment">
                                                Delete
                                            </button>
                                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CancelDeleteComment" disabled="@isSavingComment">
                                                Cancel
                                            </button>
                                        </div>
                                    }
                                }
                            </article>
                        }
                    </div>
                }

                <div class="comment-composer">
                <EditForm Model="newComment" OnValidSubmit="AddCommentAsync">
                    <DataAnnotationsValidator />
                    <label class="form-label" for="new-comment">Add a comment</label>
                    <InputTextArea id="new-comment"
                                   class="form-control"
                                   rows="3"
                                   maxlength="2000"
                                   placeholder="Share an update..."
                                   @bind-Value="newComment.Content" />
                    <ValidationMessage For="() => newComment.Content" />
                    <div class="d-flex justify-content-end mt-2">
                        <button class="btn btn-primary" type="submit" disabled="@isSavingComment">
                            @(isSavingComment ? "Posting..." : "Post comment")
                        </button>
                    </div>
                </EditForm>
                </div>
        </section>
    }

</div>


@code {

    // ============================================================
    // ROUTE PARAMETERS
    // ============================================================

    [Parameter]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public Guid BoardId { get; set; }

    [Parameter]
    public Guid ColumnId { get; set; }

    [Parameter]
    public Guid CardId { get; set; }


    // ============================================================
    // STATE
    // ============================================================

    private CardResponse? card;

    private List<CardCommentResponse> comments = [];

    private CreateCardCommentRequest newComment = new();

    private UpdateCardCommentRequest editComment = new();

    private Guid? editingCommentId;

    private Guid? commentToDeleteId;

    private bool isLoading;

    private bool isLoadingComments;

    private bool isSavingComment;

    private string? commentError;

    private string? commentNotice;

    private string? cardError;

    private bool isConfirmingCardDelete;

    private bool isDeletingCard;


    // ============================================================
    // INITIALIZATION
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }


    // ============================================================
    // LOAD CARD
    // ============================================================

    private async Task LoadAsync()
    {
        isLoading = true;

        try
        {
            card =
                await CardApiService.GetByIdAsync(
                    CardId);

            if (card is null)
            {
                return;
            }

            // Make sure the card belongs
            // to the column in the URL.

            if (card.BoardColumnId != ColumnId)
            {
                card = null;
                return;
            }

            await LoadCommentsAsync();
        }
        catch
        {
            card = null;
            cardError = "Unable to load this card. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCommentsAsync()
    {
        isLoadingComments = true;
        commentError = null;

        try
        {
            var result = await CardCommentApiService.GetByCardAsync(CardId);
            if (result is null)
            {
                comments = [];
                commentError = "Comments could not be loaded. Please try again.";
                return;
            }

            comments = result.OrderByDescending(comment => comment.CreatedAt).ToList();
        }
        catch
        {
            commentError = "Comments could not be loaded. Please try again.";
        }
        finally
        {
            isLoadingComments = false;
        }
    }

    private async Task AddCommentAsync()
    {
        isSavingComment = true;
        commentError = null;
        commentNotice = null;

        try
        {
            var created = await CardCommentApiService.AddAsync(CardId, newComment);
            if (created is null)
            {
                commentError = "Your comment could not be posted. Please try again.";
                return;
            }

            comments.Insert(0, created);
            newComment = new();
            commentNotice = "Comment posted.";
        }
        catch
        {
            commentError = "Your comment could not be posted. Please try again.";
        }
        finally
        {
            isSavingComment = false;
        }
    }

    private void BeginEditComment(CardCommentResponse comment)
    {
        editingCommentId = comment.Id;
        editComment = new UpdateCardCommentRequest { Content = comment.Content };
        commentError = null;
        commentNotice = null;
    }

    private void CancelEditComment()
    {
        editingCommentId = null;
        editComment = new();
    }

    private async Task SaveCommentAsync()
    {
        if (!editingCommentId.HasValue)
        {
            return;
        }

        isSavingComment = true;
        commentError = null;
        commentNotice = null;

        try
        {
            var updated = await CardCommentApiService.UpdateAsync(editingCommentId.Value, editComment);
            if (!updated)
            {
                commentError = "Your comment could not be updated. Please try again.";
                return;
            }

            var comment = comments.FirstOrDefault(item => item.Id == editingCommentId.Value);
            if (comment is not null)
            {
                comment.Content = editComment.Content;
                comment.ModifiedAt = DateTime.UtcNow;
            }

            CancelEditComment();
            commentNotice = "Comment updated.";
        }
        catch
        {
            commentError = "Your comment could not be updated. Please try again.";
        }
        finally
        {
            isSavingComment = false;
        }
    }

    private void RequestDeleteComment(Guid commentId)
    {
        commentToDeleteId = commentId;
        commentError = null;
        commentNotice = null;
    }

    private void CancelDeleteComment()
    {
        commentToDeleteId = null;
    }

    private async Task DeleteCommentAsync(Guid commentId)
    {
        isSavingComment = true;
        commentError = null;
        commentNotice = null;

        try
        {
            var deleted = await CardCommentApiService.DeleteAsync(commentId);
            if (!deleted)
            {
                commentError = "The comment could not be deleted. Please try again.";
                return;
            }

            comments.RemoveAll(comment => comment.Id == commentId);
            commentToDeleteId = null;
            commentNotice = "Comment deleted.";
        }
        catch
        {
            commentError = "The comment could not be deleted. Please try again.";
        }
        finally
        {
            isSavingComment = false;
        }
    }


    // ============================================================
    // NAVIGATION
    // ============================================================

    private void BackToColumn()
    {
        Navigation.NavigateTo(
            $"/workspaces/{WorkspaceId}" +
            $"/boards/{BoardId}" +
            $"/columns/{ColumnId}");
    }


    // ============================================================
    // CARD ACTIONS
    // ============================================================

    private void EditCard()
    {
        Navigation.NavigateTo(
            $"/workspaces/{WorkspaceId}" +
            $"/boards/{BoardId}" +
            $"/columns/{ColumnId}" +
            $"/cards/{CardId}/edit");
    }


    private void RequestCardDelete()
    {
        isConfirmingCardDelete = true;
        cardError = null;
    }

    private void CancelCardDelete()
    {
        isConfirmingCardDelete = false;
    }

    private async Task DeleteCard()
    {
        isDeletingCard = true;
        cardError = null;

        try
        {
            var deleted = await CardApiService.DeleteAsync(CardId);
            if (!deleted)
            {
                cardError = "Unable to delete the card. Please try again.";
                return;
            }

            BackToColumn();
        }
        catch
        {
            cardError = "Unable to delete the card. Please try again.";
        }
        finally
        {
            isDeletingCard = false;
        }
    }

}